		lastScoreDigitChars = [];
		lastScoreDigitSymbolHeights = [];
		scoreDigitMaxFrameWidth = 0;
		scoreDigitMaxFrameHeight = 0;
		vpScoreDigitAnimationsReady = false;
		scoreDigitsLayoutReferenceWidth = 0;
		scoreDigitsLayoutReferenceHeight = 0;
		lastScoreRankBadgeAnim = null;
		lastScoreRankBadgeHeight = -1;
		lastScoreRankBadgePanelX = Math.NaN;
		lastScoreRankBadgePanelY = Math.NaN;
		lastScoreRankBadgePanelW = Math.NaN;
		lastScoreRankBadgePanelH = Math.NaN;
		lastScoreRankTallySick = 0;
		lastScoreRankTallyGood = 0;
		lastScoreRankTallyBad = 0;
		lastScoreRankTallyShit = 0;
		lastScoreRankTallyMissed = 0;
		hasScoreRankSnapshot = false;
		scoreRankUpdateAccumulator = 0;
		scoreRankVisualDirty = true;
		lastSongLabelVisibleWidth = 0;
		songHudLabelScrollOffset = 0;
		songHudLabelScrollDirection = 1;
		songHudLabelScrollDelay = 0;
