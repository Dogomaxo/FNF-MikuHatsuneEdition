	function removeAndDestroy(stateRef, spr) {
		if (spr == null) return;
		if (stateRef != null) stateRef.remove(spr, true);
		if (spr.destroy != null) spr.destroy();
	}
	function requestStateRefresh(stateRef) {
		if (stateRef != null) pendingStateRefresh = true;
	}

	function flushStateRefresh(stateRef) {
		if (!pendingStateRefresh || stateRef == null) return;
		pendingStateRefresh = false;
		stateRef.refresh();
	}
