		lastHudLayoutUiScale = Math.NaN;
		lastHudLayoutChanceActive = null;
		lastHudLayoutScreenW = -1;
		lastHudLayoutScreenH = -1;
		lastHudLayoutMeterW = -1;
		lastHudLayoutMeterH = -1;
		lastHudLayoutBorderThickness = -1;
		lastHudLayoutIconWidth = Math.NaN;
		lastHudLayoutIconHeight = Math.NaN;
		lastTopHudLayoutUiScale = Math.NaN;
		lastTopHudLayoutDownscroll = null;
		lastTopHudLayoutChanceActive = null;
		lastTopHudLayoutScreenW = -1;
		lastTopHudLayoutScreenH = -1;
		lastTopHudLayoutNormalTopOffsetY = Math.NaN;
		lastTopHudLayoutChanceTopOffsetY = Math.NaN;
		lastNormalSubtitleOffsetX = Math.NaN;
		lastNormalSubtitleOffsetY = Math.NaN;
		lastChanceSubtitleOffsetX = Math.NaN;
