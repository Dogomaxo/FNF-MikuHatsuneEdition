	public function new() {
		super("Hatsune Display HUD", 1);
		this.active = false;
	}

	public function restoreDisplayState() {
		restoreVanilla();
	}

	public function primeDisplayState() {
		hudPaused = false;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		hudDecorUpdateAccumulator = hudDecorUpdateInterval;
		precacheChanceTimeAssets();
		ensureHudReady();
	}

	override function onStateCreate(event) {
		super.onStateCreate(event);
		if (!this.active) return;
		if (PlayState.instance == null) return;
		primeDisplayState();
	}

	override function onUpdate(event) {
		super.onUpdate(event);
		if (hudPaused) return;

		var ps = PlayState.instance;
		if (ps == null) return;

		if (trackedState != null && trackedState != ps) {
			cleanupSprites(trackedState);
			clearTracking();
		}

		ensureBuilt(ps);
		if (!hudBuilt) return;

		enforceIconState(ps);
		updateChanceHudTransition();
		if (!decorFramesReady) refreshDecorFrames(false);
		var chanceActive = isChanceHudActive();
		var chanceHudTweening = isChanceHudTweening();
		hudDecorUpdateAccumulator += event.elapsed;
		var shouldUpdateHudDecor = chanceHudTweening || hudDecorUpdateAccumulator >= hudDecorUpdateInterval;
		if (shouldUpdateHudDecor) hudDecorUpdateAccumulator = 0.0;
		layoutHud(ps, shouldUpdateHudDecor);
		syncVanillaScoreText(ps.scoreText);
		if (shouldUpdateHudDecor) {
			applyScoreLayout(ps.scoreText, false);
			layoutScoreHud(ps.scoreText);
		}
		var uiScale = HatsuneHudLayout.getUiScale();
		hudInfoUpdateAccumulator += event.elapsed;
		var shouldUpdateScoreInfo = chanceHudTweening
			|| hudInfoUpdateAccumulator >= hudInfoUpdateInterval
			|| chanceActive != lastChanceTimeActive
			|| ps.songScore != lastScoreDigitsSourceValue
			|| scoreDigitsVisualDirty;
		if (shouldUpdateScoreInfo) {
			hudInfoUpdateAccumulator = 0.0;
			updateScoreDigits(ps, uiScale);
		}
		hudMetaUpdateAccumulator += event.elapsed;
		var shouldRunTimedHudMeta = !chanceActive && hudMetaUpdateAccumulator >= hudMetaUpdateInterval;
		var shouldUpdateHudMeta = chanceHudTweening
			|| shouldRunTimedHudMeta
			|| chanceActive != lastChanceTimeActive
			|| scoreRankVisualDirty;
		if (shouldUpdateHudMeta) {
			hudMetaUpdateAccumulator = 0.0;
			updateScoreRankBadge(ps, uiScale);
			updateSongHudLabel(ps, HatsuneHudLayout.isDownscroll(), uiScale);
		}
		updateDangerFade();
		if (shouldUpdateHudDecor) updateChanceStarMeter(uiScale);
		if (shouldUpdateHudDecor) updateChanceHudVisibility(ps);
		updateSubtitleBop(event.elapsed);
		subtitleLayoutUpdateAccumulator += event.elapsed;
		var quantizedNormalSubtitleBopScale = quantizeSubtitleScale(normalSubtitleBopScale);
		var quantizedChanceSubtitleBopScale = quantizeSubtitleScale(chanceSubtitleBopScale);
		var shouldUpdateSubtitleLayout = chanceHudTweening
			|| subtitleLayoutUpdateAccumulator >= subtitleLayoutUpdateInterval
			|| quantizedNormalSubtitleBopScale != lastQuantizedNormalSubtitleBopScale
			|| quantizedChanceSubtitleBopScale != lastQuantizedChanceSubtitleBopScale
			|| chanceActive != lastChanceTimeActive;
		if (shouldUpdateSubtitleLayout) {
			subtitleLayoutUpdateAccumulator = 0.0;
			lastQuantizedNormalSubtitleBopScale = quantizedNormalSubtitleBopScale;
			lastQuantizedChanceSubtitleBopScale = quantizedChanceSubtitleBopScale;
			updateSubtitleLayout(ps, quantizedNormalSubtitleBopScale, quantizedChanceSubtitleBopScale);
		}
		flushStateRefresh(ps);
	}

	override function onBeatHit(event) {
		super.onBeatHit(event);
		if (hudPaused || !this.active || !hudBuilt || PlayState.instance == null) return;
		triggerPlayerIconBop(PlayState.instance);

		refreshBarColors(false);
		var chanceHudActive = isChanceHudActive();
		var isDanger = (PlayState.instance.health <= 0.4);

		if (!Preferences.flashingLights || chanceHudActive) {
			if (barTween != null) {
				barTween.cancel();
				barTween = null;
			}
			if (backTween != null) {
				backTween.cancel();
				backTween = null;
			}
			dangerFadeCountdown = 0;
			if (meter != null) meter.color = baseBarColor;
			if (meterBack != null) meterBack.color = isDanger ? meterDangerBack : meterEmptyBack;

			var subtitleBopScale = HatsuneHudLayout.SUBTITLE_BOP_SCALE;
			if (subtitleBopScale > 1.0 && shouldTriggerSubtitleBop(event)) {
				normalSubtitleBopScale = subtitleBopScale;
				chanceSubtitleBopScale = subtitleBopScale;
			}
			return;
		}

		var crochetMs = (Conductor.instance != null ? Conductor.instance.beatLengthMs : 500);
		var crochetSec = crochetMs / 1000.0;

		if (backTween != null) {
			backTween.cancel();
			backTween = null;
		}

		if (isDanger) {
			if (meterBack != null) meterBack.color = meterDangerBack;
			dangerFadeCountdown = crochetSec * 0.25;
			dangerFadeDuration = crochetSec * 0.5;
		} else {
			dangerFadeCountdown = 0;
			if (meterBack != null) meterBack.color = meterEmptyBack;
		}

		if (barTween != null) barTween.cancel();
		if (meter != null) {
			meter.color = isDanger ? dangerFlashColor : flashColor;
			barTween = FlxTween.color(meter, crochetSec, meter.color, baseBarColor);
		}

		var subtitleBopScale = HatsuneHudLayout.SUBTITLE_BOP_SCALE;
		if (subtitleBopScale > 1.0 && shouldTriggerSubtitleBop(event)) {
			normalSubtitleBopScale = subtitleBopScale;
			chanceSubtitleBopScale = subtitleBopScale;
		}

	}

	override function onPause(event) {
		super.onPause(event);
		hudPaused = true;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		clearChanceHudTweens();
		if (barTween != null) {
			barTween.cancel();
			barTween = null;
		}
		if (backTween != null) {
			backTween.cancel();
			backTween = null;
		}
		stopScoreRankSparkle();
	}

	override function onSongLoaded(event) {
		super.onSongLoaded(event);
		resetHudForSongReload();
	}

	override function onSongRetry(event) {
		super.onSongRetry(event);
		resetHudForSongReload();
	}

	override function onCountdownStart(event) {
		super.onCountdownStart(event);
		ensureHudReady();
	}

	override function onSongStart(event) {
		super.onSongStart(event);
		ensureHudReady();
	}

	function resetHudForSongReload() {
		hudPaused = false;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		MHE_SharedState.drainActive = false;
		MHE_SharedState.resetChanceTimeState();
		precacheChanceTimeAssets();
		restoreVanilla();
		ensureHudReady();
	}

	function ensureHudReady() {
		var ps = PlayState.instance;
		if (!this.active || ps == null) return;
		ensureBuilt(ps);
		if (!hudBuilt) return;

		var uiScale = HatsuneHudLayout.getUiScale();

		if (ps.healthBar != null) ps.healthBar.visible = false;
		if (ps.healthBarBG != null) ps.healthBarBG.visible = false;
		if (ps.iconP2 != null) {
			ps.iconP2.visible = false;
			ps.iconP2.autoUpdate = false;
		}

		enforceIconState(ps);
		refreshDecorFrames(false);
		if (scoreDigits == null || scoreDigits.length <= 0) restoreScoreDigitsState(ps);
		else if (scoreDigitsAtlasFrames == null) reloadScoreDigitsAtlas();
		updateChanceHudTransition(true);
		layoutHud(ps);
		applyScoreLayout(ps.scoreText, true);
		layoutScoreHud(ps.scoreText);
		scoreDigitsVisualDirty = true;
		lastScoreDigitsValue = null;
		updateScoreRankBadge(ps, uiScale);
		updateScoreDigits(ps, uiScale);
		lastAppliedChanceHudVisibility = null;
		updateChanceHudVisibility(ps);
		updateSongHudLabel(ps, HatsuneHudLayout.isDownscroll(), uiScale);
		flushStateRefresh(ps);
	}

	override function onResume(event) {
		super.onResume(event);
		hudPaused = false;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;

		var ps = PlayState.instance;
		if (!this.active || ps == null) return;
		ensureHudReady();
	}

	override function onSongEvent(event) {
		super.onSongEvent(event);
		if (HatsuneHudLayout.CT_HUD_DEBUG_FORCE_VISIBLE) {
			updateChanceHudTransition();
			return;
		}
		if (event == null || event.eventData == null) return;
		if (event.eventData.eventKind != 'ChanceTime') return;
		var action = event.eventData.getString('action');
		if (action == null || action == '') action = 'start';
		action = action.toLowerCase();
		switch (action) {
			case 'stop', 'reset':
				chanceHudEventArmed = false;
			case 'start':
				chanceHudEventArmed = true;
			default:
				chanceHudEventArmed = true;
		}
		updateChanceHudTransition();
		if (PlayState.instance != null) updateChanceHudVisibility(PlayState.instance);
	}

	function reloadHudAtlas():FlxAtlasFrames {
		hudAtlasFrames = Paths.getSparrowAtlas(hudAtlasKey);
		hudAtlasFrameCache = new StringMap();
		if (hudAtlasFrames != null && hudAtlasFrames.frames != null) {
			for (frame in hudAtlasFrames.frames) {
				if (frame != null && frame.name != null) hudAtlasFrameCache.set(frame.name, frame);
			}
		}
		return hudAtlasFrames;
	}

	function reloadDownscrollHudAtlas():FlxAtlasFrames {
		downscrollHudAtlasFrames = Paths.getSparrowAtlas(downscrollHudAtlasKey);
		downscrollHudAtlasFrameCache = new StringMap();
		if (downscrollHudAtlasFrames != null && downscrollHudAtlasFrames.frames != null) {
			for (frame in downscrollHudAtlasFrames.frames) {
				if (frame != null && frame.name != null) downscrollHudAtlasFrameCache.set(frame.name, frame);
			}
		}
		return downscrollHudAtlasFrames;
	}

	function buildScoreDigitsAtlasCache(atlasKey:String, isVpAtlas:Bool):FlxAtlasFrames {
		var atlasFrames = Paths.getSparrowAtlas(atlasKey);
		var frameCache = new StringMap();
		var maxFrameWidth = 0;
		var maxFrameHeight = 0;
		if (atlasFrames != null && atlasFrames.frames != null) {
			for (frame in atlasFrames.frames) {
				if (frame != null && frame.name != null) {
					frameCache.set(frame.name, frame);
					cacheScoreDigitAliasForMap(frameCache, "digital 0", frame, "ZERO DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 1", frame, "ONE DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 2", frame, "TWO DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 3", frame, "THREE DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 4", frame, "FOUR DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 5", frame, "FIVE DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 6", frame, "SIX DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 7", frame, "SEVEN DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 8", frame, "EIGHT DIGITAL");
					cacheScoreDigitAliasForMap(frameCache, "digital 9", frame, "NINE DIGITAL");
					if (isScoreDigitFrameName(frame.name)) {
						var frameWidth = Std.int(frame.frame.width);
						var frameHeight = Std.int(frame.frame.height);
						if (frameWidth > maxFrameWidth) maxFrameWidth = frameWidth;
						if (frameHeight > maxFrameHeight) maxFrameHeight = frameHeight;
					}
				}
			}
		}

		if (isVpAtlas) {
			vpScoreDigitsAtlasFrames = atlasFrames;
			vpScoreDigitFrameCache = frameCache;
			vpScoreDigitMaxFrameWidth = maxFrameWidth;
			vpScoreDigitMaxFrameHeight = maxFrameHeight;
		} else {
			defaultScoreDigitsAtlasFrames = atlasFrames;
			defaultScoreDigitFrameCache = frameCache;
			defaultScoreDigitMaxFrameWidth = maxFrameWidth;
			defaultScoreDigitMaxFrameHeight = maxFrameHeight;
		}
		return atlasFrames;
	}

	function reloadScoreDigitsAtlas():FlxAtlasFrames {
		var useVpAtlas = (scoreDigitsAtlasKey == vpScoreDigitsAtlasKey);
		if (useVpAtlas) {
			if (vpScoreDigitsAtlasFrames == null) buildScoreDigitsAtlasCache(vpScoreDigitsAtlasKey, true);
			scoreDigitsAtlasFrames = vpScoreDigitsAtlasFrames;
			scoreDigitFrameCache = vpScoreDigitFrameCache;
			scoreDigitMaxFrameWidth = vpScoreDigitMaxFrameWidth;
			scoreDigitMaxFrameHeight = vpScoreDigitMaxFrameHeight;
		} else {
			if (defaultScoreDigitsAtlasFrames == null) buildScoreDigitsAtlasCache(defaultScoreDigitsAtlasKey, false);
			scoreDigitsAtlasFrames = defaultScoreDigitsAtlasFrames;
			scoreDigitFrameCache = defaultScoreDigitFrameCache;
			scoreDigitMaxFrameWidth = defaultScoreDigitMaxFrameWidth;
			scoreDigitMaxFrameHeight = defaultScoreDigitMaxFrameHeight;
		}
		ensureScoreDigitsLayoutReference();
		return scoreDigitsAtlasFrames;
	}

	function ensureScoreDigitsLayoutReference() {
		if (scoreDigitsLayoutReferenceWidth > 0 && scoreDigitsLayoutReferenceHeight > 0) return;

		var referenceFrames = Paths.getSparrowAtlas(defaultScoreDigitsAtlasKey);
		if (referenceFrames == null || referenceFrames.frames == null) return;

		for (frame in referenceFrames.frames) {
			if (frame == null || frame.name == null) continue;
			if (frame.name == "MINUS" || (frame.name.length >= 8 && frame.name.substr(0, 8) == "digital ")) {
				var frameWidth = Std.int(frame.frame.width);
				var frameHeight = Std.int(frame.frame.height);
				if (frameWidth > scoreDigitsLayoutReferenceWidth) scoreDigitsLayoutReferenceWidth = frameWidth;
				if (frameHeight > scoreDigitsLayoutReferenceHeight) scoreDigitsLayoutReferenceHeight = frameHeight;
			}
		}
	}

	function cacheScoreDigitAliasForMap(frameCache:StringMap<Dynamic>, alias:String, frame:FlxFrame, prefix:String) {
		if (frameCache == null || alias == null || frame == null || frame.name == null || prefix == null) return;
		if (frame.name.length < prefix.length || frame.name.substr(0, prefix.length) != prefix) return;

		var currentFrame = frameCache.get(alias);
		if (currentFrame == null || frame.name > currentFrame.name) frameCache.set(alias, frame);
	}

	function cacheScoreDigitAlias(alias:String, frame:FlxFrame, prefix:String) {
		if (alias == null || frame == null || frame.name == null || prefix == null) return;
		if (frame.name.length < prefix.length || frame.name.substr(0, prefix.length) != prefix) return;

		var currentFrame = scoreDigitFrameCache.get(alias);
		if (currentFrame == null || frame.name > currentFrame.name) scoreDigitFrameCache.set(alias, frame);
	}

	function getDownscrollDecorFrameName(frameName:String):String {
		if (frameName == null) return null;
		switch (frameName) {
			case HatsuneHudLayout.BOTTOM_HUD_FRAME:
				return HatsuneHudLayout.BOTTOM_HUD_DOWNSCROLL_FRAME;
			case HatsuneHudLayout.HEALTH_HUD_FRAME:
				return HatsuneHudLayout.HEALTH_HUD_DOWNSCROLL_FRAME;
			case HatsuneHudLayout.TOP_HUD_FRAME:
				return HatsuneHudLayout.TOP_HUD_DOWNSCROLL_FRAME;
			case HatsuneHudLayout.CT_BOTTOM_HUD_FRAME:
				return HatsuneHudLayout.CT_BOTTOM_HUD_DOWNSCROLL_FRAME;
			case HatsuneHudLayout.CT_TOP_HUD_FRAME:
				return HatsuneHudLayout.CT_TOP_HUD_DOWNSCROLL_FRAME;
			default:
				return null;
		}
	}

	function findAtlasFrameInCache(frameCache:StringMap<Dynamic>, frameName:String):FlxFrame {
		if (frameCache == null || frameName == null) return null;
		return frameCache.get(frameName);
	}

	function selectHudAtlasFrame(frameName:String, forceReload:Bool) {
		var downscrollFrameName = HatsuneHudLayout.isDownscroll() ? getDownscrollDecorFrameName(frameName) : null;
		if (downscrollFrameName != null) {
			if (forceReload || downscrollHudAtlasFrames == null) reloadDownscrollHudAtlas();
			var downscrollFrame = findAtlasFrameInCache(downscrollHudAtlasFrameCache, downscrollFrameName);
			if (downscrollFrame == null && !forceReload) {
				reloadDownscrollHudAtlas();
				downscrollFrame = findAtlasFrameInCache(downscrollHudAtlasFrameCache, downscrollFrameName);
			}
			if (downscrollFrame != null && downscrollHudAtlasFrames != null) {
				return {
					frames: downscrollHudAtlasFrames,
					frame: downscrollFrame
				};
			}
		}

		if (forceReload || hudAtlasFrames == null) reloadHudAtlas();
		var selectedFrame = findAtlasFrame(frameName);
		if (selectedFrame == null && !forceReload) {
			reloadHudAtlas();
			selectedFrame = findAtlasFrame(frameName);
		}
		if (selectedFrame == null || hudAtlasFrames == null) return null;
		return {
			frames: hudAtlasFrames,
			frame: selectedFrame
		};
	}

	function isScoreDigitFrameName(frameName:String):Bool {
		if (frameName == null) return false;
		if (frameName == "MINUS") return true;
		if (frameName.length >= 8 && frameName.substr(0, 8) == "digital ") return true;
		if (frameName.length >= 12 && frameName.substr(0, 12) == "ZERO DIGITAL") return true;
		if (frameName.length >= 11 && frameName.substr(0, 11) == "ONE DIGITAL") return true;
		if (frameName.length >= 11 && frameName.substr(0, 11) == "TWO DIGITAL") return true;
		if (frameName.length >= 13 && frameName.substr(0, 13) == "THREE DIGITAL") return true;
		if (frameName.length >= 12 && frameName.substr(0, 12) == "FOUR DIGITAL") return true;
		if (frameName.length >= 12 && frameName.substr(0, 12) == "FIVE DIGITAL") return true;
		if (frameName.length >= 11 && frameName.substr(0, 11) == "SIX DIGITAL") return true;
		if (frameName.length >= 13 && frameName.substr(0, 13) == "SEVEN DIGITAL") return true;
		if (frameName.length >= 13 && frameName.substr(0, 13) == "EIGHT DIGITAL") return true;
		if (frameName.length >= 12 && frameName.substr(0, 12) == "NINE DIGITAL") return true;
		return false;
	}

	function createAtlasSprite(frameName:String, zIndex:Int, cam):FlxSprite {
		if (hudAtlasFrames == null) reloadHudAtlas();
		if (hudAtlasFrames == null) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = zIndex;
		spr.origin.set(0, 0);
		if (!applyAtlasFrame(spr, frameName, false)) return null;
		return spr;
	}

	function createScoreDigitSprite(zIndex:Int, cam):FlxSprite {
		if (scoreDigitsAtlasFrames == null) reloadScoreDigitsAtlas();
		if (scoreDigitsAtlasFrames == null) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = zIndex;
		spr.origin.set(0, 0);
		if (!applyScoreDigitFrame(spr, "digital 0", false)) return null;
		return spr;
	}

	function rebuildScoreDigitSprites(ps) {
		var scoreDigitCount = (scoreDigits != null && scoreDigits.length > 0) ? scoreDigits.length : HatsuneHudLayout.SCORE_DIGITS_COUNT;
		if (scoreDigitCount <= 0) scoreDigitCount = 7;
		if (scoreDigits == null) scoreDigits = [];

		var addedSprite = false;
		for (i in 0...scoreDigitCount) {
			var scoreDigit = (scoreDigits.length > i) ? scoreDigits[i] : null;
			if (scoreDigit == null) {
				if (ps == null) continue;
				scoreDigit = createScoreDigitSprite(HatsuneHudLayout.SCORE_DIGITS_Z, ps.camHUD);
				if (scoreDigit == null) continue;
				if (scoreDigits.length > i) scoreDigits[i] = scoreDigit;
				else scoreDigits.push(scoreDigit);
				ps.add(scoreDigit);
				addedSprite = true;
			}

			scoreDigit.frames = scoreDigitsAtlasFrames;
			if (scoreDigit.animation != null) {
				scoreDigit.animation.stop();
			}
			if (isVpScoreDigitsAtlas()) ensureScoreDigitAnimations(scoreDigit);
			scoreDigit.visible = true;
			scoreDigit.updateHitbox();
		}

		lastScoreDigitsValue = null;
		lastScoreDigitsSourceValue = 0;
		lastScoreDigitChars = [];
		lastScoreDigitSymbolHeights = [];
		scoreDigitsVisualDirty = true;
		if (addedSprite) requestStateRefresh(ps);
	}

	function restoreScoreDigitsState(ps) {
		var desiredAtlasKey = MHE_SharedState.drainActive ? vpScoreDigitsAtlasKey : defaultScoreDigitsAtlasKey;
		if (desiredAtlasKey == null || desiredAtlasKey == "") desiredAtlasKey = defaultScoreDigitsAtlasKey;
		scoreDigitsAtlasKey = desiredAtlasKey;
		reloadScoreDigitsAtlas();
		rebuildScoreDigitSprites(ps);
		if (scoreDigits != null) {
			for (digit in scoreDigits) {
				if (digit == null) continue;
				if (digit.animation != null) digit.animation.stop();
				digit.visible = true;
			}
		}
	}

	function createChanceTimeMeterSprite(cam):FlxSprite {
		reloadChanceTimeMeterAtlases();
		if (chanceTimeMeterAtlasFrames == null || chanceTimeMeterAtlasFrames.length <= 0) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = HatsuneHudLayout.CT_STAR_METER_Z;
		spr.origin.set(0, 0);
		if (!applyChanceTimeMeterFrame(spr, "ct charge0001", false)) return null;
		return spr;
	}

	function createChanceTimeMeterStrokeSprite(cam):FlxSprite {
		reloadChanceTimeMeterAtlases();
		if (chanceTimeMeterAtlasFrames == null || chanceTimeMeterAtlasFrames.length <= 0) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = HatsuneHudLayout.CT_STAR_METER_Z + 1;
		spr.origin.set(0, 0);
		if (!applyChanceTimeMeterFrame(spr, "ct stroke", false)) return null;
		return spr;
	}

	function ensureChanceTimeMeterBuilt(ps:PlayState) {
		if (ps == null) return;
		var addedSprite = false;
		if (chanceStarMeter == null) {
			chanceStarMeter = createChanceTimeMeterSprite(ps.camHUD);
			if (chanceStarMeter != null) {
				ps.add(chanceStarMeter);
				addedSprite = true;
			}
		}
		if (chanceStarMeterStroke == null) {
			chanceStarMeterStroke = createChanceTimeMeterStrokeSprite(ps.camHUD);
			if (chanceStarMeterStroke != null) {
				ps.add(chanceStarMeterStroke);
				addedSprite = true;
			}
		}
		if (addedSprite) requestStateRefresh(ps);
	}

	function getActiveScoreHudArt():FlxSprite {
		if (isChanceHudActive() && chanceScoreHudArt != null) return chanceScoreHudArt;
		return scoreHudArt;
	}

	function getActiveSongHudIcon():FlxSprite {
		if (isChanceHudActive() && chanceSongHudIcon != null) return chanceSongHudIcon;
		return songHudIcon;
	}

	function isChanceHudActive():Bool {
		return HatsuneHudLayout.CT_HUD_DEBUG_FORCE_VISIBLE || (chanceHudEventArmed && MHE_SharedState.chanceTimeActive);
	}

	function getActiveScoreHudScale():Float {
		if (isChanceHudActive()) {
			var chanceScale = HatsuneHudLayout.CT_SCORE_HUD_SCALE;
			return (chanceScale > 0) ? chanceScale : 1.0;
		}

		var normalScale = HatsuneHudLayout.TOP_HUD_SCALE;
		return (normalScale > 0) ? normalScale : 1.0;
	}

	function setSpriteVisible(sprite:FlxSprite, visible:Bool) {
		if (sprite != null && sprite.visible != visible) sprite.visible = visible;
	}

	function setTextVisible(text:FlxText, visible:Bool) {
		if (text != null && text.visible != visible) text.visible = visible;
	}

	function setSubtitleDisplayEnabled(subtitles:Subtitles, enabled:Bool, visible:Bool) {
		if (subtitles == null) return;
		if (subtitles.active != enabled) subtitles.active = enabled;
		if (subtitles.visible != visible) subtitles.visible = visible;
	}

	function quantizeSubtitleScale(value:Float):Float {
		return Math.fround(value * 100.0) / 100.0;
	}

	function getSubtitleBackground(subtitles:Subtitles):FlxSprite {
		if (subtitles == null || subtitles.members == null || subtitles.members.length <= 0) return null;
		return subtitles.members[0];
	}

	function getSubtitleText(subtitles:Subtitles):FlxText {
		if (subtitles == null || subtitles.members == null || subtitles.members.length <= 1) return null;
		return subtitles.members[1];
	}

	function buildSubtitleAssetPath(ps:PlayState, fileName:String):String {
		if (ps == null || ps.currentSong == null || ps.currentSong.id == null || ps.currentSong.id == "" || fileName == null || fileName == "") return null;
		return 'songs/${ps.currentSong.id}/subtitles/' + fileName;
	}

	function resolveSubtitleAssetPath(ps:PlayState, secondary:Bool = false):String {
		var candidateNames = secondary
			? ["song-lyrics-secondary", "song-lyrics-es"]
			: ["song-lyrics-primary", "song-lyrics-en", "song-lyrics"];

		for (candidate in candidateNames) {
			var path = buildSubtitleAssetPath(ps, candidate);
			if (path != null && Assets.exists(Paths.srt(path))) return path;
		}

		return null;
	}

	function createSubtitleDisplay(ps:PlayState, zIndex:Int):Subtitles {
		if (ps == null || ps.camSubtitles == null) return null;

		var subtitles = new Subtitles(0, 139, "bottom");
		subtitles.scrollFactor.set();
		subtitles.cameras = [ps.camSubtitles];
		subtitles.zIndex = zIndex;
		subtitles.visible = false;
		ps.add(subtitles);
		return subtitles;
	}

	function ensureChanceSubtitleDisplay(ps:PlayState) {
		if (ps == null || ps.subtitles == null || ps.camSubtitles == null) return;
		if (primarySubtitleDisplay == null) primarySubtitleDisplay = createSubtitleDisplay(ps, HatsuneHudLayout.SUBTITLE_Z);
		if (secondarySubtitleDisplay == null) secondarySubtitleDisplay = createSubtitleDisplay(ps, HatsuneHudLayout.SUBTITLE_Z);
		if (chanceSubtitleDisplay == null) chanceSubtitleDisplay = createSubtitleDisplay(ps, HatsuneHudLayout.SUBTITLE_Z);
		if (chanceSecondarySubtitleDisplay == null) chanceSecondarySubtitleDisplay = createSubtitleDisplay(ps, HatsuneHudLayout.SUBTITLE_Z + 1);
	}

	function syncChanceSubtitleSource(ps:PlayState) {
		if (ps == null || ps.subtitles == null) return;

		var primarySubtitlePath = resolveSubtitleAssetPath(ps, false);
		var secondarySubtitlePath = resolveSubtitleAssetPath(ps, true);
		var music = FlxG.sound.music;
		if (primarySubtitlePath == null || music == null) return;
		if (lastPrimarySubtitleAssetPath == primarySubtitlePath && lastSecondarySubtitleAssetPath == secondarySubtitlePath && lastSubtitleSound == music) return;

		if (primarySubtitleDisplay != null) primarySubtitleDisplay.assignSubtitles(primarySubtitlePath, music);
		if (chanceSubtitleDisplay != null) chanceSubtitleDisplay.assignSubtitles(primarySubtitlePath, music);
		if (secondarySubtitleDisplay != null && secondarySubtitlePath != null) secondarySubtitleDisplay.assignSubtitles(secondarySubtitlePath, music);
		if (chanceSecondarySubtitleDisplay != null && secondarySubtitlePath != null) chanceSecondarySubtitleDisplay.assignSubtitles(secondarySubtitlePath, music);

		lastPrimarySubtitleAssetPath = primarySubtitlePath;
		lastSecondarySubtitleAssetPath = secondarySubtitlePath;
		lastSubtitleSound = music;
	}

	function styleSubtitleDisplay(subtitles:Subtitles, targetSize:Int, targetScale:Float) {
		if (subtitles == null) return;

		var subtitleBackground = getSubtitleBackground(subtitles);
		if (subtitleBackground != null && HatsuneHudLayout.SUBTITLE_HIDE_BACKGROUND) {
			subtitleBackground.visible = false;
			subtitleBackground.alpha = 0;
		}

		var subtitleText = getSubtitleText(subtitles);
		if (subtitleText != null) {
			if (targetSize <= 0) targetSize = 24;
			targetScale = quantizeSubtitleScale(targetScale);
			if (subtitleText.font != "5by7") {
				subtitleText.font = "5by7";
				subtitleText.updateHitbox();
			}
			if (subtitleText.alignment != "left") {
				subtitleText.alignment = "left";
				subtitleText.updateHitbox();
			}
			if (subtitleText.size != targetSize) {
				subtitleText.size = targetSize;
				subtitleText.updateHitbox();
			}
			if (subtitleText.scale.x != targetScale || subtitleText.scale.y != targetScale) {
				subtitleText.scale.set(targetScale, targetScale);
				subtitleText.updateHitbox();
			}
		}
	}

	function getSubtitleDisplayHeight(subtitles:Subtitles):Float {
		if (subtitles == null) return 0;

		var subtitleText = getSubtitleText(subtitles);
		if (subtitleText != null) {
			if (subtitleText.height > 0) return subtitleText.height;
		}

		return subtitles.height;
	}

	function getSubtitleDisplayWidth(subtitles:Subtitles):Float {
		if (subtitles == null) return 0;

		var subtitleText = getSubtitleText(subtitles);
		if (subtitleText != null) {
			if (subtitleText.width > 0) return subtitleText.width;
		}

		return subtitles.width;
	}

	function setSubtitleLeftX(subtitles:Subtitles, targetLeftX:Float) {
		if (subtitles == null) return;
		if (subtitles.x != targetLeftX) subtitles.x = targetLeftX;
	}

	function hideVanillaSubtitles(ps:PlayState) {
		if (ps == null || ps.subtitles == null) return;

		if (ps.subtitles.active) ps.subtitles.active = false;
		if (ps.subtitles.visible) ps.subtitles.visible = false;

		var vanillaBackground = getSubtitleBackground(ps.subtitles);
		if (vanillaBackground != null) {
			vanillaBackground.visible = false;
			vanillaBackground.alpha = 0;
		}

		var vanillaText = getSubtitleText(ps.subtitles);
		if (vanillaText != null && vanillaText.visible) vanillaText.visible = false;
	}

	function shouldTriggerSubtitleBop(event):Bool {
		var beatsPerMeasure = HatsuneHudLayout.SUBTITLE_BOP_BEATS_PER_MEASURE;
		if (beatsPerMeasure <= 0) beatsPerMeasure = 4;

		var beatIndex = -1;
		if (event != null && event.beat != null) {
			beatIndex = event.beat;
		} else if (Conductor.instance != null) {
			beatIndex = Conductor.instance.currentBeat;
		}
		if (beatIndex < 0) return false;

		return beatIndex % beatsPerMeasure == 0;
	}

	function updateSubtitleBop(elapsed:Float) {
		var decay = HatsuneHudLayout.SUBTITLE_BOP_DECAY;
		if (decay <= 0) {
			normalSubtitleBopScale = 1.0;
			chanceSubtitleBopScale = 1.0;
			return;
		}

		var step = Math.min(1.0, elapsed * decay);
		normalSubtitleBopScale += (1.0 - normalSubtitleBopScale) * step;
		chanceSubtitleBopScale += (1.0 - chanceSubtitleBopScale) * step;
		if (Math.abs(normalSubtitleBopScale - 1.0) < 0.001) normalSubtitleBopScale = 1.0;
		if (Math.abs(chanceSubtitleBopScale - 1.0) < 0.001) chanceSubtitleBopScale = 1.0;
	}

	function setSubtitleOffsets(subtitles:Subtitles, offsetX:Float, offsetY:Float, isChanceDisplay:Bool = false) {
		if (subtitles == null) return;

		subtitles.offsets = [offsetX, offsetY];
		if (isChanceDisplay) {
			lastChanceSubtitleOffsetX = offsetX;
			lastChanceSubtitleOffsetY = offsetY;
		} else {
			lastNormalSubtitleOffsetX = offsetX;
			lastNormalSubtitleOffsetY = offsetY;
		}
	}

	function getSubtitleTargetBottomY(anchorTopY:Float, gap:Float, offsetY:Float, fallbackOffsetY:Float):Float {
		if (Math.isNaN(anchorTopY)) return fallbackOffsetY;
		return anchorTopY - gap + offsetY;
	}

	function getSubtitleBottomOffsetForBottomY(targetBottomY:Float):Float {
		return FlxG.height - targetBottomY;
	}

	function mirrorBottomAlignedTarget(targetBottomY:Float, displayHeight:Float):Float {
		return FlxG.height - targetBottomY + displayHeight;
	}

	function getSubtitleTargetBottomYForDownscroll(anchorTopY:Float, anchorHeight:Float, gap:Float, offsetY:Float, displayHeight:Float, fallbackOffsetY:Float):Float {
		if (Math.isNaN(anchorTopY)) return fallbackOffsetY;
		return anchorTopY + anchorHeight + gap + displayHeight + offsetY;
	}

	function updateSubtitleLayout(ps:PlayState, normalBopScale:Float = 1.0, chanceBopScale:Float = 1.0) {
		if (ps == null || ps.subtitles == null) {
			setSubtitleDisplayEnabled(primarySubtitleDisplay, false, false);
			setSubtitleDisplayEnabled(secondarySubtitleDisplay, false, false);
			setSubtitleDisplayEnabled(chanceSubtitleDisplay, false, false);
			setSubtitleDisplayEnabled(chanceSecondarySubtitleDisplay, false, false);
			return;
		}

		ensureChanceSubtitleDisplay(ps);
		syncChanceSubtitleSource(ps);

		var uiScale = HatsuneHudLayout.getUiScale();
		var downscroll = HatsuneHudLayout.isDownscroll();

		styleSubtitleDisplay(primarySubtitleDisplay, HatsuneHudLayout.SUBTITLE_NORMAL_TEXT_SIZE, normalBopScale);
		styleSubtitleDisplay(secondarySubtitleDisplay, HatsuneHudLayout.SUBTITLE_SECONDARY_NORMAL_TEXT_SIZE, normalBopScale);
		styleSubtitleDisplay(chanceSubtitleDisplay, HatsuneHudLayout.SUBTITLE_CT_TEXT_SIZE, chanceBopScale);
		styleSubtitleDisplay(chanceSecondarySubtitleDisplay, HatsuneHudLayout.SUBTITLE_SECONDARY_CT_TEXT_SIZE, chanceBopScale);
		hideVanillaSubtitles(ps);

		var normalBaseLeftX = downscroll
			? ((playerHudArt != null) ? playerHudArt.x : ((meterBack != null) ? meterBack.x : 0))
			: ((meterBack != null) ? meterBack.x : ((playerHudArt != null) ? playerHudArt.x : 0));
		var normalTargetLeftX = normalBaseLeftX
			+ (HatsuneHudLayout.SUBTITLE_NORMAL_OFFSET_X * uiScale)
			+ (downscroll ? (HatsuneHudLayout.SUBTITLE_NORMAL_DOWNSCROLL_OFFSET_X * uiScale) : 0);
		var normalGap = HatsuneHudLayout.SUBTITLE_NORMAL_HUD_GAP * uiScale;
		var normalStackGap = HatsuneHudLayout.SUBTITLE_SECONDARY_STACK_GAP * uiScale;
		var normalAnchorTopY = downscroll
			? ((playerHudArt != null) ? playerHudArt.y : ((meterBack != null) ? meterBack.y : Math.NaN))
			: ((meterBack != null) ? meterBack.y : ((playerHudArt != null) ? playerHudArt.y : Math.NaN));
		var normalNudgeY = (HatsuneHudLayout.SUBTITLE_NORMAL_OFFSET_Y * uiScale)
			+ (downscroll ? (HatsuneHudLayout.SUBTITLE_NORMAL_DOWNSCROLL_OFFSET_Y * uiScale) : 0);
		var normalPrimaryHasText = false;
		var normalPrimaryHeight = 0.0;
		if (primarySubtitleDisplay != null) {
			var primaryText = getSubtitleText(primarySubtitleDisplay);
			normalPrimaryHasText = primaryText != null && primaryText.text != null && primaryText.text != "";
			if (primarySubtitleDisplay.alignment != "bottom") primarySubtitleDisplay.alignment = "bottom";
			normalPrimaryHeight = getSubtitleDisplayHeight(primarySubtitleDisplay);
		}
		var normalBottomY = getSubtitleTargetBottomY(normalAnchorTopY, normalGap, normalNudgeY, FlxG.height - (139 + normalBottomOffsetY));
		if (downscroll) normalBottomY = mirrorBottomAlignedTarget(normalBottomY, normalPrimaryHeight);
		var normalOffsetY = getSubtitleBottomOffsetForBottomY(normalBottomY);
		if (primarySubtitleDisplay != null) {
			setSubtitleOffsets(primarySubtitleDisplay, 0, normalOffsetY);
			setSubtitleLeftX(primarySubtitleDisplay, normalTargetLeftX);
		}
		var normalSecondaryHasText = false;
		if (secondarySubtitleDisplay != null) {
			var secondaryText = getSubtitleText(secondarySubtitleDisplay);
			normalSecondaryHasText = secondaryText != null && secondaryText.text != null && secondaryText.text != "";
			if (secondaryText != null) {
				if (secondarySubtitleDisplay.alignment != "bottom") secondarySubtitleDisplay.alignment = "bottom";
				var normalSecondaryHeight = getSubtitleDisplayHeight(secondarySubtitleDisplay);
				var normalSecondaryTargetLeftX = normalTargetLeftX
					+ (HatsuneHudLayout.SUBTITLE_SECONDARY_NORMAL_OFFSET_X * uiScale)
					+ (downscroll ? (HatsuneHudLayout.SUBTITLE_SECONDARY_NORMAL_DOWNSCROLL_OFFSET_X * uiScale) : 0);
				var normalSecondaryBottomY = normalBottomY + normalPrimaryHeight + normalStackGap + normalSecondaryHeight;
				setSubtitleOffsets(
					secondarySubtitleDisplay,
					0,
					getSubtitleBottomOffsetForBottomY(
						normalSecondaryBottomY
						+ (HatsuneHudLayout.SUBTITLE_SECONDARY_NORMAL_OFFSET_Y * uiScale)
						+ (downscroll ? (HatsuneHudLayout.SUBTITLE_SECONDARY_NORMAL_DOWNSCROLL_OFFSET_Y * uiScale) : 0)
					)
				);
				setSubtitleLeftX(secondarySubtitleDisplay, normalSecondaryTargetLeftX);
			}
		}

		if (chanceSubtitleDisplay == null) return;

		var chanceActive = isChanceHudActive();
		var chanceLayoutActive = isChanceHudLayoutActive();
		setSubtitleDisplayEnabled(primarySubtitleDisplay, !chanceLayoutActive, !chanceLayoutActive && normalPrimaryHasText);
		setSubtitleDisplayEnabled(secondarySubtitleDisplay, !chanceLayoutActive, !chanceLayoutActive && normalSecondaryHasText);
		if (chanceSubtitleDisplay.active != chanceLayoutActive) chanceSubtitleDisplay.active = chanceLayoutActive;

		var chanceText = getSubtitleText(chanceSubtitleDisplay);
		var chanceHasText = chanceText != null && chanceText.text != null && chanceText.text != "";
		var chanceVisible = chanceLayoutActive && chanceHasText;
		if (chanceSecondarySubtitleDisplay != null && !chanceLayoutActive) setSubtitleDisplayEnabled(chanceSecondarySubtitleDisplay, false, false);
		if (lastChanceSubtitleVisible != chanceVisible) {
			chanceSubtitleDisplay.visible = chanceVisible;
			lastChanceSubtitleVisible = chanceVisible;
		}
		if (!chanceVisible) {
			setSubtitleDisplayEnabled(chanceSecondarySubtitleDisplay, false, false);
			return;
		}

		var chanceBaseLeftX = 0.0;
		if (chanceBottomHudArt != null) {
			chanceBaseLeftX = chanceBottomHudArt.x;
		} else if (chanceStarMeter != null) {
			chanceBaseLeftX = chanceStarMeter.x;
		} else if (meterBack != null) {
			chanceBaseLeftX = meterBack.x;
		}
		var chanceTargetLeftX = chanceBaseLeftX + (HatsuneHudLayout.SUBTITLE_CT_OFFSET_X * uiScale);
		var chanceGap = HatsuneHudLayout.SUBTITLE_CT_HUD_GAP * uiScale;
		var chanceStackGap = HatsuneHudLayout.SUBTITLE_SECONDARY_STACK_GAP * uiScale;
		var chanceAnchorTopY = Math.NaN;
		var chanceAnchorHeight = 0.0;
		if (chanceBottomHudArt != null) {
			chanceAnchorTopY = chanceBottomHudArt.y;
			chanceAnchorHeight = chanceBottomHudArt.height;
		} else if (chanceStarMeter != null) {
			chanceAnchorTopY = chanceStarMeter.y;
			chanceAnchorHeight = chanceStarMeter.height;
		} else if (meterBack != null) {
			chanceAnchorTopY = meterBack.y;
			chanceAnchorHeight = meterBack.height;
		}
		var chanceNudgeY = HatsuneHudLayout.SUBTITLE_CT_OFFSET_Y * uiScale;
		if (HatsuneHudLayout.isDownscroll()) chanceNudgeY += HatsuneHudLayout.SUBTITLE_CT_DOWNSCROLL_OFFSET_Y * uiScale;
		if (chanceSubtitleDisplay.alignment != "bottom") chanceSubtitleDisplay.alignment = "bottom";
		var chancePrimaryHeight = getSubtitleDisplayHeight(chanceSubtitleDisplay);
		var chanceBottomY = getSubtitleTargetBottomY(chanceAnchorTopY, chanceGap, chanceNudgeY, FlxG.height - (139 + chanceBottomOffsetY));
		if (downscroll) {
			var chanceBaseAnchorTopY = Math.isNaN(chanceAnchorTopY) ? chanceAnchorTopY : (chanceAnchorTopY - chanceBottomOffsetY);
			var chanceRestBottomY = getSubtitleTargetBottomY(chanceBaseAnchorTopY, chanceGap, chanceNudgeY, FlxG.height - 139);
			chanceBottomY = mirrorBottomAlignedTarget(chanceRestBottomY, chancePrimaryHeight) + chanceBottomOffsetY;
		}
		var chanceOffsetY = getSubtitleBottomOffsetForBottomY(chanceBottomY);
		setSubtitleOffsets(chanceSubtitleDisplay, 0, chanceOffsetY, true);
		setSubtitleLeftX(chanceSubtitleDisplay, chanceTargetLeftX + (downscroll ? (HatsuneHudLayout.SUBTITLE_CT_DOWNSCROLL_OFFSET_X * uiScale) : 0));

		if (chanceSecondarySubtitleDisplay != null) {
			var chanceSecondaryText = getSubtitleText(chanceSecondarySubtitleDisplay);
			var chanceSecondaryHasText = chanceSecondaryText != null && chanceSecondaryText.text != null && chanceSecondaryText.text != "";
			setSubtitleDisplayEnabled(chanceSecondarySubtitleDisplay, chanceLayoutActive, chanceLayoutActive && chanceSecondaryHasText);
			if (chanceSecondaryHasText) {
				if (chanceSecondarySubtitleDisplay.alignment != "bottom") chanceSecondarySubtitleDisplay.alignment = "bottom";
				var chanceSecondaryHeight = getSubtitleDisplayHeight(chanceSecondarySubtitleDisplay);
				var chanceSecondaryBottomY = chanceBottomY + chancePrimaryHeight + chanceStackGap + chanceSecondaryHeight;
				var chanceSecondaryTargetLeftX = chanceTargetLeftX + (HatsuneHudLayout.SUBTITLE_SECONDARY_CT_OFFSET_X * uiScale)
					+ (downscroll ? (HatsuneHudLayout.SUBTITLE_CT_DOWNSCROLL_OFFSET_X * uiScale) : 0);
				setSubtitleOffsets(
					chanceSecondarySubtitleDisplay,
					0,
					getSubtitleBottomOffsetForBottomY(chanceSecondaryBottomY + (HatsuneHudLayout.SUBTITLE_SECONDARY_CT_OFFSET_Y * uiScale)),
					true
				);
				setSubtitleLeftX(chanceSecondarySubtitleDisplay, chanceSecondaryTargetLeftX);
			}
		}
	}

	function setSpriteArrayVisible(sprites:Array<FlxSprite>, visible:Bool) {
		if (sprites == null) return;
		for (sprite in sprites) setSpriteVisible(sprite, visible);
	}

	function setChanceHudOnlyVisible(visible:Bool) {
		setSpriteVisible(chanceBottomHudArt, visible);
		setSpriteVisible(chanceTopHudArt, visible);
		setSpriteVisible(chanceScoreHudArt, false);
		setSpriteVisible(chanceStarMeter, visible);
		setSpriteVisible(chanceStarMeterStroke, visible);
		setSpriteArrayVisible(chanceBottomHudLeftExt, visible);
		setSpriteArrayVisible(chanceBottomHudRightExt, visible);
		setSpriteArrayVisible(chanceTopHudLeftExt, visible);
		setSpriteArrayVisible(chanceTopHudRightExt, visible);
		setSpriteVisible(chanceSongHudIcon, visible);
	}

	function isChanceHudLayoutActive():Bool {
		if (isChanceHudActive()) return true;
		return isChanceHudTweening();
	}

	function isChanceHudTweening():Bool {
		if (chanceHudTweens == null || chanceHudTweens.length <= 0) return false;
		for (tween in chanceHudTweens) {
			if (tween != null && tween.active) return true;
		}
		return false;
	}

	function updateChanceHudVisibility(ps:PlayState) {
		var chanceActive = isChanceHudActive();
		var chanceLayoutActive = isChanceHudLayoutActive();
		setChanceHudOnlyVisible(chanceLayoutActive);
		if (lastAppliedChanceHudVisibility == chanceLayoutActive) {
			if (ps != null && ps.scoreText != null && ps.scoreText.visible) ps.scoreText.visible = false;
			return;
		}
		lastAppliedChanceHudVisibility = chanceLayoutActive;

		setSpriteVisible(playerHudArt, true);
		setSpriteVisible(healthHudArt, true);
		setSpriteVisible(scoreHudArt, true);
		setSpriteVisible(songHudIcon, !chanceLayoutActive);
		setSpriteVisible(lifeHudIcon, true);
		setSpriteVisible(hpBox, false);
		setSpriteVisible(meterBack, true);
		setSpriteVisible(meter, true);
		setSpriteVisible(borderTop, true);
		setSpriteVisible(borderBottom, true);
		setSpriteVisible(borderLeft, true);
		setSpriteVisible(borderRight, true);
		setSpriteVisible(scoreRankBadge, scoreRankBadge != null && scoreRankBadge.visible);
		setSpriteVisible(scoreRankSparkle, scoreRankSparkle != null && scoreRankSparkle.visible);
		setSpriteVisible(songHudDifficulty, HatsuneHudLayout.SONG_LABEL_DIFFICULTY_SHOW && !chanceLayoutActive);

		for (digit in scoreDigits) setSpriteVisible(digit, digit != null);

		setTextVisible(protectedText, MHE_SharedState.drainActive);
		setTextVisible(lifeLabel, HatsuneHudLayout.LIFE_LABEL_SHOW);
		setTextVisible(songHudLabel, true);

		if (ps != null && ps.iconP1 != null) {
			ps.iconP1.visible = true;
			ps.iconP1.autoUpdate = false;
		}
		if (ps != null && ps.scoreText != null) {
			ps.scoreText.visible = false;
		}
	}

	function getBottomHudTransitionDistance(uiScale:Float):Float {
		var largest = 0.0;
		if (playerHudArt != null && playerHudArt.height > largest) largest = playerHudArt.height;
		if (HatsuneHudLayout.HEALTH_HUD_ANCHOR_BOTTOM && healthHudArt != null && healthHudArt.height > largest) largest = healthHudArt.height;
		if (HatsuneHudLayout.ICON_ANCHOR_BOTTOM && PlayState.instance != null && PlayState.instance.iconP1 != null && PlayState.instance.iconP1.height > largest) largest = PlayState.instance.iconP1.height;
		if (chanceBottomHudArt != null && chanceBottomHudArt.height > largest) largest = chanceBottomHudArt.height;
		return largest + (64 * uiScale);
	}

	function getTopHudTransitionDistance(uiScale:Float):Float {
		var largest = 0.0;
		if (scoreHudArt != null && scoreHudArt.height > largest) largest = scoreHudArt.height;
		if (chanceTopHudArt != null && chanceTopHudArt.height > largest) largest = chanceTopHudArt.height;
		if (songHudIcon != null && songHudIcon.height > largest) largest = songHudIcon.height;
		if (chanceSongHudIcon != null && chanceSongHudIcon.height > largest) largest = chanceSongHudIcon.height;
		if (!HatsuneHudLayout.HEALTH_HUD_ANCHOR_BOTTOM && healthHudArt != null && healthHudArt.height > largest) largest = healthHudArt.height;
		if (!HatsuneHudLayout.ICON_ANCHOR_BOTTOM && PlayState.instance != null && PlayState.instance.iconP1 != null && PlayState.instance.iconP1.height > largest) largest = PlayState.instance.iconP1.height;
		if (lifeHudIcon != null && lifeHudIcon.height > largest) largest = lifeHudIcon.height;
		if (lifeLabel != null && lifeLabel.height > largest) largest = lifeLabel.height;
		if (protectedText != null && protectedText.height > largest) largest = protectedText.height;
		return largest + (64 * uiScale);
	}

	function getNormalBottomHudHiddenOffset(distance:Float):Float {
		return HatsuneHudLayout.isDownscroll() ? -distance : distance;
	}

	function getChanceBottomHudHiddenOffset(distance:Float):Float {
		return HatsuneHudLayout.isDownscroll() ? -distance : distance;
	}

	function getTopHudHiddenOffset(distance:Float):Float {
		return HatsuneHudLayout.isDownscroll() ? distance : -distance;
	}

	function getHealthHudOffsetY():Float {
		return HatsuneHudLayout.HEALTH_HUD_ANCHOR_BOTTOM ? normalBottomOffsetY : normalTopOffsetY;
	}

	function clearChanceHudTweens() {
		for (tween in chanceHudTweens) {
			if (tween != null) tween.cancel();
		}
		chanceHudTweens = [];
	}

	function applyChanceHudStateInstant(chanceActive:Bool, uiScale:Float) {
		var bottomDistance = getBottomHudTransitionDistance(uiScale);
		var topDistance = getTopHudTransitionDistance(uiScale);
		var normalBottomHiddenOffset = getNormalBottomHudHiddenOffset(bottomDistance);
		var chanceBottomHiddenOffset = getChanceBottomHudHiddenOffset(bottomDistance);
		var topHiddenOffset = getTopHudHiddenOffset(topDistance);
		normalBottomOffsetY = chanceActive ? normalBottomHiddenOffset : 0;
		chanceBottomOffsetY = chanceActive ? 0 : chanceBottomHiddenOffset;
		normalTopOffsetY = chanceActive ? topHiddenOffset : 0;
		chanceTopOffsetY = chanceActive ? 0 : topHiddenOffset;
		MHE_SharedState.chanceTimeNormalBottomHudOffsetY = normalBottomOffsetY;
		MHE_SharedState.chanceTimeNormalTopHudOffsetY = normalTopOffsetY;
	}

	function tweenChanceHudOffset(fromValue:Float, toValue:Float, duration:Float, setter:Float->Void) {
		if (setter == null) return null;
		if (duration <= 0) {
			setter(toValue);
			return null;
		}
		return FlxTween.num(fromValue, toValue, duration, {onUpdate: function(tween) {
			setter(tween.value);
		}}, function(value) {
			setter(value);
		});
	}

	function updateChanceHudTransition(force:Bool = false) {
		var chanceActive = isChanceHudActive();
		var uiScale = HatsuneHudLayout.getUiScale();
		if (force || lastChanceTimeActive == null) {
			clearChanceHudTweens();
			applyChanceHudStateInstant(chanceActive, uiScale);
			lastChanceTimeActive = chanceActive;
			return;
		}
		if (lastChanceTimeActive == chanceActive) return;

		lastChanceTimeActive = chanceActive;
		clearChanceHudTweens();

		var bottomDistance = getBottomHudTransitionDistance(uiScale);
		var topDistance = getTopHudTransitionDistance(uiScale);
		var normalBottomHiddenOffset = getNormalBottomHudHiddenOffset(bottomDistance);
		var chanceBottomHiddenOffset = getChanceBottomHudHiddenOffset(bottomDistance);
		var topHiddenOffset = getTopHudHiddenOffset(topDistance);
		var duration = HatsuneHudLayout.CT_HUD_TRANSITION_DURATION;
		if (duration <= 0) duration = 0.72;

		var tween = tweenChanceHudOffset(normalBottomOffsetY, chanceActive ? normalBottomHiddenOffset : 0, duration, function(value) {
			normalBottomOffsetY = value;
			MHE_SharedState.chanceTimeNormalBottomHudOffsetY = value;
		});
		if (tween != null) chanceHudTweens.push(tween);
		tween = tweenChanceHudOffset(chanceBottomOffsetY, chanceActive ? 0 : chanceBottomHiddenOffset, duration, function(value) {
			chanceBottomOffsetY = value;
		});
		if (tween != null) chanceHudTweens.push(tween);
		tween = tweenChanceHudOffset(normalTopOffsetY, chanceActive ? topHiddenOffset : 0, duration, function(value) {
			normalTopOffsetY = value;
			MHE_SharedState.chanceTimeNormalTopHudOffsetY = value;
		});
		if (tween != null) chanceHudTweens.push(tween);
		tween = tweenChanceHudOffset(chanceTopOffsetY, chanceActive ? 0 : topHiddenOffset, duration, function(value) {
			chanceTopOffsetY = value;
		});
		if (tween != null) chanceHudTweens.push(tween);
	}

	function isVpScoreDigitsAtlas():Bool {
		return scoreDigitsAtlasKey == vpScoreDigitsAtlasKey;
	}

	function getScoreDigitAnimPrefix(frameName:String):String {
		if (frameName == null) return null;
		switch (frameName) {
			case "digital 0":
				return "ZERO DIGITAL";
			case "digital 1":
				return "ONE DIGITAL";
			case "digital 2":
				return "TWO DIGITAL";
			case "digital 3":
				return "THREE DIGITAL";
			case "digital 4":
				return "FOUR DIGITAL";
			case "digital 5":
				return "FIVE DIGITAL";
			case "digital 6":
				return "SIX DIGITAL";
			case "digital 7":
				return "SEVEN DIGITAL";
			case "digital 8":
				return "EIGHT DIGITAL";
			case "digital 9":
				return "NINE DIGITAL";
			default:
				return null;
		}
	}

	function ensureScoreDigitAnimations(sprite:FlxSprite) {
		if (sprite == null || sprite.animation == null) return;
		var animFps = HatsuneHudLayout.SCORE_DIGITS_VP_ANIM_FPS;
		if (animFps <= 0) animFps = 24;

		if (sprite.animation.getByName("digital 0") == null) sprite.animation.addByPrefix("digital 0", "ZERO DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 1") == null) sprite.animation.addByPrefix("digital 1", "ONE DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 2") == null) sprite.animation.addByPrefix("digital 2", "TWO DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 3") == null) sprite.animation.addByPrefix("digital 3", "THREE DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 4") == null) sprite.animation.addByPrefix("digital 4", "FOUR DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 5") == null) sprite.animation.addByPrefix("digital 5", "FIVE DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 6") == null) sprite.animation.addByPrefix("digital 6", "SIX DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 7") == null) sprite.animation.addByPrefix("digital 7", "SEVEN DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 8") == null) sprite.animation.addByPrefix("digital 8", "EIGHT DIGITAL", animFps, false);
		if (sprite.animation.getByName("digital 9") == null) sprite.animation.addByPrefix("digital 9", "NINE DIGITAL", animFps, false);
	}

	function ensureAllScoreDigitAnimations() {
		if (scoreDigits == null) return;
		for (digit in scoreDigits) {
			if (digit == null) continue;
			if (vpScoreDigitsAtlasFrames != null && digit.frames != vpScoreDigitsAtlasFrames) digit.frames = vpScoreDigitsAtlasFrames;
			ensureScoreDigitAnimations(digit);
		}
		vpScoreDigitAnimationsReady = true;
	}

	function createScoreRankBadgeSprite(cam):FlxSprite {
		var badgeFrames = Paths.getSparrowAtlas(scoreRankBadgeAtlasKey);
		if (badgeFrames == null) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = HatsuneHudLayout.SCORE_RANK_BADGE_Z;
		spr.origin.set(0, 0);
		spr.frames = badgeFrames;
		spr.animation.addByPrefix("LOSS", "LOSS rank", 24, false);
		spr.animation.addByPrefix("GOOD", "GOOD rank", 24, false);
		spr.animation.addByPrefix("GREAT", "GREAT rank", 24, false);
		spr.animation.addByPrefix("EXCELLENT", "EXCELLENT rank", 24, false);
		spr.animation.addByPrefix("PERFECT", "PERFECT rank", 24, false);
		spr.animation.addByPrefix("PERFECT_GOLD", "PERFECT rank GOLD", 24, false);
		scoreRankBadgeFrameCache = new StringMap();
		scoreRankBadgeResolvedFrameNames = new StringMap();
		if (badgeFrames.frames != null) {
			for (frame in badgeFrames.frames) {
				if (frame != null && frame.name != null) {
					scoreRankBadgeFrameCache.set(frame.name, frame);
					cacheScoreRankBadgeFrameName("LOSS", frame.name, "LOSS rank");
					cacheScoreRankBadgeFrameName("GOOD", frame.name, "GOOD rank");
					cacheScoreRankBadgeFrameName("GREAT", frame.name, "GREAT rank");
					cacheScoreRankBadgeFrameName("EXCELLENT", frame.name, "EXCELLENT rank");
					cacheScoreRankBadgeFrameName("PERFECT", frame.name, "PERFECT rank");
					cacheScoreRankBadgeFrameName("PERFECT_GOLD", frame.name, "PERFECT rank GOLD");
				}
			}
		}
		spr.visible = false;
		return spr;
	}

	function createScoreRankSparkleSprite(cam):FlxSprite {
		var sparkleFrames = Paths.getSparrowAtlas("freeplay/sparkle");
		if (sparkleFrames == null) return null;

		var spr = new FlxSprite();
		spr.scrollFactor.set();
		spr.cameras = [cam];
		spr.zIndex = HatsuneHudLayout.SCORE_RANK_SPARKLE_Z;
		spr.frames = sparkleFrames;
		spr.animation.addByPrefix("sparkle", "sparkle Export0", 24, false);
		spr.animation.play("sparkle", true);
		spr.scale.set(HatsuneHudLayout.SCORE_RANK_SPARKLE_SCALE, HatsuneHudLayout.SCORE_RANK_SPARKLE_SCALE);
		spr.blend = "add";
		spr.visible = false;
		spr.alpha = HatsuneHudLayout.SCORE_RANK_SPARKLE_ALPHA;
		spr.updateHitbox();
		return spr;
	}

	function stopScoreRankSparkle() {
		if (scoreRankSparkleTimer != null) {
			scoreRankSparkleTimer.cancel();
		}
		if (scoreRankSparkle != null) scoreRankSparkle.visible = false;
	}

	function triggerScoreRankSparkle(timer:FlxTimer) {
		if (scoreRankSparkle == null || scoreRankBadge == null || !scoreRankBadge.visible || lastScoreRankBadgeAnim != "PERFECT_GOLD") {
			stopScoreRankSparkle();
			return;
		}

		refreshScoreRankSparkleTransform();
		var minX = scoreRankBadge.x + (scoreRankBadge.width * HatsuneHudLayout.SCORE_RANK_SPARKLE_OFFSET_LEFT_RATIO);
		var maxX = scoreRankBadge.x + (scoreRankBadge.width * HatsuneHudLayout.SCORE_RANK_SPARKLE_OFFSET_RIGHT_RATIO);
		var minY = scoreRankBadge.y + (scoreRankBadge.height * HatsuneHudLayout.SCORE_RANK_SPARKLE_OFFSET_TOP_RATIO);
		var maxY = scoreRankBadge.y + (scoreRankBadge.height * HatsuneHudLayout.SCORE_RANK_SPARKLE_OFFSET_BOTTOM_RATIO);
		if (maxX < minX) {
			var swapX = minX;
			minX = maxX;
			maxX = swapX;
		}
		if (maxY < minY) {
			var swapY = minY;
			minY = maxY;
			maxY = swapY;
		}
		scoreRankSparkle.setPosition(FlxG.random.float(minX, maxX), FlxG.random.float(minY, maxY));
		scoreRankSparkle.animation.play("sparkle", true);
		scoreRankSparkle.visible = true;
		var nextDelay = FlxG.random.float(1.2, 4.5);
		if (timer != null) {
			scoreRankSparkleTimer = timer.start(nextDelay, triggerScoreRankSparkle);
		} else if (scoreRankSparkleTimer != null) {
			scoreRankSparkleTimer = scoreRankSparkleTimer.start(nextDelay, triggerScoreRankSparkle);
		} else {
			scoreRankSparkleTimer = new FlxTimer().start(nextDelay, triggerScoreRankSparkle);
		}
	}

	function refreshScoreRankSparkleTransform() {
		if (scoreRankSparkle == null || scoreRankBadge == null) return;

		var sparkleScale = HatsuneHudLayout.SCORE_RANK_SPARKLE_SCALE;
		var sparkleHeightRatio = HatsuneHudLayout.SCORE_RANK_SPARKLE_HEIGHT_RATIO;
		if (sparkleScale <= 0) sparkleScale = 1.0;
		if (sparkleHeightRatio <= 0) sparkleHeightRatio = 1.0;

		var targetSparkleHeight = Std.int(scoreRankBadge.height * sparkleHeightRatio * sparkleScale);
		if (targetSparkleHeight < 1) targetSparkleHeight = 1;
		scoreRankSparkle.setGraphicSize(0, targetSparkleHeight);
		scoreRankSparkle.updateHitbox();
		scoreRankSparkle.alpha = HatsuneHudLayout.SCORE_RANK_SPARKLE_ALPHA;
	}

	function updateScoreRankSparkleState(rankAnim:String) {
		if (scoreRankSparkle == null) return;

		if (rankAnim == "PERFECT_GOLD") {
			scoreRankSparkle.visible = true;
			if (scoreRankSparkleTimer != null) {
				scoreRankSparkleTimer = scoreRankSparkleTimer.start(1, triggerScoreRankSparkle);
			} else {
				scoreRankSparkleTimer = new FlxTimer().start(1, triggerScoreRankSparkle);
			}
		} else {
			stopScoreRankSparkle();
		}
	}

	function cacheScoreRankBadgeFrameName(rankKey:String, frameName:String, prefix:String) {
		if (frameName == null || prefix == null) return;
		if (frameName.length < prefix.length || frameName.substr(0, prefix.length) != prefix) return;

		var currentFrameName = scoreRankBadgeResolvedFrameNames.get(rankKey);
		if (currentFrameName == null || frameName > currentFrameName) scoreRankBadgeResolvedFrameNames.set(rankKey, frameName);
	}

	function applyAtlasFrame(sprite:FlxSprite, frameName:String, forceReload:Bool):Bool {
		if (sprite == null) return false;
		var selection = selectHudAtlasFrame(frameName, forceReload);
		if (selection == null || selection.frames == null || selection.frame == null) return false;

		sprite.frames = selection.frames;
		sprite.frame = selection.frame;
		sprite.visible = true;
		sprite.updateHitbox();
		return true;
	}

	function applyScoreDigitFrame(sprite:FlxSprite, frameName:String, forceReload:Bool):Bool {
		if (sprite == null) return false;
		if (forceReload || scoreDigitsAtlasFrames == null) reloadScoreDigitsAtlas();
		if (scoreDigitsAtlasFrames == null) return false;

		var selectedFrame = scoreDigitFrameCache.get(frameName);
		if (selectedFrame == null && !forceReload) {
			reloadScoreDigitsAtlas();
			selectedFrame = scoreDigitFrameCache.get(frameName);
		}
		if (selectedFrame == null) return false;

		var framesChanged = (sprite.frames != scoreDigitsAtlasFrames);
		if (framesChanged) sprite.frames = scoreDigitsAtlasFrames;
		if (isVpScoreDigitsAtlas() && framesChanged) ensureScoreDigitAnimations(sprite);
		sprite.frame = selectedFrame;
		if (sprite.animation != null && sprite.animation.curAnim != null) sprite.animation.stop();
		sprite.visible = true;
		sprite.updateHitbox();
		return true;
	}

	function reloadChanceTimeMeterAtlases() {
		chanceTimeMeterAtlasFrames = [];
		chanceTimeMeterFrameCache = new StringMap();
		chanceTimeMeterFrameAtlasCache = new StringMap();

		for (atlasKey in chanceTimeMeterAtlasKeys) {
			var atlasFrames = Paths.getSparrowAtlas(atlasKey);
			if (atlasFrames == null) continue;
			chanceTimeMeterAtlasFrames.push(atlasFrames);
			if (atlasFrames.frames == null) continue;
			for (frame in atlasFrames.frames) {
				if (frame == null || frame.name == null) continue;
				chanceTimeMeterFrameCache.set(frame.name, frame);
				chanceTimeMeterFrameAtlasCache.set(frame.name, atlasFrames);
			}
		}
	}

	function precacheChanceTimeAssets() {
		var cachedTextureKeys = new StringMap();

		cacheTextureKey(Paths.image(hudAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image(downscrollHudAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image(defaultScoreDigitsAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image(scoreDigitsAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image(vpScoreDigitsAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image(scoreRankBadgeAtlasKey), cachedTextureKeys);
		cacheTextureKey(Paths.image("freeplay/sparkle"), cachedTextureKeys);
		cacheTextureKey(Paths.image("storymenu/difficulties/easy"), cachedTextureKeys);
		cacheTextureKey(Paths.image("storymenu/difficulties/normal"), cachedTextureKeys);
		cacheTextureKey(Paths.image("storymenu/difficulties/hard"), cachedTextureKeys);

		for (atlasKey in chanceTimeMeterAtlasKeys) {
			cacheTextureKey(Paths.image(atlasKey), cachedTextureKeys);
		}

		buildScoreDigitsAtlasCache(defaultScoreDigitsAtlasKey, false);
		buildScoreDigitsAtlasCache(vpScoreDigitsAtlasKey, true);
		reloadChanceTimeMeterAtlases();
	}

	function cacheTextureKey(textureKey:String, cachedTextureKeys:StringMap<Dynamic>) {
		if (textureKey == null || textureKey == "" || cachedTextureKeys == null) return;
		if (cachedTextureKeys.exists(textureKey)) return;
		cachedTextureKeys.set(textureKey, true);
		FunkinMemory.cacheTexture(textureKey);
	}

	function applyChanceTimeMeterFrame(sprite:FlxSprite, frameName:String, forceReload:Bool):Bool {
		if (sprite == null) return false;
		if (forceReload || chanceTimeMeterFrameCache == null || chanceTimeMeterFrameCache.get(frameName) == null) reloadChanceTimeMeterAtlases();

		var selectedFrame = chanceTimeMeterFrameCache.get(frameName);
		var selectedAtlas = chanceTimeMeterFrameAtlasCache.get(frameName);
		if (selectedFrame == null || selectedAtlas == null) return false;
		if (!forceReload && sprite.frames == selectedAtlas && sprite.frame == selectedFrame) return true;

		sprite.frames = selectedAtlas;
		sprite.frame = selectedFrame;
		sprite.visible = true;
		sprite.updateHitbox();
		return true;
	}

	function getChanceTimeMeterFrameName():String {
		var maxMeter = MHE_SharedState.chanceTimeMeterMax;
		if (maxMeter <= 0) maxMeter = 100.0;
		var meterValue = MHE_SharedState.chanceTimeMeter;
		if (meterValue < 0) meterValue = 0;
		if (meterValue > maxMeter) meterValue = maxMeter;

		var ratio = meterValue / maxMeter;
		if (ratio < 0) ratio = 0;
		if (ratio > 1) ratio = 1;

		var frameIndex = 1 + Std.int(Math.round(ratio * 17));
		if (frameIndex < 1) frameIndex = 1;
		if (frameIndex > 18) frameIndex = 18;

		var frameId = Std.string(frameIndex);
		while (frameId.length < 4) frameId = "0" + frameId;
		return "ct charge" + frameId;
	}

	function refreshDecorFrames(forceReload:Bool) {
		if (forceReload) {
			reloadHudAtlas();
			reloadDownscrollHudAtlas();
		}
		var ready = true;
		ready = applyAtlasFrame(playerHudArt, playerHudFrameName, false) && ready;
		ready = applyAtlasFrame(healthHudArt, healthHudFrameName, false) && ready;
		ready = applyAtlasFrame(scoreHudArt, scoreHudFrameName, false) && ready;
		ready = applyAtlasFrame(chanceBottomHudArt, HatsuneHudLayout.CT_BOTTOM_HUD_FRAME, false) && ready;
		ready = applyAtlasFrame(chanceTopHudArt, HatsuneHudLayout.CT_TOP_HUD_FRAME, false) && ready;
		ready = applyAtlasFrame(chanceScoreHudArt, scoreHudFrameName, false) && ready;
		for (sprite in chanceBottomHudLeftExt) ready = applyAtlasFrame(sprite, HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME, false) && ready;
		for (sprite in chanceBottomHudRightExt) ready = applyAtlasFrame(sprite, HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME, false) && ready;
		for (sprite in chanceTopHudLeftExt) ready = applyAtlasFrame(sprite, HatsuneHudLayout.CT_TOP_HUD_EX_FRAME, false) && ready;
		for (sprite in chanceTopHudRightExt) ready = applyAtlasFrame(sprite, HatsuneHudLayout.CT_TOP_HUD_EX_FRAME, false) && ready;
		ready = applyAtlasFrame(songHudIcon, songHudIconFrameName, false) && ready;
		ready = applyAtlasFrame(chanceSongHudIcon, HatsuneHudLayout.CT_SONG_ICON_FRAME, false) && ready;
		ready = applyAtlasFrame(lifeHudIcon, lifeHudIconFrameName, false) && ready;
		if (chanceStarMeter != null) ready = applyChanceTimeMeterFrame(chanceStarMeter, getChanceTimeMeterFrameName(), forceReload) && ready;
		if (chanceStarMeterStroke != null) ready = applyChanceTimeMeterFrame(chanceStarMeterStroke, "ct stroke", forceReload) && ready;
		decorFramesReady = ready;
	}

	function syncChanceHudExtCount(stateRef, sprites:Array<FlxSprite>, targetCount:Int, frameName:String, zIndex:Int, cam):Bool {
		if (sprites == null) return false;
		if (targetCount < 0) targetCount = 0;

		var changed = false;
		while (sprites.length < targetCount) {
			var spr = createAtlasSprite(frameName, zIndex, cam);
			if (spr == null) break;
			sprites.push(spr);
			if (stateRef != null) stateRef.add(spr);
			changed = true;
		}

		while (sprites.length > targetCount) {
			var spr = sprites.pop();
			removeAndDestroy(stateRef, spr);
			changed = true;
		}

		if (changed) requestStateRefresh(stateRef);
		return changed;
	}

	function layoutChanceHudExtRow(mainSprite:FlxSprite, leftExt:Array<FlxSprite>, rightExt:Array<FlxSprite>, frameName:String, scale:Float, yOffset:Float, downscroll:Bool, cam,
		alignBottom:Bool = false, overlap:Float = 0) {
		var stateRef = (trackedState != null) ? trackedState : PlayState.instance;
		if (mainSprite == null) {
			syncChanceHudExtCount(stateRef, leftExt, 0, frameName, HatsuneHudLayout.PLAYER_HUD_Z, cam);
			syncChanceHudExtCount(stateRef, rightExt, 0, frameName, HatsuneHudLayout.PLAYER_HUD_Z, cam);
			return;
		}

		var extFrame = findAtlasFrame(frameName);
		if (extFrame == null) {
			syncChanceHudExtCount(stateRef, leftExt, 0, frameName, HatsuneHudLayout.PLAYER_HUD_Z, cam);
			syncChanceHudExtCount(stateRef, rightExt, 0, frameName, HatsuneHudLayout.PLAYER_HUD_Z, cam);
			return;
		}

		if (scale <= 0) scale = 1.0;
		var mainFrameWidth = getSpriteFrameWidth(mainSprite);
		var actualScale = scale;
		if (mainFrameWidth > 0 && mainSprite.width > 0) actualScale = mainSprite.width / mainFrameWidth;
		if (actualScale <= 0) actualScale = scale;
		var targetWidth = extFrame.frame.width * actualScale;
		if (targetWidth < 1) targetWidth = 1;
		var overlapPixels = Std.int(Math.floor(overlap));
		if (overlapPixels < 0) overlapPixels = 0;
		if (overlapPixels >= targetWidth) overlapPixels = Std.int(targetWidth) - 1;
		var stride = targetWidth - overlapPixels;
		if (stride < 1) stride = 1;

		var leftGap = Std.int(Math.max(0, Math.ceil(mainSprite.x)));
		var rightGap = Std.int(Math.max(0, Math.ceil(FlxG.width - (mainSprite.x + mainSprite.width))));
		var leftCount = Std.int(Math.ceil(leftGap / stride));
		var rightCount = Std.int(Math.ceil(rightGap / stride));

		syncChanceHudExtCount(stateRef, leftExt, leftCount, frameName, mainSprite.zIndex, cam);
		syncChanceHudExtCount(stateRef, rightExt, rightCount, frameName, mainSprite.zIndex, cam);

		for (index in 0...leftExt.length) {
			var sprite = leftExt[index];
			if (sprite == null) continue;
			if (sprite.scale.x != actualScale || sprite.scale.y != actualScale) {
				sprite.scale.set(actualScale, actualScale);
				sprite.updateHitbox();
			}
			if (sprite.flipY) sprite.flipY = false;
			sprite.x = Std.int(mainSprite.x - ((index + 1) * stride));
			sprite.y = alignBottom
				? Std.int(mainSprite.y + mainSprite.height - sprite.height + yOffset)
				: Std.int(mainSprite.y + yOffset);
		}

		for (index in 0...rightExt.length) {
			var sprite = rightExt[index];
			if (sprite == null) continue;
			if (sprite.scale.x != actualScale || sprite.scale.y != actualScale) {
				sprite.scale.set(actualScale, actualScale);
				sprite.updateHitbox();
			}
			if (sprite.flipY) sprite.flipY = false;
			sprite.x = Std.int(mainSprite.x + mainSprite.width - overlapPixels + (index * stride));
			sprite.y = alignBottom
				? Std.int(mainSprite.y + mainSprite.height - sprite.height + yOffset)
				: Std.int(mainSprite.y + yOffset);
		}
	}

	function findAtlasFrame(frameName:String):FlxFrame {
		if (hudAtlasFrameCache == null) return null;
		return hudAtlasFrameCache.get(frameName);
	}

	override function onStateChangeBegin(event) {
		super.onStateChangeBegin(event);
		hudPaused = false;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		restoreVanilla();
	}

	override function onDestroy(event) {
		super.onDestroy(event);
		hudPaused = false;
		hudInfoUpdateAccumulator = hudInfoUpdateInterval;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		restoreVanilla();
	}

	function ensureBuilt(ps) {
		if (hudBuilt) return;
		if (ps.healthBar == null || ps.scoreText == null || ps.iconP1 == null) return;

		captureVanillaState(ps);
		cleanupSprites(ps);
		resetRuntimeCache();

		if (ps.healthBar != null) ps.healthBar.visible = false;
		if (ps.healthBarBG != null) ps.healthBarBG.visible = false;
		if (ps.iconP2 != null) {
			ps.iconP2.visible = false;
			ps.iconP2.autoUpdate = false;
		}

		enforceIconState(ps);

		playerHudArt = createAtlasSprite(playerHudFrameName, HatsuneHudLayout.PLAYER_HUD_Z, ps.camHUD);
		healthHudArt = createAtlasSprite(healthHudFrameName, HatsuneHudLayout.HEALTH_HUD_Z, ps.camHUD);
		scoreHudArt = createAtlasSprite(scoreHudFrameName, HatsuneHudLayout.SCORE_HUD_Z, ps.camHUD);
		chanceBottomHudArt = createAtlasSprite(HatsuneHudLayout.CT_BOTTOM_HUD_FRAME, HatsuneHudLayout.PLAYER_HUD_Z, ps.camHUD);
		chanceTopHudArt = createAtlasSprite(HatsuneHudLayout.CT_TOP_HUD_FRAME, HatsuneHudLayout.SCORE_HUD_Z, ps.camHUD);
		chanceScoreHudArt = createAtlasSprite(scoreHudFrameName, HatsuneHudLayout.SCORE_HUD_Z, ps.camHUD);
		chanceStarMeter = null;
		chanceStarMeterStroke = null;
		chanceBottomHudLeftExt = [];
		chanceBottomHudRightExt = [];
		chanceTopHudLeftExt = [];
		chanceTopHudRightExt = [];
		scoreRankBadge = createScoreRankBadgeSprite(ps.camHUD);
		scoreRankSparkle = createScoreRankSparkleSprite(ps.camHUD);
		reloadScoreDigitsAtlas();
		scoreDigits = [];
		var scoreDigitCount = HatsuneHudLayout.SCORE_DIGITS_COUNT;
		if (scoreDigitCount <= 0) scoreDigitCount = 7;
		for (i in 0...scoreDigitCount) {
			var scoreDigit = createScoreDigitSprite(HatsuneHudLayout.SCORE_DIGITS_Z, ps.camHUD);
			if (scoreDigit != null) scoreDigits.push(scoreDigit);
		}
		songHudIcon = createAtlasSprite(songHudIconFrameName, HatsuneHudLayout.SONG_ICON_Z, ps.camHUD);
		chanceSongHudIcon = createAtlasSprite(HatsuneHudLayout.CT_SONG_ICON_FRAME, HatsuneHudLayout.SONG_ICON_Z, ps.camHUD);
		lifeHudIcon = createAtlasSprite(lifeHudIconFrameName, HatsuneHudLayout.LIFE_ICON_Z, ps.camHUD);

		hpBox = new FlxSprite();
		hpBox.makeGraphic(boxW, boxH, FlxColor.TRANSPARENT);
		hpBox.scrollFactor.set();
		hpBox.cameras = [ps.camHUD];
		hpBox.visible = false;
		hpBox.zIndex = HatsuneHudLayout.HP_BOX_Z;

		meterBack = new FlxSprite();
		meterBack.makeGraphic(meterW, meterH, FlxColor.WHITE);
		meterBack.scrollFactor.set();
		meterBack.cameras = [ps.camHUD];
		meterBack.zIndex = HatsuneHudLayout.METER_BACK_Z;
		meterBack.origin.set(0, 0);
		meterBack.color = meterEmptyBack;

		meter = new FlxSprite();
		meter.makeGraphic(1, meterH, FlxColor.WHITE);
		meter.scrollFactor.set();
		meter.cameras = [ps.camHUD];
		meter.zIndex = HatsuneHudLayout.METER_Z;
		meter.origin.set(0, 0);

		protectedText = new FlxText(0, 0, meterW, "protected", HatsuneHudLayout.PROTECTED_TEXT_SIZE);
		protectedText.scrollFactor.set();
		protectedText.cameras = [ps.camHUD];
		protectedText.alignment = "center";
		protectedText.color = FlxColor.WHITE;
		protectedText.borderStyle = FlxTextBorderStyle.OUTLINE;
		protectedText.borderSize = HatsuneHudLayout.PROTECTED_TEXT_BORDER_SIZE;
		protectedText.borderColor = FlxColor.BLACK;
		protectedText.alpha = 0.95;
		protectedText.scale.set(HatsuneHudLayout.PROTECTED_TEXT_SCALE, HatsuneHudLayout.PROTECTED_TEXT_SCALE);
		protectedText.updateHitbox();
		protectedText.zIndex = HatsuneHudLayout.PROTECTED_TEXT_Z;
		protectedText.visible = false;

		lifeLabel = new FlxText(0, 0, 0, "LIFE", HatsuneHudLayout.LIFE_LABEL_SIZE);
		lifeLabel.scrollFactor.set();
		lifeLabel.cameras = [ps.camHUD];
		lifeLabel.font = "5by7";
		lifeLabel.alignment = "left";
		lifeLabel.color = FlxColor.WHITE;
		lifeLabel.borderStyle = FlxTextBorderStyle.OUTLINE;
		lifeLabel.borderColor = FlxColor.BLACK;
		lifeLabel.borderSize = HatsuneHudLayout.LIFE_LABEL_BORDER_SIZE;
		lifeLabel.scale.set(HatsuneHudLayout.LIFE_LABEL_SCALE, HatsuneHudLayout.LIFE_LABEL_SCALE);
		lifeLabel.zIndex = HatsuneHudLayout.LIFE_LABEL_Z;
		lifeLabel.visible = HatsuneHudLayout.LIFE_LABEL_SHOW;
		lifeLabel.updateHitbox();

		songHudLabel = new FlxText(0, 0, HatsuneHudLayout.SONG_LABEL_MAX_WIDTH, "", HatsuneHudLayout.SONG_LABEL_SIZE);
		songHudLabel.scrollFactor.set();
		songHudLabel.cameras = [ps.camHUD];
		songHudLabel.font = "5by7";
		songHudLabel.alignment = "left";
		songHudLabel.color = FlxColor.WHITE;
		songHudLabel.borderStyle = FlxTextBorderStyle.OUTLINE;
		songHudLabel.borderColor = FlxColor.BLACK;
		songHudLabel.borderSize = HatsuneHudLayout.SONG_LABEL_BORDER_SIZE;
		songHudLabel.scale.set(HatsuneHudLayout.SONG_LABEL_SCALE, HatsuneHudLayout.SONG_LABEL_SCALE);
		songHudLabel.zIndex = HatsuneHudLayout.SONG_LABEL_Z;
		songHudLabel.visible = true;
		songHudLabel.updateHitbox();

		songHudLabelMeasure = new FlxText(0, 0, 0, "", HatsuneHudLayout.SONG_LABEL_SIZE);
		songHudLabelMeasure.font = songHudLabel.font;
		songHudLabelMeasure.alignment = songHudLabel.alignment;
		songHudLabelMeasure.color = songHudLabel.color;
		songHudLabelMeasure.borderStyle = songHudLabel.borderStyle;
		songHudLabelMeasure.borderColor = songHudLabel.borderColor;
		songHudLabelMeasure.borderSize = songHudLabel.borderSize;
		songHudLabelMeasure.scale.set(songHudLabel.scale.x, songHudLabel.scale.y);
		songHudLabelMeasure.visible = false;
		songHudLabelMeasure.active = false;
		songHudLabelMeasure.updateHitbox();

		songHudDifficulty = new FlxSprite();
		songHudDifficulty.scrollFactor.set();
		songHudDifficulty.cameras = [ps.camHUD];
		songHudDifficulty.zIndex = HatsuneHudLayout.SONG_LABEL_DIFFICULTY_Z;
		songHudDifficulty.origin.set(0, 0);
		songHudDifficulty.visible = false;

		borderTop = new FlxSprite();
		borderTop.makeGraphic(boxW, borderThickness, FlxColor.BLACK);
		borderTop.scrollFactor.set();
		borderTop.cameras = [ps.camHUD];
		borderTop.zIndex = HatsuneHudLayout.BORDER_Z;
		borderTop.origin.set(0, 0);

		borderBottom = new FlxSprite();
		borderBottom.makeGraphic(boxW, borderThickness, FlxColor.BLACK);
		borderBottom.scrollFactor.set();
		borderBottom.cameras = [ps.camHUD];
		borderBottom.zIndex = HatsuneHudLayout.BORDER_Z;
		borderBottom.origin.set(0, 0);

		borderLeft = new FlxSprite();
		borderLeft.makeGraphic(borderThickness, meterH, FlxColor.BLACK);
		borderLeft.scrollFactor.set();
		borderLeft.cameras = [ps.camHUD];
		borderLeft.zIndex = HatsuneHudLayout.BORDER_Z;
		borderLeft.origin.set(0, 0);

		borderRight = new FlxSprite();
		borderRight.makeGraphic(borderThickness, meterH, FlxColor.BLACK);
		borderRight.scrollFactor.set();
		borderRight.cameras = [ps.camHUD];
		borderRight.zIndex = HatsuneHudLayout.BORDER_Z;
		borderRight.origin.set(0, 0);

		refreshBarSizing(true);

		if (playerHudArt != null) ps.add(playerHudArt);
		if (healthHudArt != null) ps.add(healthHudArt);
		if (scoreHudArt != null) ps.add(scoreHudArt);
		if (chanceBottomHudArt != null) ps.add(chanceBottomHudArt);
		if (chanceTopHudArt != null) ps.add(chanceTopHudArt);
		if (chanceScoreHudArt != null) ps.add(chanceScoreHudArt);
		syncChanceHudExtCount(ps, chanceBottomHudLeftExt, 0, HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME, HatsuneHudLayout.PLAYER_HUD_Z, ps.camHUD);
		syncChanceHudExtCount(ps, chanceBottomHudRightExt, 0, HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME, HatsuneHudLayout.PLAYER_HUD_Z, ps.camHUD);
		syncChanceHudExtCount(ps, chanceTopHudLeftExt, 0, HatsuneHudLayout.CT_TOP_HUD_EX_FRAME, HatsuneHudLayout.SCORE_HUD_Z, ps.camHUD);
		syncChanceHudExtCount(ps, chanceTopHudRightExt, 0, HatsuneHudLayout.CT_TOP_HUD_EX_FRAME, HatsuneHudLayout.SCORE_HUD_Z, ps.camHUD);
		if (scoreRankBadge != null) ps.add(scoreRankBadge);
		if (scoreRankSparkle != null) ps.add(scoreRankSparkle);
		for (scoreDigit in scoreDigits) {
			if (scoreDigit != null) ps.add(scoreDigit);
		}
		if (songHudIcon != null) ps.add(songHudIcon);
		if (chanceSongHudIcon != null) ps.add(chanceSongHudIcon);
		if (lifeHudIcon != null) ps.add(lifeHudIcon);
		ps.add(hpBox);
		ps.add(meterBack);
		ps.add(meter);
		ps.add(borderTop);
		ps.add(borderBottom);
		ps.add(borderLeft);
		ps.add(borderRight);
		ps.add(protectedText);
		ps.add(lifeLabel);
		ps.add(songHudDifficulty);
		ps.add(songHudLabel);
		ensureChanceSubtitleDisplay(ps);

		refreshBarColors(true);
		syncVanillaScoreText(ps.scoreText);
		applyScoreLayout(ps.scoreText, true);
		layoutScoreHud(ps.scoreText);
		var uiScale = HatsuneHudLayout.getUiScale();
		updateScoreRankBadge(ps, uiScale);
		updateScoreDigits(ps, uiScale);
		layoutHud(ps);
		updateSongHudLabel(ps, HatsuneHudLayout.isDownscroll(), HatsuneHudLayout.getUiScale());
		updateChanceHudTransition(true);
		lastAppliedChanceHudVisibility = null;
		updateChanceHudVisibility(ps);
		requestStateRefresh(ps);
		flushStateRefresh(ps);

		hudBuilt = true;
	}

	function captureVanillaState(ps) {
		if (trackedState == ps) return;

		trackedState = ps;
		originalHealthBarVisible = (ps.healthBar != null) ? ps.healthBar.visible : null;
		originalHealthBarBGVisible = (ps.healthBarBG != null) ? ps.healthBarBG.visible : null;

		if (ps.iconP1 != null) {
			originalIconP1Visible = ps.iconP1.visible;
			originalIconP1AutoUpdate = ps.iconP1.autoUpdate;
			originalIconP1BopEvery = ps.iconP1.bopEvery;
			if (ps.iconP1.size != null) {
				originalIconP1SizeX = ps.iconP1.size.x;
				originalIconP1SizeY = ps.iconP1.size.y;
			}
			originalIconFlipX = ps.iconP1.flipX;
		}

		if (ps.iconP2 != null) {
			originalIconP2Visible = ps.iconP2.visible;
			originalIconP2AutoUpdate = ps.iconP2.autoUpdate;
		}

		storeOriginalScoreState(ps.scoreText);

		if (ps.subtitles != null) {
			if (ps.subtitles.offsets != null && ps.subtitles.offsets.length > 1) {
				originalSubtitleOffsetX = ps.subtitles.offsets[0];
				originalSubtitleOffsetY = ps.subtitles.offsets[1];
			}
			originalSubtitleAlignment = ps.subtitles.alignment;
			var subtitleBackground = getSubtitleBackground(ps.subtitles);
			if (subtitleBackground != null) {
				originalSubtitleBackgroundVisible = subtitleBackground.visible;
				originalSubtitleBackgroundAlpha = subtitleBackground.alpha;
			}
		}
	}

	function storeOriginalScoreState(txt:FlxBitmapText) {
		if (txt == null) return;
		originalScoreX = txt.x;
		originalScoreY = txt.y;
		originalScoreScaleX = txt.scale.x;
		originalScoreScaleY = txt.scale.y;
		originalScoreAlignment = txt.alignment;
		originalScoreVisible = txt.visible;
	}

	function restoreVanilla() {
		var ps = (trackedState != null) ? trackedState : PlayState.instance;

		if (ps != null) {
			if (ps.healthBar != null && originalHealthBarVisible != null) ps.healthBar.visible = originalHealthBarVisible;
			if (ps.healthBarBG != null && originalHealthBarBGVisible != null) ps.healthBarBG.visible = originalHealthBarBGVisible;

			if (ps.iconP1 != null) {
				if (originalIconFlipX != null) ps.iconP1.flipX = originalIconFlipX;
				if (originalIconP1Visible != null) ps.iconP1.visible = originalIconP1Visible;
				if (originalIconP1AutoUpdate != null) ps.iconP1.autoUpdate = originalIconP1AutoUpdate;
				if (originalIconP1BopEvery != null) ps.iconP1.bopEvery = originalIconP1BopEvery;
				if (ps.iconP1.size != null && !Math.isNaN(originalIconP1SizeX) && !Math.isNaN(originalIconP1SizeY)) {
					ps.iconP1.size.set(originalIconP1SizeX, originalIconP1SizeY);
					if (ps.iconP1.snapToTargetSize != null) ps.iconP1.snapToTargetSize();
				}
			}

			if (ps.iconP2 != null) {
				if (originalIconP2Visible != null) ps.iconP2.visible = originalIconP2Visible;
				if (originalIconP2AutoUpdate != null) ps.iconP2.autoUpdate = originalIconP2AutoUpdate;
			}

			restoreScoreState(ps.scoreText);

			if (ps.subtitles != null) {
				if (!Math.isNaN(originalSubtitleOffsetX) && !Math.isNaN(originalSubtitleOffsetY)) {
					ps.subtitles.offsets = [originalSubtitleOffsetX, originalSubtitleOffsetY];
				}
				if (originalSubtitleAlignment != null) ps.subtitles.alignment = originalSubtitleAlignment;
				ps.subtitles.active = true;
				ps.subtitles.visible = true;
				var subtitleBackground = getSubtitleBackground(ps.subtitles);
				if (subtitleBackground != null) {
					if (originalSubtitleBackgroundVisible != null) subtitleBackground.visible = originalSubtitleBackgroundVisible;
					if (!Math.isNaN(originalSubtitleBackgroundAlpha)) subtitleBackground.alpha = originalSubtitleBackgroundAlpha;
				}
			}
		}

		cleanupSprites(ps);
		clearTracking();
	}

	function restoreScoreState(txt:FlxBitmapText) {
		if (txt == null) return;
		if (!Math.isNaN(originalScoreX)) txt.x = originalScoreX;
		if (!Math.isNaN(originalScoreY)) txt.y = originalScoreY;
		if (!Math.isNaN(originalScoreScaleX)) txt.scale.x = originalScoreScaleX;
		if (!Math.isNaN(originalScoreScaleY)) txt.scale.y = originalScoreScaleY;
		if (originalScoreAlignment != null) txt.alignment = originalScoreAlignment;
		if (originalScoreVisible != null) txt.visible = originalScoreVisible;
	}

	function clearTracking() {
		hudBuilt = false;
		trackedState = null;
		originalHealthBarVisible = null;
		originalHealthBarBGVisible = null;
		originalIconP1Visible = null;
		originalIconP1AutoUpdate = null;
		originalIconP1BopEvery = null;
		originalIconP1SizeX = Math.NaN;
		originalIconP1SizeY = Math.NaN;
		originalIconP2Visible = null;
		originalIconP2AutoUpdate = null;
		originalIconFlipX = null;
		originalScoreX = Math.NaN;
		originalScoreY = Math.NaN;
		originalScoreScaleX = Math.NaN;
		originalScoreScaleY = Math.NaN;
		originalScoreAlignment = null;
		originalScoreVisible = null;
		originalSubtitleOffsetX = Math.NaN;
		originalSubtitleOffsetY = Math.NaN;
		originalSubtitleAlignment = null;
		originalSubtitleBackgroundVisible = null;
		originalSubtitleBackgroundAlpha = Math.NaN;
		resetRuntimeCache();
	}

	function resetRuntimeCache() {
