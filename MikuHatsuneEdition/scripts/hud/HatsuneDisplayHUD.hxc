		lastSongLabelSize = -1;
		lastSongLabelBorderSize = Math.NaN;
		lastSongLabelScale = Math.NaN;
		lastSongLabelTextWidth = Math.NaN;
		lastSongLabelX = Math.NaN;
		lastSongLabelY = Math.NaN;
		songHudLabelFitCache = new StringMap();
		lastSongDifficultyId = null;
		lastSongDifficultyHeight = -1;
		lastSongDifficultyX = Math.NaN;
		lastSongDifficultyY = Math.NaN;
		lastScoreDigitsValue = null;
