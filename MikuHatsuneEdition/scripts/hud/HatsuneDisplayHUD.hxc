		MHE_SharedState.chanceTimeNormalBottomHudOffsetY = 0;
		MHE_SharedState.chanceTimeNormalTopHudOffsetY = 0;
		clearChanceHudTweens();
		pendingStateRefresh = false;
		hudMetaUpdateAccumulator = hudMetaUpdateInterval;
		hudDecorUpdateAccumulator = hudDecorUpdateInterval;
	}

	function updateSpriteWidth(sprite:FlxSprite, targetWidth:Int, cacheWidth:Int):Int {
		if (sprite == null) return cacheWidth;
		if (targetWidth != cacheWidth) {
			sprite.setGraphicSize(targetWidth, 0);
			sprite.updateHitbox();
			return targetWidth;
		}
		return cacheWidth;
	}

	function updateSpriteSquare(sprite:FlxSprite, targetSize:Int, cacheSize:Int):Int {
		if (sprite == null) return cacheSize;
		if (targetSize != cacheSize) {
			sprite.setGraphicSize(targetSize, 0);
			sprite.updateHitbox();
			return targetSize;
		}
		return cacheSize;
	}

	function getSpriteFrameWidth(sprite:FlxSprite):Int {
		if (sprite == null || sprite.frame == null) return 0;
		return Std.int(sprite.frame.frame.width);
	}

	function refreshBarSizing(force:Bool) {
		var nextScaleX = HatsuneHudLayout.BAR_SCALE_X;
		var nextScaleY = HatsuneHudLayout.BAR_SCALE_Y;
		var nextBorderThickness = HatsuneHudLayout.BAR_BORDER_THICKNESS;
		if (nextScaleX <= 0) nextScaleX = 1.0;
		if (nextScaleY <= 0) nextScaleY = 1.0;
		if (nextBorderThickness <= 0) nextBorderThickness = 1;

		if (!force && nextScaleX == barScaleX && nextScaleY == barScaleY && nextBorderThickness == borderThickness) return;

		barScaleX = nextScaleX;
		barScaleY = nextScaleY;
		borderThickness = nextBorderThickness;
		meterW = Std.int(baseMeterW * barScaleX);
		meterH = Std.int(baseMeterH * barScaleY);
		if (meterW < 1) meterW = 1;
		if (meterH < 1) meterH = 1;
		boxW = meterW + (borderThickness * 2);
		boxH = meterH + (borderThickness * 2);
		lastFillW = Math.NaN;

		if (hpBox != null) {
			hpBox.makeGraphic(boxW, boxH, FlxColor.TRANSPARENT);
			hpBox.origin.set(0, 0);
		}
		if (meterBack != null) {
			var backColor = meterBack.color;
			meterBack.makeGraphic(meterW, meterH, FlxColor.WHITE);
			meterBack.origin.set(0, 0);
			meterBack.color = backColor;
		}
		if (meter != null) {
			var fillColor = meter.color;
			meter.makeGraphic(1, meterH, FlxColor.WHITE);
			meter.origin.set(0, 0);
			meter.color = fillColor;
		}
		if (borderTop != null) {
			borderTop.makeGraphic(boxW, borderThickness, FlxColor.BLACK);
			borderTop.origin.set(0, 0);
		}
		if (borderBottom != null) {
			borderBottom.makeGraphic(boxW, borderThickness, FlxColor.BLACK);
			borderBottom.origin.set(0, 0);
		}
		if (borderLeft != null) {
			borderLeft.makeGraphic(borderThickness, meterH, FlxColor.BLACK);
			borderLeft.origin.set(0, 0);
		}
		if (borderRight != null) {
			borderRight.makeGraphic(borderThickness, meterH, FlxColor.BLACK);
			borderRight.origin.set(0, 0);
		}
	}

	function enforceIconState(ps) {
		if (ps.iconP1 == null) return;

		var icon = ps.iconP1;
		if (!icon.visible) icon.visible = true;
		if (icon.autoUpdate) icon.autoUpdate = false;
		if (icon.bopEvery != 0) icon.bopEvery = 0;
		if (icon.flipX) icon.flipX = false;
		updatePlayerIconVisualState(ps);
		var shouldReapplyBaseScale = false;

		if (iconBaseScale != HatsuneHudLayout.ICON_SCALE) {
			iconBaseScale = HatsuneHudLayout.ICON_SCALE;
			iconAnchorWidth = -1;
			iconFixedCenterX = -1.0;
			iconBaseWidth = -1;
			iconBaseHeight = -1;
			shouldReapplyBaseScale = true;
		}

		if (iconAnchorRight != HatsuneHudLayout.ICON_ANCHOR_RIGHT || iconAnchorBottom != HatsuneHudLayout.ICON_ANCHOR_BOTTOM || iconScreenX != HatsuneHudLayout.ICON_X
			|| iconMarginY != HatsuneHudLayout.ICON_MARGIN_Y || iconOffsetX != HatsuneHudLayout.ICON_OFFSET_X || iconOffsetY != HatsuneHudLayout.ICON_OFFSET_Y) {
			iconAnchorRight = HatsuneHudLayout.ICON_ANCHOR_RIGHT;
			iconAnchorBottom = HatsuneHudLayout.ICON_ANCHOR_BOTTOM;
			iconScreenX = HatsuneHudLayout.ICON_X;
			iconMarginY = HatsuneHudLayout.ICON_MARGIN_Y;
			iconOffsetX = HatsuneHudLayout.ICON_OFFSET_X;
			iconOffsetY = HatsuneHudLayout.ICON_OFFSET_Y;
			iconAnchorWidth = -1;
			iconFixedCenterX = -1.0;
		}

		if (iconBaseScale <= 0) iconBaseScale = 1.0;
		var iconSizeChanged = false;
		var needsScaleSync = false;
		if (icon.size != null && (Math.abs(icon.size.x - iconBaseScale) > 0.001 || Math.abs(icon.size.y - iconBaseScale) > 0.001)) {
			needsScaleSync = true;
		}
		if (icon.size != null && (shouldReapplyBaseScale || needsScaleSync)) {
			icon.size.set(iconBaseScale, iconBaseScale);
			if (icon.snapToTargetSize != null) icon.snapToTargetSize();
			iconSizeChanged = true;
		}

		if (icon.width > 0 && icon.height > 0 && (iconSizeChanged || iconBaseWidth <= 0 || iconBaseHeight <= 0)) icon.centerOrigin();
		if (icon.width > 0 && iconBaseWidth <= 0) iconBaseWidth = Std.int(icon.width);
		if (icon.height > 0 && iconBaseHeight <= 0) iconBaseHeight = Std.int(icon.height);
	}

	function positionPlayerIconAtCenter(icon, centerX:Float, centerY:Float) {
		if (icon == null) return;
		icon.x = centerX - (icon.width * 0.5);
		icon.y = centerY - (icon.height * 0.5);
		lastPlayerIconX = Math.NaN;
		lastPlayerIconY = Math.NaN;
	}

	function triggerPlayerIconBop(ps) {
		if (ps == null || ps.iconP1 == null || Conductor.instance == null) return;

		var icon = ps.iconP1;
		var bopEvery = (originalIconP1BopEvery != null && originalIconP1BopEvery > 0) ? originalIconP1BopEvery : 4;
		if (bopEvery == 0 || Conductor.instance.currentStep % bopEvery != 0) return;
		if (icon.width <= 0 || icon.height <= 0) return;

		var baseWidth = (iconBaseWidth > 0) ? iconBaseWidth : Std.int(icon.width);
		var baseHeight = (iconBaseHeight > 0) ? iconBaseHeight : Std.int(icon.height);
		if (baseWidth <= 0 || baseHeight <= 0) return;

		var centerX = icon.x + (icon.width * 0.5);
		var centerY = icon.y + (icon.height * 0.5);
		var bopMultiplier = 1.2;
		var targetWidth = Std.int(baseWidth * bopMultiplier);
		var targetHeight = Std.int(baseHeight * bopMultiplier);
		if (targetWidth < 1) targetWidth = 1;
		if (targetHeight < 1) targetHeight = 1;

		if (icon.bopTween != null) icon.bopTween.cancel();

		if (baseWidth >= baseHeight) {
			icon.setGraphicSize(targetWidth, 0);
		} else {
			icon.setGraphicSize(0, targetHeight);
		}
		icon.updateHitbox();
		icon.centerOrigin();
		positionPlayerIconAtCenter(icon, centerX, centerY);

		var tweenDuration = Math.min(Conductor.instance.stepLengthMs * 0.002, 0.175);
		icon.bopTween = FlxTween.num(1.0, 0.0, tweenDuration, {
			onComplete: function(_) {
				icon.bopTween = null;
			}
		}, function(value) {
				var currentWidth = Std.int(baseWidth + ((targetWidth - baseWidth) * value));
				var currentHeight = Std.int(baseHeight + ((targetHeight - baseHeight) * value));
				if (currentWidth < 1) currentWidth = 1;
				if (currentHeight < 1) currentHeight = 1;

				if (baseWidth >= baseHeight) {
					icon.setGraphicSize(currentWidth, 0);
				} else {
					icon.setGraphicSize(0, currentHeight);
				}
				icon.updateHitbox();
				icon.centerOrigin();
				positionPlayerIconAtCenter(icon, centerX, centerY);
			});

		icon.angle += icon.bopAngle;
	}

	function updatePlayerIconVisualState(ps):Void {
		if (ps == null || ps.iconP1 == null || ps.iconP1.playAnimation == null) return;

		var nextState = "idle";
		if (ps.health < 0.4) {
			nextState = "losing";
		} else if (ps.health > 1.6) {
			nextState = "winning";
		}

		if (lastPlayerIconVisualState == nextState) return;
		lastPlayerIconVisualState = nextState;
		ps.iconP1.playAnimation(nextState, "idle");
	}

	function layoutHud(ps, updateAux:Bool = true) {
		if (hpBox == null || meterBack == null || meter == null) return;
		refreshBarSizing(false);

		var layout = HatsuneHudLayout.getBarAnchor(barOffsetX, barOffsetY);
		var uiScale = layout.uiScale;
		var downscroll = layout.downscroll;
		var barX = layout.x;
		var yPos = layout.y + getHealthHudOffsetY();
		var chanceActive = isChanceHudActive();
		var chanceHudTweening = isChanceHudTweening();
		var screenW = FlxG.width;
		var screenH = FlxG.height;
		var hudLayoutDirty = chanceHudTweening
			|| lastHudLayoutBarX != barX
			|| lastHudLayoutYPos != yPos
			|| lastHudLayoutUiScale != uiScale
			|| lastHudLayoutChanceActive != chanceActive
			|| lastHudLayoutScreenW != screenW
			|| lastHudLayoutScreenH != screenH
			|| lastHudLayoutMeterW != meterW
			|| lastHudLayoutMeterH != meterH
			|| lastHudLayoutBorderThickness != borderThickness;

		if (hudLayoutDirty) {
			hpBox.x = barX - borderThickness;
			hpBox.y = yPos - borderThickness;

			meterBack.x = barX;
			meterBack.y = yPos;
			layoutDecorHud(barX, yPos, uiScale, downscroll);

			if (borderTop != null) {
				borderTop.x = barX - borderThickness;
				borderTop.y = yPos - borderThickness;
			}
			if (borderBottom != null) {
				borderBottom.x = barX - borderThickness;
				borderBottom.y = yPos + meterH;
			}
			if (borderLeft != null) {
				borderLeft.x = barX - borderThickness;
				borderLeft.y = yPos;
			}
			if (borderRight != null) {
				borderRight.x = barX + meterW;
				borderRight.y = yPos;
			}

			if (updateAux) {
				layoutLifeLabel(barX, yPos, uiScale);
				layoutLifeHudIcon(uiScale);
			}

			lastHudLayoutBarX = barX;
			lastHudLayoutYPos = yPos;
			lastHudLayoutUiScale = uiScale;
			lastHudLayoutChanceActive = chanceActive;
			lastHudLayoutScreenW = screenW;
			lastHudLayoutScreenH = screenH;
			lastHudLayoutMeterW = meterW;
			lastHudLayoutMeterH = meterH;
			lastHudLayoutBorderThickness = borderThickness;
		}
		if (ps.healthBar != null && ps.healthBar.visible) ps.healthBar.visible = false;
		if (ps.healthBarBG != null && ps.healthBarBG.visible) ps.healthBarBG.visible = false;

		var ratio = Math.max(0, Math.min(1, ps.health / 2));
		var fillW = Math.max(1, meterW * ratio);
		if (hudLayoutDirty) meter.setPosition(barX, yPos);
		if (fillW != lastFillW) {
			meter.scale.x = fillW;
			lastFillW = fillW;
		}

		if (updateAux) {
			updateProtectedText(yPos);
			layoutIcon(ps, yPos);
		}
	}

	function updateChanceStarMeter(uiScale:Float) {
		if (!isChanceHudLayoutActive()) {
			setSpriteVisible(chanceStarMeter, false);
			setSpriteVisible(chanceStarMeterStroke, false);
			return;
		}

		var ps = PlayState.instance;
		if (chanceStarMeter == null || chanceStarMeterStroke == null) ensureChanceTimeMeterBuilt(ps);
		if (chanceStarMeter == null) return;

		var meterFrameName = getChanceTimeMeterFrameName();
		if (lastChanceStarMeterFrameName != meterFrameName) {
			applyChanceTimeMeterFrame(chanceStarMeter, meterFrameName, false);
			lastChanceStarMeterFrameName = meterFrameName;
			lastChanceStarMeterWidth = -1;
		}

		var meterScale = HatsuneHudLayout.CT_STAR_METER_SCALE;
		if (meterScale <= 0) meterScale = 0.075;
		var meterFrameWidth = getSpriteFrameWidth(chanceStarMeter);
		var targetWidth = Std.int(meterFrameWidth * meterScale);
		if (targetWidth < 1) targetWidth = 1;
		lastChanceStarMeterWidth = updateSpriteWidth(chanceStarMeter, targetWidth, lastChanceStarMeterWidth);
		var downscroll = HatsuneHudLayout.isDownscroll();
		chanceStarMeter.flipY = downscroll;

		var anchorX = HatsuneHudLayout.CT_STAR_METER_X;
		var anchorY = FlxG.height - chanceStarMeter.height - HatsuneHudLayout.CT_STAR_METER_MARGIN_Y;
		if (chanceBottomHudArt != null) {
			anchorX = chanceBottomHudArt.x + HatsuneHudLayout.CT_STAR_METER_X;
			anchorY = chanceBottomHudArt.y + chanceBottomHudArt.height - chanceStarMeter.height - HatsuneHudLayout.CT_STAR_METER_MARGIN_Y;
		}

		var targetMeterX = Std.int(anchorX + (HatsuneHudLayout.CT_STAR_METER_OFFSET_X * uiScale));
		var targetMeterY = Std.int(anchorY + (HatsuneHudLayout.CT_STAR_METER_OFFSET_Y * uiScale));
		if (lastChanceStarMeterX != targetMeterX) {
			chanceStarMeter.x = targetMeterX;
			lastChanceStarMeterX = targetMeterX;
		}
		if (lastChanceStarMeterY != targetMeterY) {
			chanceStarMeter.y = targetMeterY;
			lastChanceStarMeterY = targetMeterY;
		}
		lastChanceStarMeterUiScale = uiScale;

		if (chanceStarMeterStroke != null) {
			var strokeFrameWidth = getSpriteFrameWidth(chanceStarMeterStroke);
			var strokeTargetWidth = Std.int(strokeFrameWidth * meterScale);
			if (strokeTargetWidth < 1) strokeTargetWidth = 1;
			lastChanceStarMeterStrokeWidth = updateSpriteWidth(chanceStarMeterStroke, strokeTargetWidth, lastChanceStarMeterStrokeWidth);
			chanceStarMeterStroke.flipY = downscroll;
			if (chanceStarMeterStroke.x != chanceStarMeter.x) chanceStarMeterStroke.x = chanceStarMeter.x;
			if (chanceStarMeterStroke.y != chanceStarMeter.y) chanceStarMeterStroke.y = chanceStarMeter.y;
		}
	}

	function layoutLifeLabel(barX:Float, yPos:Float, uiScale:Float) {
		if (lifeLabel == null) return;

		var showLabel = HatsuneHudLayout.LIFE_LABEL_SHOW;
		if (lifeLabel.visible != showLabel) lifeLabel.visible = showLabel;
		if (!showLabel) return;

		var labelSize = HatsuneHudLayout.LIFE_LABEL_SIZE;
		var labelScale = HatsuneHudLayout.LIFE_LABEL_SCALE;
		var labelGap = HatsuneHudLayout.LIFE_LABEL_GAP;
		var labelOffsetX = HatsuneHudLayout.LIFE_LABEL_OFFSET_X;
		var labelOffsetY = HatsuneHudLayout.LIFE_LABEL_OFFSET_Y;
		var labelBorderSize = HatsuneHudLayout.LIFE_LABEL_BORDER_SIZE;
		if (labelSize <= 0) labelSize = 18;
		if (labelScale <= 0) labelScale = 1.0;
		if (labelGap < 0) labelGap = 0;
		if (labelBorderSize < 0) labelBorderSize = 0;

		var lifeLabelMetricsDirty = false;
		if (lastLifeLabelSize != labelSize) {
			lifeLabel.size = labelSize;
			lastLifeLabelSize = labelSize;
			lifeLabelMetricsDirty = true;
		}
		if (lastLifeLabelBorderSize != labelBorderSize) {
			lifeLabel.borderSize = labelBorderSize;
			lastLifeLabelBorderSize = labelBorderSize;
			lifeLabelMetricsDirty = true;
		}
		if (lastLifeLabelScale != labelScale) {
			lifeLabel.scale.set(labelScale, labelScale);
			lastLifeLabelScale = labelScale;
			lifeLabelMetricsDirty = true;
		}
		if (lifeLabel.text != "LIFE") {
			lifeLabel.text = "LIFE";
			lifeLabelMetricsDirty = true;
		}
		if (lifeLabelMetricsDirty) lifeLabel.updateHitbox();
		var downscroll = HatsuneHudLayout.isDownscroll();
		var labelDownscrollOffsetX = downscroll ? (HatsuneHudLayout.LIFE_LABEL_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var labelDownscrollOffsetY = downscroll ? (HatsuneHudLayout.LIFE_LABEL_DOWNSCROLL_OFFSET_Y * uiScale) : 0;

		lifeLabel.x = Std.int(barX - lifeLabel.width - (labelGap * uiScale) + (labelOffsetX * uiScale) + labelDownscrollOffsetX);
		lifeLabel.y = Std.int(yPos + ((meterH - lifeLabel.height) * 0.5) + (labelOffsetY * uiScale) + labelDownscrollOffsetY);
	}

	function layoutLifeHudIcon(uiScale:Float) {
		if (lifeHudIcon == null) return;

		var showIcon = HatsuneHudLayout.LIFE_ICON_SHOW;
		if (lifeHudIcon.visible != showIcon) lifeHudIcon.visible = showIcon;
		if (!showIcon) return;

		var iconScale = HatsuneHudLayout.LIFE_ICON_SCALE;
		var iconGap = HatsuneHudLayout.LIFE_ICON_GAP;
		var iconOffsetX = HatsuneHudLayout.LIFE_ICON_OFFSET_X;
		var iconOffsetY = HatsuneHudLayout.LIFE_ICON_OFFSET_Y;
		if (iconScale <= 0) iconScale = 1.0;
		if (iconGap < 0) iconGap = 0;

		var iconFrameWidth = getSpriteFrameWidth(lifeHudIcon);
		var targetWidth = Std.int(iconFrameWidth * iconScale);
		lastLifeHudIconWidth = updateSpriteWidth(lifeHudIcon, targetWidth, lastLifeHudIconWidth);
		var downscroll = HatsuneHudLayout.isDownscroll();
		var iconDownscrollOffsetX = downscroll ? (HatsuneHudLayout.LIFE_ICON_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var iconDownscrollOffsetY = downscroll ? (HatsuneHudLayout.LIFE_ICON_DOWNSCROLL_OFFSET_Y * uiScale) : 0;

		var anchorX = (lifeLabel != null && lifeLabel.visible) ? lifeLabel.x : meterBack.x;
		var anchorY = (lifeLabel != null && lifeLabel.visible) ? lifeLabel.y + ((lifeLabel.height - lifeHudIcon.height) * 0.5) : meterBack.y + ((meterH - lifeHudIcon.height) * 0.5);
		lifeHudIcon.x = Std.int(anchorX - lifeHudIcon.width - (iconGap * uiScale) + (iconOffsetX * uiScale) + iconDownscrollOffsetX);
		lifeHudIcon.y = Std.int(anchorY + (iconOffsetY * uiScale) + iconDownscrollOffsetY);
	}

	function syncVanillaHealthBar(ps, iconTargetX:Float, iconTargetY:Float) {
		if (ps == null || ps.healthBar == null || ps.iconP1 == null) return;

		var vanillaPositionOffset = 26;
		var iconRatio = 1 - (ps.healthBar.value / 2);
		var derivedBarX = iconTargetX - (ps.healthBar.width * iconRatio - vanillaPositionOffset);
		var derivedBarY = iconTargetY + (ps.iconP1.height * 0.5);

		if (lastVanillaHealthBarX != derivedBarX) {
			ps.healthBar.x = derivedBarX;
			lastVanillaHealthBarX = derivedBarX;
		}
		if (lastVanillaHealthBarY != derivedBarY) {
			ps.healthBar.y = derivedBarY;
			lastVanillaHealthBarY = derivedBarY;
		}
		if (ps.healthBar.visible) ps.healthBar.visible = false;

		if (ps.healthBarBG != null) {
			var derivedBgX = derivedBarX - borderThickness;
			var derivedBgY = derivedBarY - borderThickness;
			if (lastVanillaHealthBarBgX != derivedBgX) {
				ps.healthBarBG.x = derivedBgX;
				lastVanillaHealthBarBgX = derivedBgX;
			}
			if (lastVanillaHealthBarBgY != derivedBgY) {
				ps.healthBarBG.y = derivedBgY;
				lastVanillaHealthBarBgY = derivedBgY;
			}
			if (ps.healthBarBG.visible) ps.healthBarBG.visible = false;
		}
	}

	function layoutDecorHud(meterX:Float, yPos:Float, uiScale:Float, downscroll:Bool) {
		var screenW = FlxG.width;
		var screenH = FlxG.height;
		var bottomHudBaseY = screenH - HatsuneHudLayout.BOTTOM_HUD_MARGIN_Y + (HatsuneHudLayout.BOTTOM_HUD_OFFSET_Y * uiScale);
		var healthHudMarginY = HatsuneHudLayout.HEALTH_HUD_MARGIN_Y + (HatsuneHudLayout.HEALTH_HUD_OFFSET_Y * uiScale);
		var bottomHudDownscrollOffsetX = HatsuneHudLayout.BOTTOM_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var bottomHudDownscrollOffsetY = HatsuneHudLayout.BOTTOM_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var healthHudDownscrollOffsetX = HatsuneHudLayout.HEALTH_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var healthHudDownscrollOffsetY = HatsuneHudLayout.HEALTH_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var chanceBottomHudDownscrollOffsetX = HatsuneHudLayout.CT_BOTTOM_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var chanceBottomHudDownscrollOffsetY = HatsuneHudLayout.CT_BOTTOM_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var chanceLayoutActive = isChanceHudLayoutActive();

		if (healthHudArt != null) {
			var healthFrameWidth = getSpriteFrameWidth(healthHudArt);
			var healthScale = HatsuneHudLayout.HEALTH_HUD_SCALE;
			if (healthScale <= 0) healthScale = 1.0;
			var targetHealthWidth = Std.int(healthFrameWidth * healthScale);
			lastHealthHudWidth = updateSpriteWidth(healthHudArt, targetHealthWidth, lastHealthHudWidth);
			if (healthHudArt.flipY) healthHudArt.flipY = false;
			var healthHudMarginX = HatsuneHudLayout.HEALTH_HUD_X + (HatsuneHudLayout.HEALTH_HUD_OFFSET_X * uiScale);
			var healthHudOffsetY = getHealthHudOffsetY();
			healthHudArt.x = HatsuneHudLayout.HEALTH_HUD_ANCHOR_RIGHT
				? Std.int(screenW - healthHudArt.width - healthHudMarginX)
				: Std.int(healthHudMarginX);
			if (downscroll) {
				healthHudArt.x += healthHudDownscrollOffsetX;
				healthHudArt.y = Std.int(healthHudMarginY + healthHudOffsetY + healthHudDownscrollOffsetY);
			} else {
				healthHudArt.y = HatsuneHudLayout.HEALTH_HUD_ANCHOR_BOTTOM
					? Std.int(screenH - healthHudArt.height - healthHudMarginY + healthHudOffsetY)
					: Std.int(healthHudMarginY + healthHudOffsetY);
			}
		}

		if (playerHudArt != null) {
			var playerFrameWidth = getSpriteFrameWidth(playerHudArt);
			var bottomScale = HatsuneHudLayout.BOTTOM_HUD_SCALE;
			if (bottomScale <= 0) bottomScale = 1.0;
			var targetHudWidth = Std.int(playerFrameWidth * bottomScale);
			lastPlayerHudWidth = updateSpriteWidth(playerHudArt, targetHudWidth, lastPlayerHudWidth);
			if (playerHudArt.flipY) playerHudArt.flipY = false;
			playerHudArt.x = Std.int(HatsuneHudLayout.BOTTOM_HUD_X + (HatsuneHudLayout.BOTTOM_HUD_OFFSET_X * uiScale) + (downscroll ? bottomHudDownscrollOffsetX : 0));
			playerHudArt.y = downscroll
				? Std.int(HatsuneHudLayout.BOTTOM_HUD_MARGIN_Y + (HatsuneHudLayout.BOTTOM_HUD_OFFSET_Y * uiScale) + normalBottomOffsetY + bottomHudDownscrollOffsetY)
				: Std.int(bottomHudBaseY - playerHudArt.height + normalBottomOffsetY);
		}

		if (chanceBottomHudArt != null && chanceLayoutActive) {
			var chanceBottomFrameWidth = getSpriteFrameWidth(chanceBottomHudArt);
			var chanceBottomScale = HatsuneHudLayout.CT_BOTTOM_HUD_SCALE;
			if (chanceBottomScale <= 0) chanceBottomScale = 1.0;
			var targetChanceBottomWidth = Std.int(chanceBottomFrameWidth * chanceBottomScale);
			lastChanceBottomHudWidth = updateSpriteWidth(chanceBottomHudArt, targetChanceBottomWidth, lastChanceBottomHudWidth);
			if (chanceBottomHudArt.flipY) chanceBottomHudArt.flipY = false;
			chanceBottomHudArt.x = Std.int(HatsuneHudLayout.CT_BOTTOM_HUD_X + (HatsuneHudLayout.CT_BOTTOM_HUD_OFFSET_X * uiScale) + (downscroll ? chanceBottomHudDownscrollOffsetX : 0));
			chanceBottomHudArt.y = downscroll
				? Std.int((HatsuneHudLayout.CT_BOTTOM_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_BOTTOM_HUD_OFFSET_Y * uiScale) + chanceBottomOffsetY + chanceBottomHudDownscrollOffsetY)
				: Std.int(screenH - (HatsuneHudLayout.CT_BOTTOM_HUD_MARGIN_Y * uiScale) - chanceBottomHudArt.height + (HatsuneHudLayout.CT_BOTTOM_HUD_OFFSET_Y * uiScale) + chanceBottomOffsetY);
			layoutChanceHudExtRow(
				chanceBottomHudArt,
				chanceBottomHudLeftExt,
				chanceBottomHudRightExt,
				HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME,
				chanceBottomScale,
				HatsuneHudLayout.CT_BOTTOM_HUD_EX_OFFSET_Y * uiScale,
				downscroll,
				PlayState.instance != null ? PlayState.instance.camHUD : null,
				true,
				HatsuneHudLayout.CT_BOTTOM_HUD_EX_OVERLAP * uiScale
			);
		} else {
			layoutChanceHudExtRow(null, chanceBottomHudLeftExt, chanceBottomHudRightExt, HatsuneHudLayout.CT_BOTTOM_HUD_EX_FRAME, 1.0, 0, downscroll, PlayState.instance != null ? PlayState.instance.camHUD : null, true, 0);
		}

		if (playerHudArt != null && healthHudArt != null) {
			hpBox.x = playerHudArt.x;
			hpBox.y = playerHudArt.y;
			if (hpBox.visible) hpBox.visible = false;
		}

		if (lastDecorDownscroll != downscroll) {
			refreshDecorFrames(false);
			if (scoreHudArt != null && scoreHudArt.flipY) scoreHudArt.flipY = false;
			if (songHudIcon != null && songHudIcon.flipY) songHudIcon.flipY = false;
			if (chanceTopHudArt != null && chanceTopHudArt.flipY) chanceTopHudArt.flipY = false;
			if (chanceSongHudIcon != null && chanceSongHudIcon.flipY) chanceSongHudIcon.flipY = false;
			lastDecorDownscroll = downscroll;
		}
	}

	function updateProtectedText(yPos:Float) {
		if (protectedText == null) return;

		var drainActive:Bool = MHE_SharedState.drainActive;
		if (lastDrainActive != drainActive) {
			protectedText.visible = drainActive;
			lastDrainActive = drainActive;
		}

		if (!drainActive) return;

		var uiScale = HatsuneHudLayout.getUiScale();
		var protectedTextSize = HatsuneHudLayout.PROTECTED_TEXT_SIZE;
		var protectedTextScale = HatsuneHudLayout.PROTECTED_TEXT_SCALE;
		var protectedTextBorderSize = HatsuneHudLayout.PROTECTED_TEXT_BORDER_SIZE;
		if (protectedTextSize <= 0) protectedTextSize = 14;
		if (protectedTextScale <= 0) protectedTextScale = 1.0;
		if (protectedTextBorderSize < 0) protectedTextBorderSize = 0;

		var protectedTextMetricsDirty = false;
		if (lastProtectedTextSize != protectedTextSize) {
			protectedText.size = protectedTextSize;
			lastProtectedTextSize = protectedTextSize;
			protectedTextMetricsDirty = true;
		}
		if (lastProtectedTextBorderSize != protectedTextBorderSize) {
			protectedText.borderSize = protectedTextBorderSize;
			lastProtectedTextBorderSize = protectedTextBorderSize;
			protectedTextMetricsDirty = true;
		}
		if (lastProtectedTextScale != protectedTextScale) {
			protectedText.scale.set(protectedTextScale, protectedTextScale);
			lastProtectedTextScale = protectedTextScale;
			protectedTextMetricsDirty = true;
		}

		protectedText.width = meterW;
		if (protectedText.text != "PROTECTED") {
			protectedText.text = "PROTECTED";
			protectedTextMetricsDirty = true;
		}
		if (protectedTextMetricsDirty) protectedText.updateHitbox();
		var downscroll = HatsuneHudLayout.isDownscroll();
		var protectedDownscrollOffsetX = downscroll ? (HatsuneHudLayout.PROTECTED_TEXT_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var protectedDownscrollOffsetY = downscroll ? (HatsuneHudLayout.PROTECTED_TEXT_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		protectedText.x = ((healthHudArt != null) ? healthHudArt.x : baseX + barOffsetX) + (HatsuneHudLayout.PROTECTED_TEXT_X_NUDGE * uiScale) + protectedDownscrollOffsetX;
		protectedText.width = (healthHudArt != null) ? healthHudArt.width : meterW;
		protectedText.y = yPos + ((meterH - protectedText.height) * 0.5) + (HatsuneHudLayout.PROTECTED_TEXT_Y_NUDGE * uiScale) + protectedDownscrollOffsetY;
	}

	function layoutIcon(ps, yPos:Float) {
		if (ps.iconP1 == null) return;

		var icon = ps.iconP1;
		var uiScale = HatsuneHudLayout.getUiScale();
		var downscroll = HatsuneHudLayout.isDownscroll();
		var iconDownscrollOffsetX = downscroll ? (HatsuneHudLayout.ICON_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var iconDownscrollOffsetY = downscroll ? (HatsuneHudLayout.ICON_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		var targetIconX = 0.0;
		var targetIconY = 0.0;
		var useBarAnchor = (meterBack != null);
		var anchorWidth = (iconBaseWidth > 0) ? iconBaseWidth : icon.width;
		var anchorHeight = (iconBaseHeight > 0) ? iconBaseHeight : icon.height;

		if (useBarAnchor) {
			var baselineIconX = 15.0;
			var baselineIconMarginY = 630.0;
			var marginNudgeX = (iconScreenX - baselineIconX) * uiScale;
			var marginNudgeY = (iconMarginY - baselineIconMarginY) * uiScale;
			var barAnchorX = meterBack.x - (anchorWidth * 0.82);
			var barAnchorY = yPos + ((meterH - anchorHeight) * 0.5) - (anchorHeight * 0.18);
			targetIconX = barAnchorX + marginNudgeX + (iconOffsetX * uiScale) + iconDownscrollOffsetX + ((anchorWidth - icon.width) * 0.5);
			targetIconY = barAnchorY + marginNudgeY + (iconOffsetY * uiScale) + HatsuneHudLayout.ICON_FINAL_Y_SHIFT + iconDownscrollOffsetY
				+ ((anchorHeight - icon.height) * 0.5);
		} else {
			var iconMarginX = iconScreenX + (iconOffsetX * uiScale);
			var anchorLeft = iconAnchorRight ? (FlxG.width - anchorWidth - iconMarginX) : iconMarginX;
			targetIconX = anchorLeft + ((anchorWidth - icon.width) * 0.5);

			var iconMarginBottom = iconMarginY + (iconOffsetY * uiScale);
			var anchorTop = iconAnchorBottom ? (FlxG.height - anchorHeight - iconMarginBottom) : iconMarginBottom;
			targetIconY = anchorTop + ((anchorHeight - icon.height) * 0.5);
			targetIconY += downscroll ? normalBottomOffsetY : normalTopOffsetY;
			targetIconX += iconDownscrollOffsetX;
			targetIconY += HatsuneHudLayout.ICON_FINAL_Y_SHIFT + iconDownscrollOffsetY;
		}

		if (lastPlayerIconX != targetIconX) {
			icon.x = targetIconX;
			lastPlayerIconX = targetIconX;
		}
		if (lastPlayerIconY != targetIconY) {
			icon.y = targetIconY;
			lastPlayerIconY = targetIconY;
		}
		syncVanillaHealthBar(ps, targetIconX, targetIconY);
		if (icon.zIndex != HatsuneHudLayout.PLAYER_ICON_Z) icon.zIndex = HatsuneHudLayout.PLAYER_ICON_Z;
		if (icon.cameras == null || icon.cameras.length != 1 || icon.cameras[0] != ps.camHUD) icon.cameras = [ps.camHUD];
	}

	function applyScoreLayout(txt:FlxBitmapText, force:Bool) {
		if (txt == null) return;
		if (!txt.visible) return;

		if (txt.scale.x != scoreScaleMultiplier || txt.scale.y != scoreScaleMultiplier) {
			txt.scale.x = scoreScaleMultiplier;
			txt.scale.y = scoreScaleMultiplier;
			force = true;
		}

		var screenW = FlxG.width;
		var screenH = FlxG.height;
		var down = HatsuneHudLayout.isDownscroll();
		var textW = txt.width;
		var textH = txt.height;

		if (force || screenW != lastScoreScreenW || textW != lastScoreWidth) {
			if (scoreAnchorHorizontal == "LEFT") {
				txt.x = scoreMarginLeft;
				if (txt.alignment != "left") txt.alignment = "left";
			} else {
				var newX = screenW - textW - scoreMarginRight;
				if (newX < scoreMarginLeft) newX = scoreMarginLeft;
				txt.x = newX;
				if (txt.alignment != "right") txt.alignment = "right";
			}
		}

		if (force || down != lastDownscroll || screenH != lastScoreScreenH || textH != lastScoreHeight) {
			txt.y = down ? (screenH - textH - scoreMarginBottom) : scoreMarginTop;
		}

		lastScoreScreenW = screenW;
		lastScoreScreenH = screenH;
		lastScoreWidth = textW;
		lastScoreHeight = textH;
		lastDownscroll = down;
	}

	function layoutScoreHud(txt:FlxBitmapText) {
		if (txt == null) return;

		var uiScale = HatsuneHudLayout.getUiScale();
		var downscroll = HatsuneHudLayout.isDownscroll();
		var chanceActive = isChanceHudActive();
		var chanceHudTweening = isChanceHudTweening();
		var chanceLayoutActive = chanceActive || chanceHudTweening;
		var topHudDownscrollOffsetX = HatsuneHudLayout.TOP_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var topHudDownscrollOffsetY = HatsuneHudLayout.TOP_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var chanceScoreHudDownscrollOffsetX = HatsuneHudLayout.CT_SCORE_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var chanceScoreHudDownscrollOffsetY = HatsuneHudLayout.CT_SCORE_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var chanceTopHudDownscrollOffsetX = HatsuneHudLayout.CT_TOP_HUD_DOWNSCROLL_OFFSET_X * uiScale;
		var chanceTopHudDownscrollOffsetY = HatsuneHudLayout.CT_TOP_HUD_DOWNSCROLL_OFFSET_Y * uiScale;
		var topHudLayoutDirty = chanceHudTweening
			|| lastTopHudLayoutUiScale != uiScale
			|| lastTopHudLayoutDownscroll != downscroll
			|| lastTopHudLayoutChanceActive != chanceActive
			|| lastTopHudLayoutScreenW != FlxG.width
			|| lastTopHudLayoutScreenH != FlxG.height
			|| lastTopHudLayoutNormalTopOffsetY != normalTopOffsetY
			|| lastTopHudLayoutChanceTopOffsetY != chanceTopOffsetY;

		if (topHudLayoutDirty && scoreHudArt != null) {
			var scoreFrameWidth = getSpriteFrameWidth(scoreHudArt);
			var scoreScale = HatsuneHudLayout.TOP_HUD_SCALE;
			if (scoreScale <= 0) scoreScale = 1.0;
			var targetWidth = Std.int(scoreFrameWidth * scoreScale);
			lastScoreHudWidth = updateSpriteWidth(scoreHudArt, targetWidth, lastScoreHudWidth);

			var scoreHudMarginX = HatsuneHudLayout.TOP_HUD_X + (HatsuneHudLayout.TOP_HUD_OFFSET_X * uiScale);
			scoreHudArt.x = HatsuneHudLayout.TOP_HUD_ANCHOR_RIGHT
				? Std.int(FlxG.width - scoreHudArt.width - scoreHudMarginX)
				: Std.int(scoreHudMarginX);
			if (downscroll) scoreHudArt.x += topHudDownscrollOffsetX;
			scoreHudArt.y = downscroll
				? Std.int(FlxG.height - scoreHudArt.height - (HatsuneHudLayout.TOP_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.TOP_HUD_OFFSET_Y * uiScale) + normalTopOffsetY + topHudDownscrollOffsetY)
				: Std.int(HatsuneHudLayout.TOP_HUD_MARGIN_Y + (HatsuneHudLayout.TOP_HUD_OFFSET_Y * uiScale) + normalTopOffsetY);
		}

		if (topHudLayoutDirty && chanceScoreHudArt != null && chanceLayoutActive) {
			var chanceScoreFrameWidth = getSpriteFrameWidth(chanceScoreHudArt);
			var chanceScoreScale = HatsuneHudLayout.CT_SCORE_HUD_SCALE;
			if (chanceScoreScale <= 0) chanceScoreScale = 1.0;
			var targetChanceScoreWidth = Std.int(chanceScoreFrameWidth * chanceScoreScale);
			lastChanceScoreHudWidth = updateSpriteWidth(chanceScoreHudArt, targetChanceScoreWidth, lastChanceScoreHudWidth);
			var chanceScoreMarginX = HatsuneHudLayout.CT_SCORE_HUD_X + (HatsuneHudLayout.CT_SCORE_HUD_OFFSET_X * uiScale);
			chanceScoreHudArt.x = HatsuneHudLayout.CT_SCORE_HUD_ANCHOR_RIGHT
				? Std.int(FlxG.width - chanceScoreHudArt.width - chanceScoreMarginX)
				: Std.int(chanceScoreMarginX);
			if (downscroll) chanceScoreHudArt.x += chanceScoreHudDownscrollOffsetX;
			chanceScoreHudArt.y = downscroll
				? Std.int(FlxG.height - chanceScoreHudArt.height - (HatsuneHudLayout.CT_SCORE_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_SCORE_HUD_OFFSET_Y * uiScale) + chanceTopOffsetY + chanceScoreHudDownscrollOffsetY)
				: Std.int((HatsuneHudLayout.CT_SCORE_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_SCORE_HUD_OFFSET_Y * uiScale) + chanceTopOffsetY);
		}

		if (topHudLayoutDirty && chanceTopHudArt != null && chanceLayoutActive) {
			var chanceTopFrameWidth = getSpriteFrameWidth(chanceTopHudArt);
			var chanceTopScale = HatsuneHudLayout.CT_TOP_HUD_SCALE;
			if (chanceTopScale <= 0) chanceTopScale = 1.0;
			var targetChanceTopWidth = Std.int(chanceTopFrameWidth * chanceTopScale);
			lastChanceTopHudWidth = updateSpriteWidth(chanceTopHudArt, targetChanceTopWidth, lastChanceTopHudWidth);
			chanceTopHudArt.x = Std.int(HatsuneHudLayout.CT_TOP_HUD_X + (HatsuneHudLayout.CT_TOP_HUD_OFFSET_X * uiScale) + (downscroll ? chanceTopHudDownscrollOffsetX : 0));
			chanceTopHudArt.y = downscroll
				? Std.int(FlxG.height - chanceTopHudArt.height - (HatsuneHudLayout.CT_TOP_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_TOP_HUD_OFFSET_Y * uiScale) + chanceTopOffsetY + chanceTopHudDownscrollOffsetY)
				: Std.int((HatsuneHudLayout.CT_TOP_HUD_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_TOP_HUD_OFFSET_Y * uiScale) + chanceTopOffsetY);
			layoutChanceHudExtRow(
				chanceTopHudArt,
				chanceTopHudLeftExt,
				chanceTopHudRightExt,
				HatsuneHudLayout.CT_TOP_HUD_EX_FRAME,
				chanceTopScale,
				HatsuneHudLayout.CT_TOP_HUD_EX_OFFSET_Y * uiScale,
				downscroll,
				PlayState.instance != null ? PlayState.instance.camHUD : null,
				false,
				HatsuneHudLayout.CT_TOP_HUD_EX_OVERLAP * uiScale
			);
		} else if (topHudLayoutDirty) {
			layoutChanceHudExtRow(null, chanceTopHudLeftExt, chanceTopHudRightExt, HatsuneHudLayout.CT_TOP_HUD_EX_FRAME, 1.0, 0, downscroll, PlayState.instance != null ? PlayState.instance.camHUD : null, false, 0);
		}

		if (topHudLayoutDirty) {
			layoutSongIcon(downscroll, uiScale);
			lastTopHudLayoutUiScale = uiScale;
			lastTopHudLayoutDownscroll = downscroll;
			lastTopHudLayoutChanceActive = chanceActive;
			lastTopHudLayoutScreenW = FlxG.width;
			lastTopHudLayoutScreenH = FlxG.height;
			lastTopHudLayoutNormalTopOffsetY = normalTopOffsetY;
			lastTopHudLayoutChanceTopOffsetY = chanceTopOffsetY;
		}

		var activeScoreHudArt = getActiveScoreHudArt();
		if (activeScoreHudArt == null) return;

		if (topHudLayoutDirty) {
			var rightInset = Std.int(HatsuneHudLayout.SCORE_HUD_RIGHT_INSET * uiScale);
			txt.x = Std.int((activeScoreHudArt.x + activeScoreHudArt.width) - txt.width - rightInset);
			txt.y = Std.int(activeScoreHudArt.y + (activeScoreHudArt.height - txt.height) * 0.5 - (HatsuneHudLayout.SCORE_HUD_Y_OFFSET * uiScale));
		}
	}

	function syncVanillaScoreText(txt:FlxBitmapText) {
		if (txt == null) return;
		if (txt.visible) txt.visible = false;
	}

	function formatScoreDigits(scoreValue:Int, digitCount:Int):String {
		if (digitCount <= 0) digitCount = 7;

		var isNegative = (scoreValue < 0);
		var absValue = isNegative ? -scoreValue : scoreValue;
		if (absValue < 0) absValue = 0;

		var formatted = Std.string(absValue);
		var digitsOnlyCount = isNegative ? (digitCount - 1) : digitCount;
		if (digitsOnlyCount < 1) digitsOnlyCount = 1;
		while (formatted.length < digitsOnlyCount) formatted = "0" + formatted;
		if (formatted.length > digitsOnlyCount) formatted = formatted.substr(formatted.length - digitsOnlyCount, digitsOnlyCount);
		if (isNegative) formatted = "-" + formatted;
		return formatted;
	}

	function updateScoreDigits(ps, uiScale:Float) {
		var activeScoreHudArt = getActiveScoreHudArt();
		if (activeScoreHudArt == null || scoreDigits == null || scoreDigits.length <= 0) return;
		var baseScoreHudScale = HatsuneHudLayout.TOP_HUD_SCALE;
		if (baseScoreHudScale <= 0) baseScoreHudScale = 1.0;
		var activeScoreHudScale = getActiveScoreHudScale();
		var activeScoreHudScaleRatio = activeScoreHudScale / baseScoreHudScale;
		if (activeScoreHudScaleRatio <= 0) activeScoreHudScaleRatio = 1.0;
		var drainActive:Bool = MHE_SharedState.drainActive;
		var desiredAtlasKey = drainActive ? vpScoreDigitsAtlasKey : defaultScoreDigitsAtlasKey;
		if (desiredAtlasKey == null || desiredAtlasKey == "") desiredAtlasKey = defaultScoreDigitsAtlasKey;
		var atlasChanged = false;
		if (scoreDigitsAtlasKey != desiredAtlasKey) {
			scoreDigitsAtlasKey = desiredAtlasKey;
			restoreScoreDigitsState(ps);
			if (scoreDigitsAtlasKey == vpScoreDigitsAtlasKey && !vpScoreDigitAnimationsReady) ensureAllScoreDigitAnimations();
			lastScoreDigitsValue = null;
			lastScoreDigitsHeight = -1;
			lastScoreDigitsUiScale = Math.NaN;
			lastScoreDigitsScaleRatio = Math.NaN;
			lastScoreDigitsPanelX = Math.NaN;
			lastScoreDigitsPanelY = Math.NaN;
			lastScoreDigitsPanelW = Math.NaN;
			lastScoreDigitsPanelH = Math.NaN;
			lastScoreDigitChars = [];
			lastScoreDigitSymbolHeights = [];
			scoreDigitsAnimAccumulator = 0;
			scoreDigitsVisualDirty = true;
			atlasChanged = true;
		}
		if (scoreDigitsAtlasKey == vpScoreDigitsAtlasKey && !vpScoreDigitAnimationsReady) ensureAllScoreDigitAnimations();
		if (scoreDigitsAtlasFrames == null) reloadScoreDigitsAtlas();
		if (scoreDigitsAtlasFrames == null) return;

		var digitCount = scoreDigits.length;
		var sourceScoreValue = (ps != null) ? ps.songScore : 0;
		if (sourceScoreValue != lastScoreDigitsSourceValue) scoreDigitsVisualDirty = true;
		var scoreValue = sourceScoreValue;
		var scoreAnimStep = 1.0 / 24.0;
		var panelX = activeScoreHudArt.x;
		var panelY = activeScoreHudArt.y;
		var panelW = activeScoreHudArt.width;
		var panelH = activeScoreHudArt.height;
		var targetHeight = Std.int(HatsuneHudLayout.SCORE_DIGITS_HEIGHT * uiScale * activeScoreHudScaleRatio);
		var digitGap = HatsuneHudLayout.SCORE_DIGITS_GAP * uiScale * activeScoreHudScaleRatio;
		var rightInset = HatsuneHudLayout.SCORE_DIGITS_RIGHT_INSET * uiScale * activeScoreHudScaleRatio;
		var offsetX = HatsuneHudLayout.SCORE_DIGITS_OFFSET_X * uiScale * activeScoreHudScaleRatio;
		var offsetY = HatsuneHudLayout.SCORE_DIGITS_OFFSET_Y * uiScale * activeScoreHudScaleRatio;
		var vpHeightMultiplier = HatsuneHudLayout.SCORE_DIGITS_VP_HEIGHT_MULTIPLIER;
		var minusHeightMultiplier = HatsuneHudLayout.SCORE_MINUS_HEIGHT_MULTIPLIER;
		if (targetHeight <= 0) targetHeight = Std.int(28 * uiScale);
		if (digitGap < 0) digitGap = 0;
		if (vpHeightMultiplier <= 0) vpHeightMultiplier = 1.0;
		if (minusHeightMultiplier <= 0) minusHeightMultiplier = 0.3;
		if (scoreDigitMaxFrameWidth <= 0 || scoreDigitMaxFrameHeight <= 0) reloadScoreDigitsAtlas();
		if (scoreDigitMaxFrameWidth <= 0 || scoreDigitMaxFrameHeight <= 0) return;
		ensureScoreDigitsLayoutReference();

		var slotSourceWidth = (scoreDigitsLayoutReferenceWidth > 0) ? scoreDigitsLayoutReferenceWidth : scoreDigitMaxFrameWidth;
		var slotSourceHeight = (scoreDigitsLayoutReferenceHeight > 0) ? scoreDigitsLayoutReferenceHeight : scoreDigitMaxFrameHeight;
		var slotWidth = (slotSourceHeight > 0) ? ((slotSourceWidth * targetHeight) / slotSourceHeight) : 0.0;
		if (slotWidth <= 0) slotWidth = targetHeight;
		var layoutChanged = atlasChanged || targetHeight != lastScoreDigitsHeight || uiScale != lastScoreDigitsUiScale || activeScoreHudScaleRatio != lastScoreDigitsScaleRatio
			|| panelX != lastScoreDigitsPanelX || panelY != lastScoreDigitsPanelY || panelW != lastScoreDigitsPanelW || panelH != lastScoreDigitsPanelH;

		scoreDigitsAnimAccumulator += FlxG.elapsed;
		var shouldRefreshVisuals = layoutChanged || lastScoreDigitsValue == null || (scoreDigitsVisualDirty && scoreDigitsAnimAccumulator >= scoreAnimStep);
		if (!shouldRefreshVisuals) return;

		scoreDigitsAnimAccumulator = 0;
		var scoreTextValue = formatScoreDigits(scoreValue, digitCount);
		if (!layoutChanged && scoreTextValue == lastScoreDigitsValue) return;
		var totalWidth = (digitCount * slotWidth) + ((digitCount - 1) * digitGap);
		var badgeReservedWidth = 0.0;
		if (HatsuneHudLayout.SCORE_DIGITS_RESERVE_BADGE_SPACE && scoreRankBadge != null && scoreRankBadge.visible) {
			var badgeGap = HatsuneHudLayout.SCORE_RANK_BADGE_GAP * uiScale;
			if (badgeGap < 0) badgeGap = 0;
			badgeReservedWidth = scoreRankBadge.width + badgeGap;
		}
		var startX = (activeScoreHudArt.x + activeScoreHudArt.width) - rightInset - badgeReservedWidth - totalWidth + offsetX;

		var rebuiltMissingDigit = false;
		for (i in 0...digitCount) {
			var digitSprite = scoreDigits[i];
			if (digitSprite == null) continue;

			var digitChar = scoreTextValue.substr(i, 1);
			var previousDigitChar = (lastScoreDigitChars != null && lastScoreDigitChars.length > i) ? lastScoreDigitChars[i] : null;
			var frameName = (digitChar == "-") ? "MINUS" : ("digital " + digitChar);
			var symbolTargetHeight = (digitChar == "-") ? Std.int(targetHeight * minusHeightMultiplier) : targetHeight;
			if (digitChar != "-" && isVpScoreDigitsAtlas()) symbolTargetHeight = Std.int(symbolTargetHeight * vpHeightMultiplier);
			if (symbolTargetHeight <= 0) symbolTargetHeight = 1;
			var previousSymbolTargetHeight = (lastScoreDigitSymbolHeights != null && lastScoreDigitSymbolHeights.length > i) ? lastScoreDigitSymbolHeights[i] : -1;
			var digitFrameChanged = atlasChanged || previousDigitChar != digitChar;
			if (digitFrameChanged && !applyScoreDigitFrame(digitSprite, frameName, false)) {
				if (!rebuiltMissingDigit && ps != null) {
					rebuiltMissingDigit = true;
					rebuildScoreDigitSprites(ps);
					if (scoreDigits != null && scoreDigits.length > i) digitSprite = scoreDigits[i];
				}
				if (digitSprite == null) continue;
				if (!applyScoreDigitFrame(digitSprite, frameName, true)) {
					digitSprite.visible = false;
					continue;
				}
				digitFrameChanged = true;
			}
			if (digitChar != "-" && isVpScoreDigitsAtlas() && previousDigitChar != digitChar && digitSprite.animation != null && digitSprite.animation.getByName(frameName) != null) {
				digitSprite.animation.play(frameName, true, false, 0);
			}

			if (digitFrameChanged || previousSymbolTargetHeight != symbolTargetHeight) {
				digitSprite.setGraphicSize(0, symbolTargetHeight);
				digitSprite.updateHitbox();
			}
			digitSprite.visible = true;
			var slotX = startX + (i * (slotWidth + digitGap));
			digitSprite.x = Std.int(slotX + ((slotWidth - digitSprite.width) * 0.5));
			digitSprite.y = Std.int(activeScoreHudArt.y + ((activeScoreHudArt.height - digitSprite.height) * 0.5) + offsetY);
			lastScoreDigitChars[i] = digitChar;
			lastScoreDigitSymbolHeights[i] = symbolTargetHeight;
		}

		lastScoreDigitsValue = scoreTextValue;
		lastScoreDigitsSourceValue = sourceScoreValue;
		scoreDigitsVisualDirty = false;
		lastScoreDigitsHeight = targetHeight;
		lastScoreDigitsUiScale = uiScale;
		lastScoreDigitsScaleRatio = activeScoreHudScaleRatio;
		lastScoreDigitsPanelX = panelX;
		lastScoreDigitsPanelY = panelY;
		lastScoreDigitsPanelW = panelW;
		lastScoreDigitsPanelH = panelH;
	}

	function didScoreRankStateChange(ps):Bool {
		if (ps == null) return !hasScoreRankSnapshot;

		if (!hasScoreRankSnapshot) return true;
		if (lastScoreRankTallySick != Highscore.tallies.sick) return true;
		if (lastScoreRankTallyGood != Highscore.tallies.good) return true;
		if (lastScoreRankTallyBad != Highscore.tallies.bad) return true;
		if (lastScoreRankTallyShit != Highscore.tallies.shit) return true;
		if (lastScoreRankTallyMissed != Highscore.tallies.missed) return true;
		return false;
	}

	function cacheScoreRankState(ps) {
		if (ps == null) {
			hasScoreRankSnapshot = false;
			return;
		}

		lastScoreRankTallySick = Highscore.tallies.sick;
		lastScoreRankTallyGood = Highscore.tallies.good;
		lastScoreRankTallyBad = Highscore.tallies.bad;
		lastScoreRankTallyShit = Highscore.tallies.shit;
		lastScoreRankTallyMissed = Highscore.tallies.missed;
		hasScoreRankSnapshot = true;
	}

	function updateScoreRankBadge(ps, uiScale:Float) {
		var activeScoreHudArt = getActiveScoreHudArt();
		var rankUpdateStep = 1.0 / 30.0;
		if (scoreRankBadge == null || activeScoreHudArt == null) return;
		if (isChanceHudActive()) {
			scoreRankBadge.visible = false;
			stopScoreRankSparkle();
			lastScoreRankBadgeAnim = null;
			lastScoreRankBadgePanelX = Math.NaN;
			lastScoreRankBadgePanelY = Math.NaN;
			lastScoreRankBadgePanelW = Math.NaN;
			lastScoreRankBadgePanelH = Math.NaN;
			hasScoreRankSnapshot = false;
			scoreRankUpdateAccumulator = 0;
			scoreRankVisualDirty = false;
			return;
		}

		var showBadge = HatsuneHudLayout.SCORE_RANK_BADGE_SHOW;
		scoreRankBadge.visible = showBadge;
		if (!showBadge || ps == null) {
			lastScoreRankBadgeAnim = null;
			lastScoreRankBadgePanelX = Math.NaN;
			lastScoreRankBadgePanelY = Math.NaN;
			lastScoreRankBadgePanelW = Math.NaN;
			lastScoreRankBadgePanelH = Math.NaN;
			hasScoreRankSnapshot = false;
			scoreRankUpdateAccumulator = 0;
			scoreRankVisualDirty = false;
			return;
		}

		var scoreRankStateChanged = didScoreRankStateChange(ps);
		if (scoreRankStateChanged) {
			cacheScoreRankState(ps);
			scoreRankVisualDirty = true;
		}
		scoreRankUpdateAccumulator += FlxG.elapsed;
		var rankAnim = lastScoreRankBadgeAnim;
		if ((scoreRankVisualDirty && (scoreRankUpdateAccumulator >= rankUpdateStep || rankAnim == null || rankAnim == "")) || rankAnim == null || rankAnim == "") {
			var currentRank = getCurrentScoreRank(ps);
			rankAnim = getScoreRankBadgeAnim(currentRank);
			scoreRankUpdateAccumulator = 0;
			scoreRankVisualDirty = false;
		}
		if (rankAnim == null || rankAnim == "") {
			scoreRankBadge.visible = false;
			stopScoreRankSparkle();
			lastScoreRankBadgeAnim = null;
			lastScoreRankBadgePanelX = Math.NaN;
			lastScoreRankBadgePanelY = Math.NaN;
			lastScoreRankBadgePanelW = Math.NaN;
			lastScoreRankBadgePanelH = Math.NaN;
			return;
		}

		if (lastScoreRankBadgeAnim != rankAnim) {
			if (scoreRankBadge.animation.getByName(rankAnim) != null) {
				scoreRankBadge.animation.play(rankAnim, true, false, 0);
			} else {
				applyScoreRankBadgeFrame(scoreRankBadge, rankAnim);
			}
			updateScoreRankSparkleState(rankAnim);
			lastScoreRankBadgeAnim = rankAnim;
			lastScoreRankBadgeHeight = -1;
		}

		var targetHeight = Std.int(HatsuneHudLayout.SCORE_RANK_BADGE_HEIGHT * uiScale);
		if (targetHeight < 1) targetHeight = 1;
		var panelChanged = activeScoreHudArt.x != lastScoreRankBadgePanelX || activeScoreHudArt.y != lastScoreRankBadgePanelY || activeScoreHudArt.width != lastScoreRankBadgePanelW
			|| activeScoreHudArt.height != lastScoreRankBadgePanelH;
		if (targetHeight != lastScoreRankBadgeHeight) {
			scoreRankBadge.setGraphicSize(0, targetHeight);
			scoreRankBadge.updateHitbox();
			lastScoreRankBadgeHeight = targetHeight;
			panelChanged = true;
		}
		if (!panelChanged && lastScoreRankBadgeAnim == rankAnim && scoreRankBadge.visible) return;

		var rightInset = HatsuneHudLayout.SCORE_RANK_BADGE_RIGHT_INSET * uiScale;
		var offsetX = (HatsuneHudLayout.SCORE_RANK_BADGE_OFFSET_X + getScoreRankBadgeOffsetX(rankAnim)) * uiScale;
		var offsetY = (HatsuneHudLayout.SCORE_RANK_BADGE_OFFSET_Y + getScoreRankBadgeOffsetY(rankAnim)) * uiScale;
		scoreRankBadge.x = Std.int((activeScoreHudArt.x + activeScoreHudArt.width) - scoreRankBadge.width - rightInset + offsetX);
		scoreRankBadge.y = Std.int(activeScoreHudArt.y + ((activeScoreHudArt.height - scoreRankBadge.height) * 0.5) + offsetY);
		scoreRankBadge.visible = true;
		lastScoreRankBadgePanelX = activeScoreHudArt.x;
		lastScoreRankBadgePanelY = activeScoreHudArt.y;
		lastScoreRankBadgePanelW = activeScoreHudArt.width;
		lastScoreRankBadgePanelH = activeScoreHudArt.height;
		refreshScoreRankSparkleTransform();
	}

	function getScoreRankBadgeOffsetX(rankAnim:String):Float {
		if (rankAnim == null) return 0;
		switch (rankAnim) {
			case "LOSS":
				return HatsuneHudLayout.SCORE_RANK_BADGE_LOSS_OFFSET_X;
			case "GOOD":
				return HatsuneHudLayout.SCORE_RANK_BADGE_GOOD_OFFSET_X;
			case "GREAT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_GREAT_OFFSET_X;
			case "EXCELLENT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_EXCELLENT_OFFSET_X;
			case "PERFECT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_PERFECT_OFFSET_X;
			case "PERFECT_GOLD":
				return HatsuneHudLayout.SCORE_RANK_BADGE_PERFECT_GOLD_OFFSET_X;
			default:
				return 0;
		}
	}

	function getScoreRankBadgeOffsetY(rankAnim:String):Float {
		if (rankAnim == null) return 0;
		switch (rankAnim) {
			case "LOSS":
				return HatsuneHudLayout.SCORE_RANK_BADGE_LOSS_OFFSET_Y;
			case "GOOD":
				return HatsuneHudLayout.SCORE_RANK_BADGE_GOOD_OFFSET_Y;
			case "GREAT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_GREAT_OFFSET_Y;
			case "EXCELLENT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_EXCELLENT_OFFSET_Y;
			case "PERFECT":
				return HatsuneHudLayout.SCORE_RANK_BADGE_PERFECT_OFFSET_Y;
			case "PERFECT_GOLD":
				return HatsuneHudLayout.SCORE_RANK_BADGE_PERFECT_GOLD_OFFSET_Y;
			default:
				return 0;
		}
	}

	function applyScoreRankBadgeFrame(sprite:FlxSprite, rankAnim:String) {
		if (sprite == null || rankAnim == null || rankAnim == "") return;

		var resolvedFrameName = scoreRankBadgeResolvedFrameNames.get(rankAnim);
		if (resolvedFrameName == null || resolvedFrameName == "") return;

		var selectedFrame = scoreRankBadgeFrameCache.get(resolvedFrameName);
		if (selectedFrame == null) return;

		sprite.frame = selectedFrame;
		sprite.visible = true;
		sprite.updateHitbox();
	}

	function getCurrentScoreRank(ps) {
		if (ps == null) return null;

		var judgedTotal = Highscore.tallies.sick + Highscore.tallies.good + Highscore.tallies.bad + Highscore.tallies.shit + Highscore.tallies.missed;
		if (judgedTotal <= 0) return null;
		var totalNotesHit = Highscore.tallies.sick + Highscore.tallies.good + Highscore.tallies.bad + Highscore.tallies.shit;

		return Scoring.calculateRank({
			score: ps.songScore,
			tallies: {
				sick: Highscore.tallies.sick,
				good: Highscore.tallies.good,
				bad: Highscore.tallies.bad,
				shit: Highscore.tallies.shit,
				missed: Highscore.tallies.missed,
				combo: Highscore.tallies.combo,
				maxCombo: Highscore.tallies.maxCombo,
				totalNotesHit: totalNotesHit,
				totalNotes: judgedTotal,
			}
		});
	}

	function getScoreRankBadgeAnim(rank):String {
		if (rank == null) return null;

		var rankAsset = null;
		if (rank != null && rank.getFreeplayRankIconAsset != null) {
			rankAsset = rank.getFreeplayRankIconAsset();
		}
		if (rankAsset == null || rankAsset == "") rankAsset = Std.string(rank);

		if (rankAsset == "PERFECTSICK" || rankAsset == "PERFECT_GOLD") return "PERFECT_GOLD";
		if (rankAsset == "PERFECT") return "PERFECT";
		if (rankAsset == "EXCELLENT") return "EXCELLENT";
		if (rankAsset == "GREAT") return "GREAT";
		if (rankAsset == "GOOD") return "GOOD";
		if (rankAsset == "LOSS" || rankAsset == "SHIT") return "LOSS";
		return null;
	}

	function layoutSongIcon(downscroll:Bool, uiScale:Float) {
		var chanceLayoutActive = isChanceHudLayoutActive();
		var songIconDownscrollOffsetX = downscroll ? (HatsuneHudLayout.SONG_ICON_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var songIconDownscrollOffsetY = downscroll ? (HatsuneHudLayout.SONG_ICON_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		var chanceSongIconDownscrollOffsetX = downscroll ? (HatsuneHudLayout.CT_SONG_ICON_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var chanceSongIconDownscrollOffsetY = downscroll ? (HatsuneHudLayout.CT_SONG_ICON_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		if (songHudIcon != null) {
			var songFrameWidth = getSpriteFrameWidth(songHudIcon);
			var songScale = HatsuneHudLayout.SONG_ICON_SCALE;
			if (songScale <= 0) songScale = 1.0;
			var targetSize = Std.int(songFrameWidth * songScale);
			lastSongIconSize = updateSpriteSquare(songHudIcon, targetSize, lastSongIconSize);
			songHudIcon.x = Std.int((HatsuneHudLayout.SONG_ICON_X * uiScale) + (HatsuneHudLayout.SONG_ICON_OFFSET_X * uiScale) + songIconDownscrollOffsetX);
			if (downscroll && scoreHudArt != null) {
				songHudIcon.y = Std.int(scoreHudArt.y + ((scoreHudArt.height - songHudIcon.height) * 0.5) + (HatsuneHudLayout.SONG_ICON_OFFSET_Y * uiScale) + songIconDownscrollOffsetY);
			} else {
				songHudIcon.y = downscroll
					? Std.int(FlxG.height - songHudIcon.height - (HatsuneHudLayout.SONG_ICON_MARGIN_Y * uiScale) + (HatsuneHudLayout.SONG_ICON_OFFSET_Y * uiScale) + normalTopOffsetY + songIconDownscrollOffsetY)
					: Std.int((HatsuneHudLayout.SONG_ICON_MARGIN_Y * uiScale) + 4 + (HatsuneHudLayout.SONG_ICON_OFFSET_Y * uiScale) + normalTopOffsetY);
			}
		}

		if (chanceSongHudIcon != null && chanceLayoutActive) {
			var chanceSongFrameWidth = getSpriteFrameWidth(chanceSongHudIcon);
			var chanceSongScale = HatsuneHudLayout.CT_SONG_ICON_SCALE;
			if (chanceSongScale <= 0) chanceSongScale = 1.0;
			var targetChanceSize = Std.int(chanceSongFrameWidth * chanceSongScale);
			lastChanceSongIconSize = updateSpriteSquare(chanceSongHudIcon, targetChanceSize, lastChanceSongIconSize);
			chanceSongHudIcon.x = Std.int((HatsuneHudLayout.CT_SONG_ICON_X * uiScale) + (HatsuneHudLayout.CT_SONG_ICON_OFFSET_X * uiScale) + chanceSongIconDownscrollOffsetX);
			if (downscroll && chanceScoreHudArt != null) {
				chanceSongHudIcon.y = Std.int(chanceScoreHudArt.y + ((chanceScoreHudArt.height - chanceSongHudIcon.height) * 0.5) + (HatsuneHudLayout.CT_SONG_ICON_OFFSET_Y * uiScale) + chanceSongIconDownscrollOffsetY);
			} else {
				chanceSongHudIcon.y = downscroll
					? Std.int(FlxG.height - chanceSongHudIcon.height - (HatsuneHudLayout.CT_SONG_ICON_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_SONG_ICON_OFFSET_Y * uiScale) + chanceTopOffsetY + chanceSongIconDownscrollOffsetY)
					: Std.int((HatsuneHudLayout.CT_SONG_ICON_MARGIN_Y * uiScale) + (HatsuneHudLayout.CT_SONG_ICON_OFFSET_Y * uiScale) + chanceTopOffsetY);
			}
		}
	}

	function updateSongHudLabel(ps, downscroll:Bool, uiScale:Float) {
		if (songHudLabel == null || ps == null) return;

		var chanceLayoutActive = isChanceHudLayoutActive();
		var songLabelSourceText = chanceLayoutActive ? getSongHudLabelDisplayName(ps) : getSongHudLabel(ps);
		if (songLabelSourceText == null || songLabelSourceText == "") songLabelSourceText = "UNKNOWN";

		var labelSize = HatsuneHudLayout.SONG_LABEL_SIZE;
		var labelScale = HatsuneHudLayout.SONG_LABEL_SCALE;
		var labelBorderSize = HatsuneHudLayout.SONG_LABEL_BORDER_SIZE;
		var labelMaxWidth = HatsuneHudLayout.SONG_LABEL_MAX_WIDTH;
		var labelRightInset = HatsuneHudLayout.SONG_LABEL_RIGHT_INSET;
		var difficultyGap = HatsuneHudLayout.SONG_LABEL_DIFFICULTY_GAP;
		var labelScrollEnabled = HatsuneHudLayout.SONG_LABEL_SCROLL_ENABLED;
		var preferStaticLongLabel = HatsuneHudLayout.SONG_LABEL_SHOW_ID;
		var labelScrollSpeed = HatsuneHudLayout.SONG_LABEL_SCROLL_SPEED;
		var labelScrollStartDelay = HatsuneHudLayout.SONG_LABEL_SCROLL_START_DELAY;
		var labelScrollEndDelay = HatsuneHudLayout.SONG_LABEL_SCROLL_END_DELAY;
		var labelDownscrollOffsetX = downscroll ? (HatsuneHudLayout.SONG_LABEL_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var labelDownscrollOffsetY = downscroll ? (HatsuneHudLayout.SONG_LABEL_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		if (chanceLayoutActive) {
			labelScrollEnabled = false;
			preferStaticLongLabel = false;
		}
		if (labelSize <= 0) labelSize = 18;
		if (labelScale <= 0) labelScale = 1.0;
		if (labelBorderSize < 0) labelBorderSize = 0;
		if (labelMaxWidth <= 0) labelMaxWidth = 300;
		if (labelRightInset < 0) labelRightInset = 0;
		if (difficultyGap < 0) difficultyGap = 0;
		if (labelScrollSpeed < 0) labelScrollSpeed = 0;
		if (labelScrollStartDelay < 0) labelScrollStartDelay = 0;
		if (labelScrollEndDelay < 0) labelScrollEndDelay = 0;

		var songHudLabelMetricsDirty = false;
		if (lastSongLabelSize != labelSize) {
			songHudLabel.size = labelSize;
			lastSongLabelSize = labelSize;
			songHudLabelMetricsDirty = true;
		}
		if (lastSongLabelBorderSize != labelBorderSize) {
			songHudLabel.borderSize = labelBorderSize;
			lastSongLabelBorderSize = labelBorderSize;
			songHudLabelMetricsDirty = true;
		}
		if (lastSongLabelScale != labelScale) {
			songHudLabel.scale.set(labelScale, labelScale);
			lastSongLabelScale = labelScale;
			songHudLabelMetricsDirty = true;
		}
		if (songHudLabel.fieldWidth != 0) songHudLabel.fieldWidth = 0;
		if (songHudLabelMeasure != null) {
			if (songHudLabelMeasure.size != labelSize) songHudLabelMeasure.size = labelSize;
			if (songHudLabelMeasure.borderSize != labelBorderSize) songHudLabelMeasure.borderSize = labelBorderSize;
			if (songHudLabelMeasure.scale.x != labelScale || songHudLabelMeasure.scale.y != labelScale) songHudLabelMeasure.scale.set(labelScale, labelScale);
			if (songHudLabelMeasure.fieldWidth != 0) songHudLabelMeasure.fieldWidth = 0;
		}
		if (songHudLabelMetricsDirty) {
			songHudLabel.updateHitbox();
			if (songHudLabelMeasure != null) songHudLabelMeasure.updateHitbox();
			songHudLabelFitCache = new StringMap();
			lastSongLabelTextWidth = Math.NaN;
		}

		var baseX = HatsuneHudLayout.SONG_LABEL_X + (HatsuneHudLayout.SONG_LABEL_OFFSET_X * uiScale) + labelDownscrollOffsetX;
		var baseY = downscroll
			? (FlxG.height - songHudLabel.height - (HatsuneHudLayout.SONG_LABEL_MARGIN_Y * uiScale) + (HatsuneHudLayout.SONG_LABEL_OFFSET_Y * uiScale) + labelDownscrollOffsetY)
			: ((HatsuneHudLayout.SONG_LABEL_MARGIN_Y * uiScale) + (HatsuneHudLayout.SONG_LABEL_OFFSET_Y * uiScale));

		var activeSongIcon = chanceLayoutActive ? chanceSongHudIcon : songHudIcon;
		if (activeSongIcon != null) {
			baseX = activeSongIcon.x + activeSongIcon.width + (HatsuneHudLayout.SONG_LABEL_OFFSET_X * uiScale);
			baseY = activeSongIcon.y + ((activeSongIcon.height - songHudLabel.height) * 0.5) + (HatsuneHudLayout.SONG_LABEL_OFFSET_Y * uiScale) + labelDownscrollOffsetY;
		} else if (downscroll) {
			var activeScoreHudArt = getActiveScoreHudArt();
			if (activeScoreHudArt != null) baseY = activeScoreHudArt.y + ((activeScoreHudArt.height - songHudLabel.height) * 0.5) + (HatsuneHudLayout.SONG_LABEL_OFFSET_Y * uiScale) + labelDownscrollOffsetY;
		}

		updateSongHudDifficulty(ps, uiScale, !chanceLayoutActive);

		var visibleWidth = labelMaxWidth;
		if (chanceLayoutActive) {
			visibleWidth = measureSongHudLabelWidth(songLabelSourceText) * labelScale;
		} else {
			var activeScoreHudArt = getActiveScoreHudArt();
			if (activeScoreHudArt != null) {
				var panelRight = (activeScoreHudArt.x + activeScoreHudArt.width) - (labelRightInset * uiScale);
				if (songHudDifficulty != null && songHudDifficulty.visible) {
					panelRight -= songHudDifficulty.width + (difficultyGap * uiScale);
				}
				var availableWidth = panelRight - baseX;
				if (availableWidth < visibleWidth) visibleWidth = availableWidth;
			}
			if (visibleWidth <= 0) visibleWidth = labelMaxWidth;
		}

		var sourceLabelWidth = measureSongHudLabelWidth(songLabelSourceText) * labelScale;
		if (!chanceLayoutActive && sourceLabelWidth > visibleWidth) {
			labelScrollEnabled = false;
			preferStaticLongLabel = true;
		}

		var songLabelText = songLabelSourceText;
		if (preferStaticLongLabel) {
			labelScrollEnabled = false;
			if (lastSongLabelSourceValue != songLabelSourceText || lastSongLabelSourceVisibleWidth != visibleWidth || lastSongLabelSourceScale != labelScale) {
				songLabelText = fitSongHudLabelText(songLabelSourceText, visibleWidth, labelScale);
				lastSongLabelSourceValue = songLabelSourceText;
				lastSongLabelSourceVisibleWidth = visibleWidth;
				lastSongLabelSourceScale = labelScale;
			} else if (lastSongLabelValue != null) {
				songLabelText = lastSongLabelValue;
			}
		} else {
			lastSongLabelSourceValue = songLabelSourceText;
			lastSongLabelSourceVisibleWidth = visibleWidth;
			lastSongLabelSourceScale = labelScale;
		}
		if (chanceLayoutActive) {
			songLabelText = songLabelSourceText;
			lastSongLabelSourceValue = songLabelSourceText;
			lastSongLabelSourceVisibleWidth = visibleWidth;
			lastSongLabelSourceScale = labelScale;
		}

		if (lastSongLabelValue != songLabelText) {
			songHudLabel.text = songLabelText;
			lastSongLabelValue = songLabelText;
			lastSongLabelTextWidth = Math.NaN;
			resetSongHudLabelScroll(labelScrollStartDelay);
			songHudLabelMetricsDirty = true;
		}
		if (songHudLabelMetricsDirty) {
			songHudLabel.updateHitbox();
			lastSongLabelTextWidth = Math.NaN;
		}

		var textWidth = getSongHudLabelTextWidth();
		var textDisplayWidth = textWidth * labelScale;
		lastSongLabelVisibleWidth = (textDisplayWidth < visibleWidth) ? textDisplayWidth : visibleWidth;

		updateSongHudLabelScroll(visibleWidth, labelScale, labelScrollEnabled, labelScrollSpeed, labelScrollStartDelay, labelScrollEndDelay, textWidth);

		var targetLabelX = Std.int(baseX);
		var targetLabelY = Std.int(baseY);
		if (lastSongLabelX != targetLabelX) {
			songHudLabel.x = targetLabelX;
			lastSongLabelX = targetLabelX;
		}
		if (lastSongLabelY != targetLabelY) {
			songHudLabel.y = targetLabelY;
			lastSongLabelY = targetLabelY;
		}
		layoutSongHudDifficulty(uiScale, baseY, difficultyGap);
	}

	function updateSongHudDifficulty(ps, uiScale:Float, allowVisible:Bool) {
		if (songHudDifficulty == null || ps == null) return;
		if (!allowVisible) {
			songHudDifficulty.visible = false;
			return;
		}

		if (!HatsuneHudLayout.SONG_LABEL_DIFFICULTY_SHOW) {
			songHudDifficulty.visible = false;
			return;
		}

		var difficultyId = normalizeSongHudDifficultyId(ps.currentDifficulty);
		if (difficultyId == null || difficultyId == "") {
			songHudDifficulty.visible = false;
			return;
		}

		if (lastSongDifficultyId != difficultyId) {
			songHudDifficulty.loadGraphic(Paths.image('storymenu/difficulties/' + difficultyId));
			lastSongDifficultyId = difficultyId;
			lastSongDifficultyHeight = -1;
		}

		var targetHeight = Std.int(HatsuneHudLayout.SONG_LABEL_DIFFICULTY_HEIGHT * uiScale);
		if (targetHeight < 1) targetHeight = 1;
		if (targetHeight != lastSongDifficultyHeight) {
			songHudDifficulty.setGraphicSize(0, targetHeight);
			songHudDifficulty.updateHitbox();
			lastSongDifficultyHeight = targetHeight;
		}

		songHudDifficulty.visible = true;
	}

	function layoutSongHudDifficulty(uiScale:Float, labelY:Float, difficultyGap:Float) {
		if (songHudDifficulty == null || !songHudDifficulty.visible) return;
		var downscroll = HatsuneHudLayout.isDownscroll();

		var badgeBaseX = HatsuneHudLayout.SONG_LABEL_DIFFICULTY_X;
		var offsetX = HatsuneHudLayout.SONG_LABEL_DIFFICULTY_OFFSET_X;
		var offsetY = HatsuneHudLayout.SONG_LABEL_DIFFICULTY_OFFSET_Y;
		var badgeX = (badgeBaseX * uiScale);
		badgeX += (offsetX * uiScale);
		if (downscroll) badgeX += HatsuneHudLayout.SONG_LABEL_DIFFICULTY_DOWNSCROLL_OFFSET_X * uiScale;

		var targetDifficultyX = Std.int(badgeX);
		var targetDifficultyY = Std.int(labelY + ((songHudLabel.height - songHudDifficulty.height) * 0.5) + (offsetY * uiScale)
			+ (downscroll ? (HatsuneHudLayout.SONG_LABEL_DIFFICULTY_DOWNSCROLL_OFFSET_Y * uiScale) : 0));
		if (lastSongDifficultyX != targetDifficultyX) {
			songHudDifficulty.x = targetDifficultyX;
			lastSongDifficultyX = targetDifficultyX;
		}
		if (lastSongDifficultyY != targetDifficultyY) {
			songHudDifficulty.y = targetDifficultyY;
			lastSongDifficultyY = targetDifficultyY;
		}
	}

	function normalizeSongHudDifficultyId(difficultyId:String):String {
		if (difficultyId == null || difficultyId == "") return "normal";

		var normalized = difficultyId.toLowerCase();
		if (normalized.indexOf("easy") == 0) return "easy";
		if (normalized.indexOf("hard") == 0) return "hard";
		if (normalized == "erect" || normalized == "nightmare") return "hard";
		return "normal";
	}

	function updateSongHudLabelScroll(labelMaxWidth:Float, labelScale:Float, labelScrollEnabled:Bool, labelScrollSpeed:Float, labelScrollStartDelay:Float,
		labelScrollEndDelay:Float, textWidthLocal:Float) {
		if (songHudLabel == null) return;
		var labelScrollStep = 1.0 / 60.0;

		var scaleX = (labelScale != 0) ? labelScale : 1.0;
		var visibleWidthLocal = labelMaxWidth / scaleX;
		if (visibleWidthLocal <= 0) visibleWidthLocal = textWidthLocal;

		var overflow = textWidthLocal - visibleWidthLocal;
		if (!labelScrollEnabled || labelScrollSpeed <= 0 || overflow <= 0) {
			songHudLabelScrollAccumulator = 0;
			resetSongHudLabelClip();
			return;
		}

		songHudLabelScrollAccumulator += FlxG.elapsed;
		if (songHudLabelScrollAccumulator < labelScrollStep) return;
		var scrollDelta = songHudLabelScrollAccumulator;
		songHudLabelScrollAccumulator = 0;

		if (songHudLabelScrollDelay > 0) {
			songHudLabelScrollDelay -= scrollDelta;
			if (songHudLabelScrollDelay < 0) songHudLabelScrollDelay = 0;
		} else {
			songHudLabelScrollOffset += songHudLabelScrollDirection * labelScrollSpeed * scrollDelta;
			if (songHudLabelScrollOffset >= overflow) {
				songHudLabelScrollOffset = overflow;
				songHudLabelScrollDirection = -1;
				songHudLabelScrollDelay = labelScrollEndDelay;
			} else if (songHudLabelScrollOffset <= 0) {
				songHudLabelScrollOffset = 0;
				songHudLabelScrollDirection = 1;
				songHudLabelScrollDelay = labelScrollStartDelay;
			}
		}

		if (songHudLabel.offset.x != songHudLabelScrollOffset) songHudLabel.offset.x = songHudLabelScrollOffset;
		if (songHudLabelClipRect == null) songHudLabelClipRect = new FlxRect();
		if (songHudLabelClipRect.x != songHudLabelScrollOffset) songHudLabelClipRect.x = songHudLabelScrollOffset;
		if (songHudLabelClipRect.y != 0) songHudLabelClipRect.y = 0;
		if (songHudLabelClipRect.width != visibleWidthLocal) songHudLabelClipRect.width = visibleWidthLocal;
		var clipHeight = getSongHudLabelClipHeight();
		if (songHudLabelClipRect.height != clipHeight) songHudLabelClipRect.height = clipHeight;
		if (songHudLabel.clipRect != songHudLabelClipRect) songHudLabel.clipRect = songHudLabelClipRect;
	}

	function resetSongHudLabelScroll(startDelay:Float) {
		songHudLabelScrollOffset = 0;
		songHudLabelScrollDirection = 1;
		songHudLabelScrollDelay = startDelay;
		resetSongHudLabelClip();
	}

	function resetSongHudLabelClip() {
		if (songHudLabel == null) return;
		if (songHudLabel.offset.x != 0) songHudLabel.offset.x = 0;
		if (songHudLabel.clipRect != null) songHudLabel.clipRect = null;
	}

	function fitSongHudLabelText(sourceText:String, maxVisibleWidth:Float, labelScale:Float):String {
		if (songHudLabel == null || sourceText == null || sourceText == "") return sourceText;
		if (labelScale <= 0) labelScale = 1.0;

		var maxLocalWidth = maxVisibleWidth / labelScale;
		if (maxLocalWidth <= 0) return sourceText;
		var cacheKey = sourceText + "|" + Std.int(maxLocalWidth * 100) + "|" + Std.int(labelScale * 1000);
		var cachedValue = songHudLabelFitCache.get(cacheKey);
		if (cachedValue != null) return cachedValue;

		var sourceWidth = measureSongHudLabelWidth(sourceText);
		if (sourceWidth <= maxLocalWidth) {
			songHudLabelFitCache.set(cacheKey, sourceText);
			return sourceText;
		}

		var ellipsis = "...";
		var ellipsisWidth = measureSongHudLabelWidth(ellipsis);
		if (ellipsisWidth > maxLocalWidth) {
			songHudLabelFitCache.set(cacheKey, "");
			return "";
		}

		var low = 0;
		var high = sourceText.length;
		var best = ellipsis;
		while (low <= high) {
			var mid = Std.int((low + high) * 0.5);
			var candidate = sourceText.substr(0, mid) + ellipsis;
			var candidateWidth = measureSongHudLabelWidth(candidate);
			if (candidateWidth <= maxLocalWidth) {
				best = candidate;
				low = mid + 1;
			} else {
				high = mid - 1;
			}
		}

		songHudLabelFitCache.set(cacheKey, best);
		return best;
	}

	function measureSongHudLabelWidth(text:String):Float {
		if (songHudLabelMeasure == null) {
			if (songHudLabel == null) return 0;
			return (songHudLabel.textField != null) ? songHudLabel.textField.textWidth + 4 : songHudLabel.width;
		}
		if (songHudLabelMeasure.text != text) songHudLabelMeasure.text = text;
		songHudLabelMeasure.updateHitbox();
		if (songHudLabelMeasure.textField != null) return songHudLabelMeasure.textField.textWidth + 4;
		return songHudLabelMeasure.width;
	}

	function getSongHudLabelTextWidth():Float {
		if (songHudLabel == null) return 0;
		if (Math.isNaN(lastSongLabelTextWidth)) {
			if (songHudLabel.textField != null) lastSongLabelTextWidth = songHudLabel.textField.textWidth + 4;
			else lastSongLabelTextWidth = songHudLabel.width;
		}
		return lastSongLabelTextWidth;
	}

	function getSongHudLabelClipHeight():Float {
		if (songHudLabel == null) return 1;
		if (songHudLabel.frameHeight > 0) return songHudLabel.frameHeight;
		if (songHudLabel.height > 0) return songHudLabel.height;
		return 1;
	}

	function getSongHudLabel(ps):String {
		if (ps == null) return "";

		if (HatsuneHudLayout.SONG_LABEL_SHOW_ID) {
			return (ps.currentSong != null && ps.currentSong.id != null) ? ps.currentSong.id : "";
		}

		var chartSongName = ps.currentChart?.songName;
		if (chartSongName != null && chartSongName != "") return chartSongName;

		var songName = (ps.currentSong != null) ? ps.currentSong.songName : null;
		if (songName != null && songName != "") return songName;

		return (ps.currentSong != null && ps.currentSong.id != null) ? ps.currentSong.id : "";
	}

	function getSongHudLabelDisplayName(ps):String {
		if (ps == null) return "";

		var chartSongName = ps.currentChart?.songName;
		if (chartSongName != null && chartSongName != "") return chartSongName;

		var songName = (ps.currentSong != null) ? ps.currentSong.songName : null;
		if (songName != null && songName != "") return songName;

		return (ps.currentSong != null && ps.currentSong.id != null) ? ps.currentSong.id : "";
	}

	function updateDangerFade() {
		if (dangerFadeCountdown <= 0) return;

		dangerFadeCountdown -= FlxG.elapsed;
		if (dangerFadeCountdown <= 0) {
			if (backTween != null) backTween.cancel();
			if (meterBack != null) backTween = FlxTween.color(meterBack, dangerFadeDuration, meterBack.color, meterEmptyBack);
			dangerFadeCountdown = 0;
		}
	}

	function refreshBarColors(force:Bool) {
		var icon = (PlayState.instance != null) ? PlayState.instance.iconP1 : null;
		var sampleKey = buildIconSampleKey(icon);
		if (!force && sampleKey == lastIconSampleKey) return;

		var color = findIconColour(icon);
		baseBarColor = color;

		var r = clamp8(((color >> 16) & 0xFF) + flashMod);
		var g = clamp8(((color >> 8) & 0xFF) + flashMod);
		var b = clamp8((color & 0xFF) + flashMod);
		flashColor = FlxColor.fromRGB(r, g, b);

		var baseR = ((color >> 16) & 0xFF);
		var baseG = ((color >> 8) & 0xFF);
		var baseB = (color & 0xFF);
		var r2 = clamp8(baseR + Std.int(flashMod * dangerRedFactor));
		var g2 = clamp8(baseG - Std.int(flashMod * dangerDimFactor));
		var b2 = clamp8(baseB - Std.int(flashMod * dangerDimFactor));
		var dbR = ((meterDangerBack >> 16) & 0xFF);
		var dbG = ((meterDangerBack >> 8) & 0xFF);
		var dbB = (meterDangerBack & 0xFF);
		r2 = clamp8(Std.int(r2 * (1 - dangerBlend) + dbR * dangerBlend));
		g2 = clamp8(Std.int(g2 * (1 - dangerBlend) + dbG * dangerBlend));
		b2 = clamp8(Std.int(b2 * (1 - dangerBlend) + dbB * dangerBlend));
		dangerFlashColor = FlxColor.fromRGB(r2, g2, b2);

		if (meter != null) meter.color = baseBarColor;
		lastIconSampleKey = sampleKey;
	}

	function buildIconSampleKey(icon) {
		if (icon == null) return "";

		var key = "" + icon.characterId + ":" + Std.int(icon.width) + "x" + Std.int(icon.height);
		if (icon.graphic != null && icon.graphic.key != null) key += ":" + icon.graphic.key;
		return key;
	}

	function clamp8(v) {
		if (v < 0) return 0;
		if (v > 255) return 255;
		return v;
	}

	function findIconColour(icon) {
		if (icon == null || icon.pixels == null) return FlxColor.WHITE;

		var iconColour = 0xFFFFFFFF;
		var lightest = 0;

		var ypos = 0;
		var xpos = 0;
		var iw = Std.int(icon.width);
		var ih = Std.int(icon.height);
		if (iw <= 0 || ih <= 0) return FlxColor.WHITE;

		for (i in 0...30) {
			var sx = xpos;
			var sy = ypos;
			if (sx >= iw) sx = iw - 1;
			if (sy >= ih) sy = ih - 1;
			if (sx < 0) sx = 0;
			if (sy < 0) sy = 0;

			iconColour = icon.pixels.getPixel(sx, sy);
			if (iconColour != 0 && iconColour != 0xFFFFFF && iconColour > lightest) lightest = iconColour;

			if (ypos < 50) ypos += 5;
			xpos += 5;
		}

		if (lightest > 0) {
			return FlxColor.fromString(FlxColor.toHexString(lightest, false));
		}

		return FlxColor.WHITE;
	}

	function cleanupSprites(stateRef) {
		stopScoreRankSparkle();
		clearChanceHudTweens();
		removeAndDestroy(stateRef, playerHudArt);
		removeAndDestroy(stateRef, healthHudArt);
		removeAndDestroy(stateRef, scoreHudArt);
		removeAndDestroy(stateRef, chanceBottomHudArt);
		removeAndDestroy(stateRef, chanceTopHudArt);
		removeAndDestroy(stateRef, chanceScoreHudArt);
		removeAndDestroy(stateRef, chanceStarMeter);
		removeAndDestroy(stateRef, chanceStarMeterStroke);
		for (sprite in chanceBottomHudLeftExt) removeAndDestroy(stateRef, sprite);
		for (sprite in chanceBottomHudRightExt) removeAndDestroy(stateRef, sprite);
		for (sprite in chanceTopHudLeftExt) removeAndDestroy(stateRef, sprite);
		for (sprite in chanceTopHudRightExt) removeAndDestroy(stateRef, sprite);
		removeAndDestroy(stateRef, scoreRankBadge);
		removeAndDestroy(stateRef, scoreRankSparkle);
		for (scoreDigit in scoreDigits) {
			removeAndDestroy(stateRef, scoreDigit);
		}
		removeAndDestroy(stateRef, songHudIcon);
		removeAndDestroy(stateRef, chanceSongHudIcon);
		removeAndDestroy(stateRef, hpBox);
		removeAndDestroy(stateRef, meterBack);
		removeAndDestroy(stateRef, meter);
		removeAndDestroy(stateRef, protectedText);
		removeAndDestroy(stateRef, lifeLabel);
		removeAndDestroy(stateRef, lifeHudIcon);
		removeAndDestroy(stateRef, songHudLabel);
		removeAndDestroy(stateRef, songHudDifficulty);
		removeAndDestroy(stateRef, primarySubtitleDisplay);
		removeAndDestroy(stateRef, secondarySubtitleDisplay);
		removeAndDestroy(stateRef, chanceSubtitleDisplay);
		removeAndDestroy(stateRef, chanceSecondarySubtitleDisplay);
		removeAndDestroy(stateRef, borderTop);
		removeAndDestroy(stateRef, borderBottom);
		removeAndDestroy(stateRef, borderLeft);
		removeAndDestroy(stateRef, borderRight);

		playerHudArt = null;
