		lastChanceStarMeterWidth = -1;
		lastChanceStarMeterStrokeWidth = -1;
		lastSongIconSize = -1;
		lastChanceBottomHudWidth = -1;
		lastChanceTopHudWidth = -1;
		lastChanceSongIconSize = -1;
		lastLifeHudIconWidth = -1;
		lastLifeLabelSize = -1;
