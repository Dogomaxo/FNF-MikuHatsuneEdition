import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.Conductor;
import funkin.Preferences;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.tweens.FlxTween;
import flixel.util.FlxColor;

/**
 * Custom HUD health bar ported from my miku's prototype mod from p-slice (psych engine 1.0.4)
 * - Black border box, slightly lighter inner background, and a single player bar.
 * - Bar color sampled dynamically from the player's icon.
 * - Subtle flash on every beat; becomes reddish when at low health.
 *
 * This module hides the vanilla health bar and the opponent icon.
 * 
 * Original lua script by [skellix] (https://gamebanana.com/mods/534209) (Script made for Psych Engine)
 * Ported to v-slice .hxc language and modified by [Dogomaxo] thats me lol.
 * 
 * Credits to [JugieNoob] for the script 'Health Bar PLUS' where i grabbed part of the color sample code for icons (https://gamebanana.com/mods/612284)
 *
 * Feel free to use this code for your own projects or mods. Just give the credits to the authors [skellix, JugieNoob] and if you want, to me as well :) .
 */

class HatsuneInGameHud extends Module {
	// Sprites for the custom HP UI
	var hpBox:FlxSprite;        // black border box
	var meterBack:FlxSprite;    // inner background
	var meter:FlxSprite;        // actual health fill
	var hudBuilt:Bool = false;
	var builtState = null; // reference to PlayState instance when HUD was built
	var originalIconFlipX:Null<Bool> = null;
	var prevActive:Bool = false; // para detectar transición activo->inactivo
	var hadBeenActive:Bool = false; // se activó alguna vez en la sesión (para restauraciones post-song)
	var passiveFlipFixed:Bool = false; // aplicamos corrección una sola vez por PlayState mientras está inactivo
	var lastStateRef = null; // referencia para detectar cambio de PlayState mientras está inactivo

	// NOTA: No usamos characterId aquí para mantener este módulo genérico. ModuleRouter decide activación.

	// Config (matches the LUA script proportions/colors)
	var meterW = 360;
	var meterH = 15;
	var boxW = 370;
	var boxH = 30;

	// Placement. These mirror the LUA values but adapt to screen size for downscroll.
	var baseX = 125; // fixed left margin
	var barOffsetX = 0; // global horizontal offset for the whole bar (borders + fill + background + icon anchor)
	var barOffsetY = 0; // global vertical offset for the whole bar cluster
	// baseY is computed each frame to respect downscroll/top-bottom margins.

	// ================== CONFIG / TUNABLES ==================
	// Core colors
	var meterEmptyBack = FlxColor.fromRGB(32, 24, 24); // background inside border
	var meterDangerBack = FlxColor.fromRGB(53, 24, 24);
	// Flash intensity for normal (safe) beats
	var flashMod = 54; // increase for brighter normal flashes
	// Danger flash shaping
	var dangerRedFactor = 2.4;   // was 2.8 (lower -> less red boost)
	var dangerDimFactor = 1.2;   // was 1.4 (lower -> less green/blue removal)
	var dangerBlend = 0.25;      // was 0.30 (lower -> less pull toward dark maroon)
	// =======================================================

	var baseBarColor = FlxColor.WHITE;       // sampled from icon
	var flashColor = FlxColor.WHITE;         // base + flashMod
	var dangerFlashColor = FlxColor.WHITE;   // reddish flash when low health

	// Beat tween handles
	var barTween;
	var backTween;
	var dangerFadeCountdown = 0.0; // delay before fading background back
	var dangerFadeDuration = 0.0;   // fade duration
	// no per-icon scale tween; use vanilla bop

	// Remember the icon's baseline width to keep its anchor steady while bopping.
	var iconBaseWidth = -1;
	var iconBaseHeight = -1;
	var iconOffsetX = 35; // horizontal offset from bar (positive -> moves icon left if logic subtracts width)
	var iconOffsetY = -30;  // vertical offset applied after auto-centering relative to bar
	var iconFollowBar = true; // if false, icon ignores barOffsetX/Y (use iconOffsetX/Y only)
	// Bop strength (in pixels to grow on beat); lower = gentler bop
	var bopStrength = 9;
	var dampenStrength = 0.0; // 0..1, lower => weaker bop (applied over vanilla)
	var originCentered = false; // center icon origin only once to keep bop centered
	var iconFixedCenterX = -1.0; // stored center to keep icon perfectly centered during bop

	// Border pieces to avoid covering the inner background
	var borderTop:FlxSprite;
	var borderBottom:FlxSprite;
	var borderLeft:FlxSprite;
	var borderRight:FlxSprite;

	public function new() {
		// Run early so we can force flipX before any one-frame flicker on restart.
		super("Hatsune In-Game HUD", 1);
		// Start inactive; central ModuleRouter will enable when corresponde.
		this.active = false;
	}

	// Build HUD only once when module becomes active (supports activation after countdown)
	function ensureBuilt() {
		if (hudBuilt) return;
		if (PlayState.instance == null || PlayState.instance.healthBar == null) return; // wait until ready
		cleanupSprites();
		builtState = null; // reset before rebuilding
		iconBaseWidth = -1; iconBaseHeight = -1; originCentered = false; iconFixedCenterX = -1.0;
		// Hide vanilla
		if (PlayState.instance.healthBar != null) PlayState.instance.healthBar.visible = false;
		if (PlayState.instance.healthBarBG != null) PlayState.instance.healthBarBG.visible = false;
		if (PlayState.instance.iconP2 != null) { PlayState.instance.iconP2.visible = false; PlayState.instance.iconP2.autoUpdate = false; }
		if (PlayState.instance.iconP1 != null) {
			// Capturar flip nativo SOLO una vez; si resulta false, asumimos vanilla estándar (true) como fallback.
			if (originalIconFlipX == null) {
				var nativeFlip = PlayState.instance.iconP1.flipX;
				if (nativeFlip == false) nativeFlip = true; // fallback por defecto (BF/Pico normalmente true)
				originalIconFlipX = nativeFlip;
			}
			var ic = PlayState.instance.iconP1; ic.visible = true; ic.autoUpdate = true; ic.flipX = false; if (ic.snapToTargetSize != null) ic.snapToTargetSize();
			if (ic.width > 0) iconBaseWidth = Std.int(ic.width); if (ic.height > 0) iconBaseHeight = Std.int(ic.height);
		}
		// Create sprites
		hpBox = new FlxSprite(); hpBox.makeGraphic(boxW, boxH, FlxColor.TRANSPARENT); hpBox.scrollFactor.set(); hpBox.cameras=[PlayState.instance.camHUD]; hpBox.visible=false; hpBox.zIndex=800;
		meterBack = new FlxSprite(); meterBack.makeGraphic(meterW, meterH, FlxColor.WHITE); meterBack.scrollFactor.set(); meterBack.cameras=[PlayState.instance.camHUD]; meterBack.zIndex=801; meterBack.origin.set(0,0); meterBack.color = meterEmptyBack;
		meter = new FlxSprite(); meter.makeGraphic(1, meterH, FlxColor.WHITE); meter.scrollFactor.set(); meter.cameras=[PlayState.instance.camHUD]; meter.zIndex=802; meter.origin.set(0,0);
		borderTop = new FlxSprite(); borderTop.makeGraphic(boxW,5,FlxColor.BLACK); borderTop.scrollFactor.set(); borderTop.cameras=[PlayState.instance.camHUD]; borderTop.zIndex=803; borderTop.origin.set(0,0);
		borderBottom = new FlxSprite(); borderBottom.makeGraphic(boxW,5,FlxColor.BLACK); borderBottom.scrollFactor.set(); borderBottom.cameras=[PlayState.instance.camHUD]; borderBottom.zIndex=803; borderBottom.origin.set(0,0);
		borderLeft = new FlxSprite(); borderLeft.makeGraphic(5,meterH,FlxColor.BLACK); borderLeft.scrollFactor.set(); borderLeft.cameras=[PlayState.instance.camHUD]; borderLeft.zIndex=803; borderLeft.origin.set(0,0);
		borderRight = new FlxSprite(); borderRight.makeGraphic(5,meterH,FlxColor.BLACK); borderRight.scrollFactor.set(); borderRight.cameras=[PlayState.instance.camHUD]; borderRight.zIndex=803; borderRight.origin.set(0,0);
		PlayState.instance.add(hpBox); PlayState.instance.add(meterBack); PlayState.instance.add(meter); PlayState.instance.add(borderTop); PlayState.instance.add(borderBottom); PlayState.instance.add(borderLeft); PlayState.instance.add(borderRight);
		recalcColorsFromIcon(); layoutAndSize(); PlayState.instance.refresh(); hudBuilt = true; builtState = PlayState.instance;
	}

	function restoreVanilla() {
		if (PlayState.instance != null) {
			if (PlayState.instance.healthBar != null) PlayState.instance.healthBar.visible = true;
			if (PlayState.instance.healthBarBG != null) PlayState.instance.healthBarBG.visible = true;
			if (PlayState.instance.iconP1 != null) {
				if (originalIconFlipX != null) PlayState.instance.iconP1.flipX = originalIconFlipX; else if (PlayState.instance.iconP1.flipX == false) PlayState.instance.iconP1.flipX = true;
				PlayState.instance.iconP1.autoUpdate = true; PlayState.instance.iconP1.visible = true;
			}
			if (PlayState.instance.iconP2 != null) { PlayState.instance.iconP2.visible = true; PlayState.instance.iconP2.autoUpdate = true; }
		}
		cleanupSprites(); hudBuilt = false; originalIconFlipX = null; builtState = null;
	}

	// Hook de desactivación inmediata: algunos cambios de canción hacen que el update tarde 1 frame.
	public override function onDeactivate() {
		// Restaurar flip original apenas se desactiva el módulo.
		if (PlayState.instance != null && PlayState.instance.iconP1 != null) {
			if (originalIconFlipX != null) PlayState.instance.iconP1.flipX = originalIconFlipX; else if (PlayState.instance.iconP1.flipX == false) PlayState.instance.iconP1.flipX = true;
		}
	}

		override function onSongRetry(event) {
		super.onSongRetry(event);
		// Si está activo en el retry, garantizar flip deseado; si no, no tocar (deja orientación del engine).
		if (this.active && PlayState.instance != null && PlayState.instance.iconP1 != null) {
			var icon = PlayState.instance.iconP1;
			icon.flipX = false;
			icon.autoUpdate = true; icon.visible = true;
			if (icon.snapToTargetSize != null) icon.snapToTargetSize();
		}
	}

		override function onSongLoaded(event) {
		super.onSongLoaded(event);
		// Sólo forzar si estamos activos; si no, no modificar el flip que asigna el engine al nuevo personaje.
		if (this.active && PlayState.instance != null && PlayState.instance.iconP1 != null) {
			var icon = PlayState.instance.iconP1;
			icon.flipX = false;
			icon.autoUpdate = true; icon.visible = true;
			if (icon.snapToTargetSize != null) icon.snapToTargetSize();
		}
	}

	override function onCountdownStart(event) {
		super.onCountdownStart(event);
		// Construcción diferida gestionada en onUpdate
	}

	override function onUpdate(event) {
		super.onUpdate(event);
		if (PlayState.instance == null) return;

		// Detectar cambio de PlayState siempre (activos o no) para reiniciar banderas pasivas.
		if (lastStateRef != PlayState.instance) {
			lastStateRef = PlayState.instance;
			passiveFlipFixed = false;
		}
		// Detect PlayState change (e.g., exited song and entered another without deactivating module)
		if (hudBuilt && builtState != PlayState.instance) {
			// Intento de restaurar flip en el estado viejo (si aún existe) y limpiar.
			if (builtState != null && builtState.iconP1 != null && originalIconFlipX != null) builtState.iconP1.flipX = originalIconFlipX;
			hudBuilt = false; builtState = null; originalIconFlipX = null;
		}
		if (this.active) {
			hadBeenActive = true; // marcar que estuvo activo al menos una vez
			ensureBuilt();
		} else {
			// Si antes estaba activo y ahora no, restaurar inmediatamente.
			if (prevActive) restoreVanilla();
			// Corrección pasiva: si venimos de HUD y el nuevo icono aparece todavía mirando a la derecha (flipX=false),
			// forzar flip estándar (true) UNA sola vez para este PlayState, dejando luego al engine en control.
			if (!passiveFlipFixed && PlayState.instance.iconP1 != null && PlayState.instance.iconP1.flipX == false) {
				PlayState.instance.iconP1.flipX = true;
				passiveFlipFixed = true;
			}
			prevActive = this.active;
			return;
		}

		// Enforce manual control and correct facing every frame (covers retries/late init)
		if (PlayState.instance.iconP1 != null) {
			var icon = PlayState.instance.iconP1;
			icon.autoUpdate = true;
			icon.flipX = false;
				// If size is still lerping on the first frames, snap once to avoid anchor shift
				if ((iconBaseWidth <= 0 || iconBaseHeight <= 0) && icon.snapToTargetSize != null) icon.snapToTargetSize();
				// Always center the origin so bops scale from the center, not top-left
				if (icon.width > 0 && icon.height > 0) icon.centerOrigin();
				if (icon.width > 0) iconBaseWidth = Std.int(icon.width);
				if (icon.height > 0) iconBaseHeight = Std.int(icon.height);
		}

		// Keep position, size and fill in sync each frame (only if current build is valid).
		if (hudBuilt && hpBox != null && meterBack != null && meter != null) layoutAndSize();
		prevActive = this.active;

		// Handle scheduled danger background fade (imitates Lua timing: quarter-beat delay then half-beat fade).
		if (dangerFadeCountdown > 0) {
			dangerFadeCountdown -= FlxG.elapsed;
			if (dangerFadeCountdown <= 0) {
				if (backTween != null) backTween.cancel();
				if (meterBack != null) backTween = FlxTween.color(meterBack, dangerFadeDuration, meterBack.color, meterEmptyBack);
				dangerFadeCountdown = 0;
			}
		}
	}

	override function onBeatHit(event) {
		super.onBeatHit(event);
		if (PlayState.instance == null) return;
	if (!this.active || !hudBuilt) return;

	// Re-sample if icons changed mid-song (character swap).
	if (meter != null) recalcColorsFromIcon();

			// If flashing lights are disabled, do not perform beat flashes.
			if (!Preferences.flashingLights) {
				if (meter != null) meter.color = baseBarColor;
				if (meterBack != null) meterBack.color = meterEmptyBack;
				return;
			}

		var crochetMs = (Conductor.instance != null ? Conductor.instance.beatLengthMs : 500);
		var crochetSec = crochetMs / 1000.0;

		// Determine danger based on player's health (<= 20% of 2.0)
		var isDanger = (PlayState.instance.health <= 0.4);

		// Background flash logic (Lua parity):
		// If in danger, set red instantly, wait quarter beat, then tween back over half beat.
		// Otherwise keep neutral color.
		if (backTween != null) { backTween.cancel(); backTween = null; }
		if (isDanger) {
			if (meterBack != null) meterBack.color = meterDangerBack;
			// schedule fade
			var quarter = crochetSec * 0.25;
			dangerFadeCountdown = quarter;
			dangerFadeDuration = crochetSec * 0.5; // half beat fade
		} else {
			dangerFadeCountdown = 0;
			if (meterBack != null) meterBack.color = meterEmptyBack;
		}

		// Bar flash: brighter on beat, redder when danger, then tween back to base color
		if (barTween != null) barTween.cancel();
		meter.color = isDanger ? dangerFlashColor : flashColor;
		barTween = FlxTween.color(meter, crochetSec, meter.color, baseBarColor);

		// Dampen vanilla icon bop and keep it centered
		if (PlayState.instance.iconP1 != null) {
			var icon = PlayState.instance.iconP1;
			var sx = icon.scale.x;
			var sy = icon.scale.y;
			if (sx > 1 || sy > 1) {
				var avg = (sx + sy) * 0.5;
				var damped = 1 + (avg - 1) * dampenStrength;
				icon.scale.set(damped, damped);
				// recentre after scale to avoid diagonal bias
				layoutAndSize();
			}
		}
	}

	function layoutAndSize() {
		if (hpBox == null || meterBack == null || meter == null) return;
		// Compute anchored Y positions similar to LUA values while adapting to screen size.
		var yPos = Preferences.downscroll ? 70 : (FlxG.height - 43);
		// Apply global vertical offset
		yPos += barOffsetY;

		// Position sprites. meterBack sits inside where the border will be.
		hpBox.x = baseX + barOffsetX - 5; // invisible legacy box
		hpBox.y = yPos - 5;

		meterBack.x = baseX + barOffsetX;
		meterBack.y = yPos;

		// Fill size based on health (0..2)
		var ratio = Math.max(0, Math.min(1, PlayState.instance.health / 2));
		var fillW = Math.max(1, meterW * ratio);
		meter.setPosition(baseX + barOffsetX, yPos);
		meter.scale.x = fillW; // since the source is 1px wide
		meter.updateHitbox();

		// Border pieces around the background
		if (borderTop != null) { borderTop.x = baseX + barOffsetX - 5; borderTop.y = yPos - 5; }
		if (borderBottom != null) { borderBottom.x = baseX + barOffsetX - 5; borderBottom.y = yPos + meterH; }
		if (borderLeft != null) { borderLeft.x = baseX + barOffsetX - 5; borderLeft.y = yPos; }
		if (borderRight != null) { borderRight.x = baseX + barOffsetX + meterW; borderRight.y = yPos; }

	// If needed later, the score text can be repositioned via PlayState code.

		// Place and layer player's icon next to the bar.
		if (PlayState.instance.iconP1 != null) {
			var icon = PlayState.instance.iconP1;
			var anchorW = (iconBaseWidth > 0) ? iconBaseWidth : Std.int(icon.width);
			// Compute and store a fixed center X once (or if anchor width changes) to avoid left shift when scaling.
			var barAdjX = iconFollowBar ? barOffsetX : 0;
			var barAdjY = iconFollowBar ? barOffsetY : 0;
			if (iconFixedCenterX < 0 || anchorW != iconBaseWidth) {
				iconFixedCenterX = (baseX + barAdjX - anchorW + iconOffsetX) + (anchorW * 0.5);
			}
			// Re-center origin (safety) then position so the visual center stays constant.
			if (icon.width > 0 && icon.height > 0) icon.centerOrigin();
			icon.x = Std.int(iconFixedCenterX - (icon.width * 0.5));
			// Use original yPos without barOffsetY if icon doesn't follow bar vertically.
			var finalYPos = iconFollowBar ? yPos : ( (Preferences.downscroll ? 70 : (FlxG.height - 43)) + iconOffsetY );
			if (!iconFollowBar) finalYPos = Std.int(finalYPos); else finalYPos = Std.int(yPos + iconOffsetY);
			icon.y = Std.int(finalYPos - (icon.height / 2) + (meterH / 2) - 8);
			icon.zIndex = 9999;
			icon.cameras = [PlayState.instance.camHUD];
		}
	}

	function recalcColorsFromIcon() {
		// Pull a representative color from the player's icon.
	var color = findIconColour((PlayState.instance != null) ? PlayState.instance.iconP1 : null);
		baseBarColor = color;

		// flash: +flashMod to all channels
	var r = clamp8(((color >> 16) & 0xFF) + flashMod);
	var g = clamp8(((color >> 8) & 0xFF) + flashMod);
	var b = clamp8((color & 0xFF) + flashMod);
		flashColor = FlxColor.fromRGB(r, g, b);

		// Danger flash: push stronger toward red and darker like Lua visual intent.
	var baseR = ((color >> 16) & 0xFF);
	var baseG = ((color >> 8) & 0xFF);
	var baseB = (color & 0xFF);
	var r2 = clamp8(baseR + Std.int(flashMod * dangerRedFactor));
	var g2 = clamp8(baseG - Std.int(flashMod * dangerDimFactor));
	var b2 = clamp8(baseB - Std.int(flashMod * dangerDimFactor));
	// Blend with predefined dark danger background to shift hue if still too cyan/green.
	var dbR = ((meterDangerBack >> 16) & 0xFF);
	var dbG = ((meterDangerBack >> 8) & 0xFF);
	var dbB = (meterDangerBack & 0xFF);
	r2 = clamp8(Std.int(r2 * (1 - dangerBlend) + dbR * dangerBlend));
	g2 = clamp8(Std.int(g2 * (1 - dangerBlend) + dbG * dangerBlend));
	b2 = clamp8(Std.int(b2 * (1 - dangerBlend) + dbB * dangerBlend));
		dangerFlashColor = FlxColor.fromRGB(r2, g2, b2);

		// Apply base color immediately so the bar adopts the icon color.
		if (meter != null) meter.color = baseBarColor;
	}

	function clamp8(v) {
		if (v < 0) return 0;
		if (v > 255) return 255;
		return v;
	}

	// Ported and simplified from the sample HBPlus.hxc
	function findIconColour(icon) {
		if (icon == null || icon.pixels == null) return FlxColor.WHITE;

		var iconColour = 0xFFFFFFFF;
		var colorArray = [];
		var lightest = 0;

		var ypos = 0;
		var xpos = 0;
		var iw = Std.int(icon.width);
		var ih = Std.int(icon.height);
		if (iw <= 0 || ih <= 0) return FlxColor.WHITE;
		for (i in 0...30) {
			var sx = xpos;
			var sy = ypos;
			if (sx >= iw) sx = iw - 1;
			if (sy >= ih) sy = ih - 1;
			if (sx < 0) sx = 0;
			if (sy < 0) sy = 0;
			iconColour = icon.pixels.getPixel(sx, sy);
			if (iconColour != 0 && iconColour != 0xFFFFFF && !colorArray.contains(iconColour)) {
				colorArray.push(iconColour);
			}
			if (ypos < 50) ypos += 5;
			xpos += 5;
		}

		if (colorArray.length > 0) {
			for (c in colorArray) {
				if (c > lightest) {
					iconColour = c;
					lightest = c;
				}
			}
			return FlxColor.fromString(FlxColor.toHexString(iconColour, false));
		}

		return FlxColor.WHITE;
	}

	function cleanupSprites() {
		// Safely remove prior sprites from the state to prevent visual duplicates.
		if (PlayState.instance == null) return;
		removeAndDestroy(hpBox);
		removeAndDestroy(meterBack);
		removeAndDestroy(meter);
		removeAndDestroy(borderTop);
		removeAndDestroy(borderBottom);
		removeAndDestroy(borderLeft);
		removeAndDestroy(borderRight);
		hpBox = null;
		meterBack = null;
		meter = null;
		borderTop = null;
		borderBottom = null;
		borderLeft = null;
		borderRight = null;
	}

	function removeAndDestroy(spr) {
		// hscript is less permissive: avoid type annotations and try/catch.
		if (spr == null) return;
		if (PlayState.instance != null) PlayState.instance.remove(spr, true);
		if (spr.destroy != null) spr.destroy();
	}
}
