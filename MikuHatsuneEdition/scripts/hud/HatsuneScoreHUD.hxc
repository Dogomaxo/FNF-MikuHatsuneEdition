import funkin.modding.module.Module;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.text.FlxBitmapText;
import funkin.Preferences;

/**
 * Hatsune Score HUD Module
 * Repositions the vanilla score text (PlayState.scoreText) to the top-right corner while active.
 * Compatible with ModuleRouter (activation controlled externally).
 * Non-destructive: stores and restores original layout for FlxBitmapText.
 * Note: FlxBitmapText uses bitmap fonts with fixed size, so we manipulate position and scale instead.
 */
class HatsuneScoreHud extends Module {
	// Store original layout values so we can restore them when deactivated.
	var originalX:Float = Math.NaN;
	var originalY:Float = Math.NaN;
	var originalScale:Float = Math.NaN; // FlxBitmapText uses scale, not size
	var originalAlignment; // stored alignment
	var grabbedState = null; // PlayState reference when we captured original position.
	var applied:Bool = false; // whether custom positioning applied this frame

	// Cache for vertical positioning micro-optimization (downScroll / screen or text size changes)
	var lastDownState:Null<Bool> = null;
	var lastAppliedScreenH:Int = -1;
	var lastAppliedTextWidth:Float = Math.NaN;

	// === CONFIGURATION ===
	// Horizontal anchor mode: "LEFT" or "RIGHT" (default RIGHT for top-right score).
	var anchorHorizontal:String = "RIGHT";
	// Margins from screen edges.
	var marginLeft:Float = 40;  // only used if LEFT anchor
	var marginRight:Float = 16; // distance from right edge
	// Vertical margins (TOP / BOTTOM). TOP is used unless downScroll is enabled.
	var marginTop:Float = 12;
	var marginBottom:Float = 12;
	// Scale multiplier for bitmap text (no fixed size like FlxText).
	var scaleMultiplier:Float = 1.5; // scales the bitmap font proportionally

	public function new() {
		super("Hatsune Score HUD", 1); // run after router but before most others
		this.active = false; // Router decides activation
	}

	override function onUpdate(e) {
		super.onUpdate(e);
		if (PlayState.instance == null) return;
		var ps = PlayState.instance;
		var txt:FlxBitmapText = ps.scoreText;
		if (txt == null) return;

		if (this.active) {
			// Capture original only once per PlayState.
			if (grabbedState != ps) {
				storeOriginal(txt);
			}
			// Apply custom layout each frame (covers scale/camera changes)
			applyLayout(txt);
			applied = true;
		} else {
			// If we were applied and now inactive, restore.
			if (applied) restore(txt);
			applied = false;
		}
	}

	override function onDeactivate() {
		if (PlayState.instance != null && PlayState.instance.scoreText != null) restore(PlayState.instance.scoreText);
		applied = false;
	}

	function storeOriginal(txt:FlxBitmapText) {
		originalX = txt.x;
		originalY = txt.y;
		originalScale = txt.scale.x; // store scale (FlxBitmapText uses scale, not size)
		originalAlignment = txt.alignment; // store alignment
		grabbedState = PlayState.instance;
	}

	function applyLayout(txt:FlxBitmapText) {
		// Apply scaling first (FlxBitmapText uses scale.x and scale.y for sizing).
		var newScale = scaleMultiplier;
		if (txt.scale.x != newScale || txt.scale.y != newScale) {
			txt.scale.x = newScale;
			txt.scale.y = newScale;
		}
		
		var w = FlxG.width;
		var h = FlxG.height;
		var scaledWidth = txt.width; // width is already affected by scale
		
		// Horizontal positioning.
		if (anchorHorizontal == "LEFT") {
			if (txt.x != marginLeft) txt.x = marginLeft;
			if (txt.alignment != "left") txt.alignment = "left";
		} else { // RIGHT
			var newX = w - scaledWidth - marginRight;
			if (newX < marginLeft) newX = marginLeft; // safety if window shrinks
			if (txt.x != newX) txt.x = newX;
			if (txt.alignment != "right") txt.alignment = "right";
		}
		
		// Vertical positioning only if downScroll, screen height, or text width changed.
		var down = Preferences.downScroll;
		if (down != lastDownState || h != lastAppliedScreenH || scaledWidth != lastAppliedTextWidth) {
			var newY = down ? (h - txt.height - marginBottom) : marginTop;
			if (txt.y != newY) txt.y = newY;
			lastDownState = down;
			lastAppliedScreenH = h;
			lastAppliedTextWidth = scaledWidth;
		}
	}

	function restore(txt:FlxBitmapText) {
		if (Math.isNaN(originalX) || Math.isNaN(originalY)) return; // nothing stored
		txt.x = originalX;
		txt.y = originalY;
		if (!Math.isNaN(originalScale)) {
			txt.scale.x = originalScale;
			txt.scale.y = originalScale;
		}
		if (originalAlignment != null && txt.alignment != null) txt.alignment = originalAlignment;
	}
}

