	// -------------------------------------------------------------------------
	// Gameplay Strumlines
	// Fine tuning for the real player/opponent strumlines exposed by PlayState.
	// These settings are applied relative to the engine's vanilla placement so
	// they stay compatible with different aspect ratios and mobile presets.
	// - SCALE multiplies the base receptor/tap-note scale.
	// - NOTE_SPACING multiplies the horizontal lane spacing.
	// - OFFSET_X / OFFSET_Y are scaled nudges applied after vanilla layout.
	// Incoming notes already on screen are realigned to match these values.
	// -------------------------------------------------------------------------
	public static inline var PLAYER_STRUMLINE_SCALE:Float = 0;
	public static inline var PLAYER_STRUMLINE_NOTE_SPACING:Float = 1.0;
	public static inline var PLAYER_STRUMLINE_OFFSET_X:Float = 0;
	public static inline var PLAYER_STRUMLINE_OFFSET_Y:Float = 0;
