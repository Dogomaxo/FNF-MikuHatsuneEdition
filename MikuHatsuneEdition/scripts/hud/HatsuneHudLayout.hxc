	// -------------------------------------------------------------------------
	// Song Label: 5by7 HUD text
	// Uses the same 5by7 font used by Freeplay capsule text.
	// - SHOW_ID toggles between song display name and the raw song ID.
	// - SIZE controls the base FlxText size before scaling.
	// - SCALE multiplies the rendered text size.
	// - X / MARGIN_Y define the base screen position.
	// - OFFSET_X / OFFSET_Y provide scaled fine tuning.
	// - MAX_WIDTH limits how wide the label can grow.
	// - RIGHT_INSET keeps a right-side padding inside the score HUD panel.
	// - DIFFICULTY_* control the current difficulty sprite shown beside the song label.
	// - BORDER_SIZE controls the black outline thickness.
	// - SCROLL_ENABLED turns marquee movement on for long names.
	// - SCROLL_SPEED is the horizontal speed in pixels per second.
	// - SCROLL_START_DELAY waits before the first movement.
	// - SCROLL_END_DELAY waits before returning.
	// -------------------------------------------------------------------------
	public static inline var SONG_LABEL_Z:Int = 1008;
	public static inline var SONG_LABEL_SHOW_ID:Bool = false;
	public static inline var SONG_LABEL_SIZE:Int = 18;
	public static inline var SONG_LABEL_SCALE:Float = 1.3;
	public static inline var SONG_LABEL_X:Float = 132;
	public static inline var SONG_LABEL_MARGIN_Y:Float = 9;
	public static inline var SONG_LABEL_OFFSET_X:Float = 10;
