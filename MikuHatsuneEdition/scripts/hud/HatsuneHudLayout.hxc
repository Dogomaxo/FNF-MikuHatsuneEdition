	// Voltage Gauge: voltage_powerMIKU.hxc
	// Global controls for the Miku voltage gauge gameplay overlay.
	// - X / Y move the entire gauge as a whole.
	// - SCALE changes the overall size of the indicator.
	// - Z_BASE is the base z-index; the script stacks its internal parts above it.
	// - INITIAL_CHARGE chooses how full the gauge starts (0.0 to 1.0).
	// -------------------------------------------------------------------------
