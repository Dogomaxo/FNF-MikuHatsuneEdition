	public static inline var VOLTAGE_GAUGE_INITIAL_CHARGE:Float = 1.0;

	// -------------------------------------------------------------------------
	// Health Bar Label: 5by7 LIFE text
	// Drawn to the left of the real gameplay health bar.
	// - SHOW toggles the label.
	// - SIZE controls the base FlxText size before scaling.
	// - SCALE multiplies the rendered text size.
	// - GAP controls the spacing from the left edge of the bar.
	// - OFFSET_X / OFFSET_Y provide scaled fine tuning.
	// - BORDER_SIZE controls the black outline thickness.
	// -------------------------------------------------------------------------
	public static inline var LIFE_LABEL_Z:Int = 1006;
	public static inline var LIFE_LABEL_SHOW:Bool = true;
	public static inline var LIFE_LABEL_SIZE:Int = 18;
	public static inline var LIFE_LABEL_SCALE:Float = 1.0;
	public static inline var LIFE_LABEL_GAP:Float = 8;
	public static inline var LIFE_LABEL_OFFSET_X:Float = 6;
	public static inline var LIFE_LABEL_OFFSET_Y:Float = 2;
	public static inline var LIFE_LABEL_DOWNSCROLL_OFFSET_X:Float = 0;
	public static inline var LIFE_LABEL_DOWNSCROLL_OFFSET_Y:Float = 0;
	public static inline var LIFE_LABEL_BORDER_SIZE:Float = 1;

	// -------------------------------------------------------------------------
	// Health Bar Icon: ICON HEALTH
	// Drawn to the left of the LIFE label.
	// - SHOW toggles the icon.
	// - SCALE controls the atlas sprite size.
	// - GAP controls the spacing from the LIFE label.
	// - OFFSET_X / OFFSET_Y provide scaled fine tuning.
	// -------------------------------------------------------------------------
	public static inline var LIFE_ICON_Z:Int = 1009;
	public static inline var LIFE_ICON_SHOW:Bool = true;
	public static inline var LIFE_ICON_SCALE:Float = 0.65;
	public static inline var LIFE_ICON_GAP:Float = 6;
	public static inline var LIFE_ICON_OFFSET_X:Float = 6;
	public static inline var LIFE_ICON_OFFSET_Y:Float = -1;
	public static inline var LIFE_ICON_DOWNSCROLL_OFFSET_X:Float = 0;
	public static inline var LIFE_ICON_DOWNSCROLL_OFFSET_Y:Float = 0;

	// -------------------------------------------------------------------------
	// Misc HUD Text
	// Small helper offsets for text rendered over the bar.
	// - PROTECTED_TEXT_SIZE controls the base font size.
	// - PROTECTED_TEXT_SCALE multiplies the rendered text size.
	// - PROTECTED_TEXT_X_NUDGE / Y_NUDGE move the text inside the bar area.
	// - PROTECTED_TEXT_BORDER_SIZE controls the outline thickness.
	// -------------------------------------------------------------------------
	public static inline var PROTECTED_TEXT_SIZE:Int = 14;
	public static inline var PROTECTED_TEXT_SCALE:Float = 0.8;
	public static inline var PROTECTED_TEXT_X_NUDGE:Float = 155;
	public static inline var PROTECTED_TEXT_Y_NUDGE:Float = 1.5;
	public static inline var PROTECTED_TEXT_DOWNSCROLL_OFFSET_X:Float = 0;
	public static inline var PROTECTED_TEXT_DOWNSCROLL_OFFSET_Y:Float = 0;
	public static inline var PROTECTED_TEXT_BORDER_SIZE:Float = 2;

	public static function isDownscroll():Bool {
		return #if mobile (Preferences.controlsScheme == FunkinHitboxControlSchemes.Arrows && !ControlsHandler.hasExternalInputDevice)
			|| #end Preferences.downscroll;
	}

	public static function getUiScale():Float {
		// Scale against the base resolution, then clamp so extreme aspect ratios
		// do not make the HUD absurdly tiny or huge.
		var scaleX = FlxG.width / BASE_SCREEN_W;
		var scaleY = FlxG.height / BASE_SCREEN_H;
		var scale = Math.min(scaleX, scaleY);
		if (scale < MIN_UI_SCALE) scale = MIN_UI_SCALE;
		if (scale > MAX_UI_SCALE) scale = MAX_UI_SCALE;
		return scale;
	}

	public static function getBarAnchor(barOffsetX:Float, barOffsetY:Float) {
		// This returns the anchor for the real gameplay health bar only.
		// Decorative sprites use their own independent positioning values above.
		var uiScale = getUiScale();
		var downscroll = isDownscroll();
		var downscrollOffsetX = downscroll ? (BAR_DOWNSCROLL_OFFSET_X * uiScale) : 0;
		var downscrollOffsetY = downscroll ? (BAR_DOWNSCROLL_OFFSET_Y * uiScale) : 0;
		var baseY = downscroll ? Std.int(BAR_DOWN_Y * uiScale) : Std.int(FlxG.height - BAR_UP_MARGIN - (BAR_UP_LIFT * uiScale));
		return {
			x: BAR_BASE_X + barOffsetX + downscrollOffsetX,
			y: baseY + barOffsetY + downscrollOffsetY,
			uiScale: uiScale,
			downscroll: downscroll
		};
	}
}