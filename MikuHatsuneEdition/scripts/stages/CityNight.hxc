import funkin.play.stage.Stage;

class CityNightStage extends Stage
{
	var platform = null;
	var platformPropName:String = 'Platform';
	var lastPlatformFrameIndex:Int = -1;
	var platformFrameNames:Array<String> = [
		'loop1',
		'loop2',
		'loop3',
		'loop4',
		'loop5',
		'loop6',
		'loop7',
		'loop8',
		'loop9',
		'loop10',
		'loop11',
		'loop12',
		'loop13',
		'loop14',
		'loop15'
	];

	function new()
	{
		super('CityNight');
	}

	override function buildStage():Void
	{
		platform = null;
		lastPlatformFrameIndex = -1;
		super.buildStage();
		cachePlatform();
		playPlatformFrame(0);
	}

	override function onDestroy(event:ScriptEvent):Void
	{
		platform = null;
		lastPlatformFrameIndex = -1;
		super.onDestroy(event);
	}

	override function onBeatHit(event:SongTimeScriptEvent):Void
	{
		super.onBeatHit(event);

		if (event.beat < 0)
		{
			return;
		}

		playPlatformFrame(event.beat % platformFrameNames.length);
	}

	function cachePlatform():Void
	{
		if (platform != null && platform.animation != null)
		{
			return;
		}

		platform = null;

		var platformProp = getNamedProp(platformPropName);
		if (platformProp != null && platformProp.animation != null)
		{
			platform = platformProp;
		}
	}

	function playPlatformFrame(frameIndex:Int):Void
	{
		if (frameIndex == lastPlatformFrameIndex && platform != null)
		{
			return;
		}

		if (platform == null || platform.animation == null)
		{
			cachePlatform();
		}

		if (platform == null)
		{
			return;
		}

		if (platform.animation == null)
		{
			platform = null;
			lastPlatformFrameIndex = -1;
			return;
		}

		var targetFrame = platformFrameNames[frameIndex];
		if (targetFrame == null)
		{
			return;
		}

		if (platform.animation.curAnim != null && platform.animation.curAnim.name == targetFrame)
		{
			lastPlatformFrameIndex = frameIndex;
			return;
		}

		platform.playAnimation(targetFrame, true);
		lastPlatformFrameIndex = frameIndex;
	}
}
