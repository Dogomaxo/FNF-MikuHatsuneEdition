import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.util.ReflectUtil;

// Central router: toggles modules based on the current player's characterId.
class ModuleRouter extends Module {
  // ================= RULE MODEL (Scalable) =================
  // Each rule supports either "id" (single character) or "ids" (array of characters).
  // Example structure:
  //  {
  //     ids: ["miku","rin"],          // characterIds (or id: "miku")
  //     enable: ["Hatsune In-Game HUD"],
  //     disable: ["Some Other Module"]
  //  }
  // Stage / song filters removed for compatibility (hscript reflection shit issues). Re‑add later via safe API.
  var charRules = [
    // Enable the unified gameplay HUD for these characters.
  { ids: ["miku", "bf-hme", "rin", "len"], enable: ["Hatsune Display HUD"], disable: [] },
    // Keep the voltage panel scoped to the mod's own song set.
  {
    ids: ["miku", "bf-hme", "rin", "len"],
    songs: ["Satisfaction", "Far-away", "Far-away-Project-Diva-ver", "All-is-Music", "DIVA", "Decade", "Ai-kotoba-V", "Blue-Star", "Debug-Level", "Ray-livetune-Cover", "Romeo-and-Cinderella", "The-Disappearance-of-Hatsune Miku"],
    enable: ["Hatsune Voltage Panel"],
    disable: []
  }
  ];
  // ==========================================================

  // HUD modules that change icon flip and need restoration when leaving.
  var hudFlipModules = ["Hatsune Display HUD"]; // add more custom HUD modules here
  // Characters that use any hudFlipModules (auto-built from rules).
  var customHudChars = [];
  // Remaining frames to attempt passive flip restore after leaving a custom HUD character.
  var flipRestoreFrames:Int = 0;
  // Flag: we applied an immediate fix the frame the change happened.
  var immediateFlipApplied:Bool = false;
  // Whether the previous character used a custom HUD.
  var lastCharWasCustom:Bool = false;

  var lastCharId:String = null;
  var lastSongId:String = null;
  var lastStageId:String = null;
  var lastStateRef = null;

  // Cache of last enabled/disabled sets for differential activation.
  var lastEnabledModules = [];

  public function new() {
  super("ModuleRouter", 0); // high priority
    rebuildCustomHudChars();
  }

  function getPlayerCharacterId() {
    if (PlayState.instance == null) return null;
    if (PlayState.instance.currentStage != null) {
      var bf = PlayState.instance.currentStage.getBoyfriend();
      if (bf != null) return bf.characterId;
    }
    if (PlayState.instance.iconP1 != null) return PlayState.instance.iconP1.characterId;
    return null;
  }

  function getCurrentSongId() {
    if (PlayState.instance == null || PlayState.instance.currentSong == null) return null;
    return PlayState.instance.currentSong.id;
  }

  function getCurrentStageId() {
    if (PlayState.instance == null) return null;
    return PlayState.instance.currentStageId;
  }

  override function onStateChangeBegin(event) {
    super.onStateChangeBegin(event);
    deactivateTrackedModules();
    resetTrackingState();
  }

  override function onUpdate(e) {
  var charId = getPlayerCharacterId();
  var songId = getCurrentSongId();
  var stageId = getCurrentStageId();
  var stateRef = PlayState.instance;
  // Passive flip restore attempts (few frames) after leaving custom HUD.
    if (flipRestoreFrames > 0 && PlayState.instance != null && PlayState.instance.iconP1 != null) {
      var ic = PlayState.instance.iconP1;
  if (ic.flipX == false) ic.flipX = true; // force immediately
      flipRestoreFrames--;
      if (flipRestoreFrames <= 0) immediateFlipApplied = false; // reset
    }

    // Re-evaluate whenever the gameplay identity changes, not only the character.
    var dirty = (charId != lastCharId) || (songId != lastSongId) || (stageId != lastStageId) || (stateRef != lastStateRef);
    if (!dirty) return; // nothing to do

    // Transition customHUD -> non-custom: schedule restoration.
    var newIsCustom = isCustomHudChar(charId);
    if (lastCharId != null && lastCharWasCustom && !newIsCustom) {
      // Immediate attempt: if icon exists, fix now to avoid flicker.
      if (PlayState.instance != null && PlayState.instance.iconP1 != null) {
        var icNow = PlayState.instance.iconP1;
        if (icNow.flipX == false) {
          icNow.flipX = true;
          immediateFlipApplied = true;
        }
      }
      // Short window in case icon is rebuilt a few frames later.
      flipRestoreFrames = 5; // ~0.08s
    }

    // If the new state isn't ready yet, disable everything until the new gameplay identity exists.
    var targetEnable = [];
    var targetDisable = [];
    if (charId != null) {
  for (r in charRules) if (ruleMatches(r, charId)) {
        if (r.enable != null) for (m in r.enable) if (!targetEnable.contains(m)) targetEnable.push(m);
        if (r.disable != null) for (m2 in r.disable) if (!targetDisable.contains(m2)) targetDisable.push(m2);
      }
    }

  // Differential activation: touch only what changed.
    for (mPrev in lastEnabledModules) {
      var stillEnabled = targetEnable.contains(mPrev);
      if (!stillEnabled || targetDisable.contains(mPrev)) {
        deactivateManagedModule(mPrev);
      }
    }
  // Activate new ones
    for (mNow in targetEnable) {
      if (!lastEnabledModules.contains(mNow)) {
        var ma = ModuleHandler.getModule(mNow);
        if (ma != null && !ma.active) ma.active = true;
      }
    }
  // Ensure explicit disables
    for (mDis in targetDisable) {
      deactivateManagedModule(mDis);
    }

    lastEnabledModules = targetEnable;

    lastCharId = charId;
    lastSongId = songId;
    lastStageId = stageId;
    lastStateRef = stateRef;
    lastCharWasCustom = newIsCustom;
  }

  function isCustomHudChar(id:String):Bool {
    if (id == null) return false;
    for (c in customHudChars) if (c == id) return true;
    return false;
  }

  // Rebuild list of characters that use a HUD requiring flip restoration.
  function rebuildCustomHudChars() {
    customHudChars = [];
    for (r in charRules) {
      var affectsFlip = false;
      if (r.enable != null) for (m in r.enable) if (!affectsFlip && hudFlipModules.contains(m)) affectsFlip = true;
      if (!affectsFlip) continue;
      if (r.id != null) {
        if (!customHudChars.contains(r.id)) customHudChars.push(r.id);
      } else if (r.ids != null) {
        for (cid in r.ids) if (!customHudChars.contains(cid)) customHudChars.push(cid);
      }
    }
  }

  function ruleMatches(r, charId:String):Bool {
    if (r == null) return false;
    // Character dimension
    var charOk = true;
    if (r.id != null || r.ids != null) {
      charOk = false;
      if (r.id != null && r.id == charId) charOk = true;
      else if (r.ids != null) for (c in r.ids) if (c == charId) { charOk = true; break; }
    }
    if (!charOk) return false;

    var songOk = true;
    if (r.song != null || r.songs != null) {
      songOk = false;
      var songId = getCurrentSongId();
      if (songId != null) {
        if (r.song != null && r.song == songId) songOk = true;
        else if (r.songs != null) for (sid in r.songs) if (sid == songId) { songOk = true; break; }
      }
    }
    if (!songOk) return false;

    return true;
  }

  // ===== Simple public API to add/clear rules dynamically =====
  public function addRule(r) {
    if (r == null) return;
    charRules.push(r);
    rebuildCustomHudChars();
  }

  public function clearRules() {
    charRules = [];
    rebuildCustomHudChars();
  }

  function deactivateTrackedModules() {
    for (moduleId in lastEnabledModules) {
      deactivateManagedModule(moduleId);
    }
    lastEnabledModules = [];
  }

  function resetTrackingState() {
    lastCharId = null;
    lastSongId = null;
    lastStageId = null;
    lastStateRef = null;
    lastCharWasCustom = false;
    flipRestoreFrames = 0;
    immediateFlipApplied = false;
  }

  function deactivateManagedModule(moduleId:String) {
    var module = ModuleHandler.getModule(moduleId);
    if (module == null || !module.active) return;
    if (ReflectUtil.hasField(module, "restoreDisplayState")) {
      var restoreFn = ReflectUtil.getField(module, "restoreDisplayState");
      if (restoreFn != null) restoreFn();
    }
    module.active = false;
  }
}


