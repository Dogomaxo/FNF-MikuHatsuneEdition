//changes freeplayRandom default theme with another theme for Miku

import funkin.modding.module.Module;
import funkin.util.ReflectUtil;
import funkin.audio.FunkinSound;
import funkin.Paths;
import flixel.util.FlxTimer;
import flixel.FlxG;

class MikuFreeplayRandomBGM extends Module
{
    var playedRandomPreview:Bool = false;
    var pendingStart:Bool = false;

    // Cached constants to avoid rebuilding strings each frame
    var MUSIC_KEY:String = 'freeplayRandom-vocaloid';
    var MUSIC_LABEL:String = null;
    var FREEPLAY_CLASSNAME:String = 'funkin.ui.freeplay.FreeplayState';
    var DEBUG:Bool = false;

    public function new()
    {
        // Use a unique identifier to avoid clashes with other mods
        super('HatsuneFreeplayRandomBGM');
        // Paths.music("key/key") -> final resolved label used by the engine
        MUSIC_LABEL = Paths.music(MUSIC_KEY + '/' + MUSIC_KEY);
    }

    override function onStateChangeEnd(event)
    {
        super.onStateChangeEnd(event);
        playedRandomPreview = false;
        pendingStart = false;
    }

    override function onSubStateCloseEnd(event)
    {
        super.onSubStateCloseEnd(event);
        playedRandomPreview = false;
        pendingStart = false;
    }

    override function onUpdate(event:UpdateScriptEvent)
    {
        super.onUpdate(event);

        // Only act inside FreeplayState substate.
        if (ReflectUtil.getClassNameOf(FlxG.state.subState) == FREEPLAY_CLASSNAME)
        {
            var fp = FlxG.state.subState; // FreeplayState instance

            // Only for Miku's Freeplay and when hovering the Random capsule (index 0)
            if (fp.currentCharacterId == 'miku')
            {
                // Wait until the DJ intro has finished and Freeplay is interactable
                if (fp.controls.active && fp.curSelected == 0)
                {
                    // If custom preview is not already playing, start it.
                    var isCustomPlaying = false;
                    if (FlxG.sound.music != null)
                    {
                        var currentLabel = ReflectUtil.getField(FlxG.sound.music, '_label');
                        isCustomPlaying = (currentLabel == MUSIC_LABEL);
                    }

                    if (!isCustomPlaying && !pendingStart)
                    {
                        new FlxTimer().start(0.05, _ -> {
                            var started = FunkinSound.playMusic(MUSIC_KEY, {
                                startingVolume: 0.0,
                                overrideExisting: true,
                                restartTrack: false,
                                mapTimeChanges: false,
                                loop: true,
                                onLoad: function() {
                                    if (FlxG.sound.music != null) {
                                        FlxG.sound.music.fadeIn(1.5, 0, 0.6);
                                    }
                                }
                            });
                            if (DEBUG) trace('[MikuFreeplayRandomBGM] playMusic returned: ' + started);
                        });

                        // Verify shortly after in case the engine overrides right after our call.
                        new FlxTimer().start(0.2, _2 -> {
                            var stillCustom = false;
                            if (FlxG.sound.music != null)
                            {
                                var curLabel = ReflectUtil.getField(FlxG.sound.music, '_label');
                                stillCustom = (curLabel == MUSIC_LABEL);
                            }
                            if (!stillCustom && fp.controls.active && fp.curSelected == 0)
                            {
                                FunkinSound.playMusic(MUSIC_KEY, {
                                    startingVolume: 0.0,
                                    overrideExisting: true,
                                    restartTrack: false,
                                    mapTimeChanges: false,
                                    loop: true,
                                    onLoad: function() {
                                        if (FlxG.sound.music != null) {
                                            FlxG.sound.music.fadeIn(1.5, 0, 0.6);
                                        }
                                    }
                                });
                            }
                            pendingStart = false;
                        });
                        pendingStart = true;
                        playedRandomPreview = true;
                    }
                    else if (isCustomPlaying)
                    {
                        playedRandomPreview = true;
                        pendingStart = false;
                    }
                }
                else
                {
                    // Left Random capsule; allow replay next time
                    playedRandomPreview = false;
                    pendingStart = false;
                }
            }
            else
            {
                playedRandomPreview = false;
            }
        }
        else
        {
            playedRandomPreview = false;
        }
    }
}
